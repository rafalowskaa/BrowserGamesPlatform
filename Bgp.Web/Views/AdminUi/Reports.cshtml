@model IEnumerable<Bgp.Domain.Entities.Report>
@{
    ViewData["Title"] = L["Admin_Reports_Title"].Value;
}
<h2>@L["Admin_Reports_Heading"].Value</h2>
<table class="panel">
    <thead>
        <tr>
            <th>@L["Admin_Reports_Date"].Value</th>
            <th>@L["Admin_Reports_Reporter"].Value</th>
            <th>@L["Admin_Reports_Target"].Value</th>
            <th>@L["Admin_Reports_Category"].Value</th>
            <th>@L["Admin_Reports_Description"].Value</th>
            <th>@L["Admin_Reports_Status"].Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.CreatedAtUtc.ToLocalTime()</td>
                <td>@r.ReporterUserId</td>
                <td>@r.TargetUserId</td>
                <td>@r.Category</td>
                <td>@r.Description</td>
                <td>@r.Status</td>
            </tr>
        }
    </tbody>
</table>
