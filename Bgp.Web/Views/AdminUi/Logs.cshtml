﻿﻿@using System.Globalization
@using System.Linq
@using Bgp.Domain.Enums
@model Bgp.Web.Models.AdminLogsViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Admin_Logs_Title"].Value;
    var types = Enum.GetValues<ActivityLogType>()
        .Where(type => type != ActivityLogType.ExperienceGained);
    string FormatType(ActivityLogType type) => L[$"Admin_Logs_Type_{type}"].Value;
    var dateFromValue = Model.DateFrom?.ToString("yyyy-MM-dd");
    var dateToValue = Model.DateTo?.ToString("yyyy-MM-dd");
    var polishCulture = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");
    var activity = Model.ActivityOverview;
    var activityDays = activity.Last7Days.ToList();
    var maxLogins = Math.Max(1, activityDays.Any() ? activityDays.Max(point => point.Logins) : 1);
    var maxGames = Math.Max(1, activityDays.Any() ? activityDays.Max(point => point.GamesPlayed) : 1);
    var maxComments = Math.Max(1, activityDays.Any() ? activityDays.Max(point => point.Comments) : 1);
    var maxRatings = Math.Max(1, activityDays.Any() ? activityDays.Max(point => point.Ratings) : 1);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
       || Model.Type.HasValue
       || !string.IsNullOrWhiteSpace(Model.Game)
       || Model.DateFrom.HasValue
       || Model.DateTo.HasValue;
}
<section class="admin-section">
    <nav class="admin-nav">
        <a class="admin-nav__item" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item" asp-action="Content">@L["Admin_Nav_Content"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
        <a class="admin-nav__item active" asp-action="Logs">@L["Admin_Nav_Logs"].Value</a>
    </nav>

    <section class="admin-reports">
        <header class="admin-reports__header">
            <div>
                <h1>@L["Admin_Logs_Title"].Value</h1>
                <p class="admin-reports__subtitle">@L["Admin_Logs_Subtitle"].Value</p>
                <p class="admin-reports__count">
                    @string.Format(hasFilters ? L["Admin_Logs_Count_Filtered"].Value : L["Admin_Logs_Count_Total"].Value, Model.Total)
                </p>
            </div>
        </header>

        @if (TempData["AdminLogsSuccess"] is string successKey)
        {
            <div class="alert success">@L[successKey].Value</div>
        }

        <section class="admin-activity">
            <header class="admin-activity__header">
                <div>
                    <h2>@L["Admin_Logs_Stats_Title"].Value</h2>
                    <p>@L["Admin_Logs_Stats_Subtitle"].Value</p>
                </div>
            </header>
            <div class="admin-activity__grid">
                <article class="admin-activity__card">
                    <h3>@L["Admin_Logs_Stats_Logins"].Value</h3>
                    <div class="admin-activity__totals">
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Today"].Value</span>
                            <strong>@activity.Logins.Today</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Week"].Value</span>
                            <strong>@activity.Logins.Last7Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Month"].Value</span>
                            <strong>@activity.Logins.Last30Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Year"].Value</span>
                            <strong>@activity.Logins.Last365Days</strong>
                        </div>
                    </div>
                </article>
                <article class="admin-activity__card">
                    <h3>@L["Admin_Logs_Stats_GamesPlayed"].Value</h3>
                    <div class="admin-activity__totals">
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Today"].Value</span>
                            <strong>@activity.GamesPlayed.Today</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Week"].Value</span>
                            <strong>@activity.GamesPlayed.Last7Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Month"].Value</span>
                            <strong>@activity.GamesPlayed.Last30Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Year"].Value</span>
                            <strong>@activity.GamesPlayed.Last365Days</strong>
                        </div>
                    </div>
                </article>
                <article class="admin-activity__card">
                    <h3>@L["Admin_Logs_Stats_Comments"].Value</h3>
                    <div class="admin-activity__totals">
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Today"].Value</span>
                            <strong>@activity.Comments.Today</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Week"].Value</span>
                            <strong>@activity.Comments.Last7Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Month"].Value</span>
                            <strong>@activity.Comments.Last30Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Year"].Value</span>
                            <strong>@activity.Comments.Last365Days</strong>
                        </div>
                    </div>
                </article>
                <article class="admin-activity__card">
                    <h3>@L["Admin_Logs_Stats_Ratings"].Value</h3>
                    <div class="admin-activity__totals">
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Today"].Value</span>
                            <strong>@activity.Ratings.Today</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Week"].Value</span>
                            <strong>@activity.Ratings.Last7Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Month"].Value</span>
                            <strong>@activity.Ratings.Last30Days</strong>
                        </div>
                        <div>
                            <span>@L["Admin_Logs_Stats_Period_Year"].Value</span>
                            <strong>@activity.Ratings.Last365Days</strong>
                        </div>
                    </div>
                </article>
            </div>
            <div class="admin-activity__trend">
                <header>
                    <h3>@L["Admin_Logs_Stats_Trend_Title"].Value</h3>
                    <p>@L["Admin_Logs_Stats_Trend_Subtitle"].Value</p>
                </header>
                <div class="admin-activity__trend-grid" role="list">
                    @foreach (var point in activityDays)
                    {
                        var loginShare = point.Logins * 100d / maxLogins;
                        var gamesShare = point.GamesPlayed * 100d / maxGames;
                        var commentsShare = point.Comments * 100d / maxComments;
                        var ratingsShare = point.Ratings * 100d / maxRatings;
                        <div class="admin-activity__trend-row" role="listitem">
                            <span class="admin-activity__trend-date">@point.Date.ToString("ddd dd.MM", polishCulture)</span>
                            <div class="admin-activity__trend-metric" data-tone="logins">
                                <span class="admin-activity__trend-bar" style="--value:@loginShare.ToString("F1", CultureInfo.InvariantCulture);"></span>
                                <strong>@point.Logins</strong>
                            </div>
                            <div class="admin-activity__trend-metric" data-tone="games">
                                <span class="admin-activity__trend-bar" style="--value:@gamesShare.ToString("F1", CultureInfo.InvariantCulture);"></span>
                                <strong>@point.GamesPlayed</strong>
                            </div>
                            <div class="admin-activity__trend-metric" data-tone="comments">
                                <span class="admin-activity__trend-bar" style="--value:@commentsShare.ToString("F1", CultureInfo.InvariantCulture);"></span>
                                <strong>@point.Comments</strong>
                            </div>
                            <div class="admin-activity__trend-metric" data-tone="ratings">
                                <span class="admin-activity__trend-bar" style="--value:@ratingsShare.ToString("F1", CultureInfo.InvariantCulture);"></span>
                                <strong>@point.Ratings</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <form method="get" class="admin-reports__filters">
            <label class="filter-item">
                <span>@L["Admin_Logs_Filter_SearchLabel"].Value</span>
                <input type="search" name="search" value="@Model.Search" placeholder="@L["Admin_Logs_Filter_SearchPlaceholder"].Value" />
            </label>
            <label class="filter-item">
                <span>@L["Admin_Logs_Filter_TypeLabel"].Value</span>
                <select name="type">
                    <option value="">@L["Admin_Logs_Filter_Type_All"].Value</option>
                    @foreach (var t in types)
                    {
                        var selectedValue = Model.Type == t ? "selected" : null;
                        <option value="@((int)t)" selected="@selectedValue">@FormatType(t)</option>
                    }
                </select>
            </label>
            <label class="filter-item">
                <span>@L["Admin_Logs_Filter_GameLabel"].Value</span>
                <input type="search" name="game" value="@Model.Game" placeholder="@L["Admin_Logs_Filter_GamePlaceholder"].Value" />
            </label>
            <label class="filter-item">
                <span>@L["Admin_Logs_Filter_DateFromLabel"].Value</span>
                <input type="date" name="dateFrom" value="@dateFromValue" />
            </label>
            <label class="filter-item">
                <span>@L["Admin_Logs_Filter_DateToLabel"].Value</span>
                <input type="date" name="dateTo" value="@dateToValue" />
            </label>
            <div class="filter-actions">
                <button type="submit" class="btn-primary btn-compact">@L["Admin_Logs_Filter_Submit"].Value</button>

                @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Type.HasValue || !string.IsNullOrWhiteSpace(Model.Game) || Model.DateFrom.HasValue || Model.DateTo.HasValue)
                {
                    <a class="btn-outline btn-compact" asp-action="Logs">@L["Admin_Logs_Filter_Reset"].Value</a>
                }
            </div>
        </form>

        <form asp-action="DeleteSelectedLogs" method="post" class="admin-reports__filters admin-reports__filters--actions" id="adminLogBulkDelete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="filter-actions">
                <label class="filter-item filter-item--inline">
                    <input type="checkbox" data-admin-logs-select-all />
                    <span>@L["Admin_Logs_SelectAll"].Value</span>
                </label>
                <button type="submit" class="btn-outline btn-compact text-danger" data-admin-logs-delete disabled>
                    @L["Admin_Logs_DeleteSelected"].Value
                </button>
            </div>
        </form>

        <div class="table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>
                            <span class="sr-only">@L["Admin_Logs_SelectAll"].Value</span>
                        </th>
                        <th>@L["Admin_Logs_Table_Date"].Value</th>
                        <th>@L["Admin_Logs_Table_Type"].Value</th>
                        <th>@L["Admin_Logs_Table_User"].Value</th>
                        <th>@L["Admin_Logs_Table_Target"].Value</th>
                        <th>@L["Admin_Logs_Table_Game"].Value</th>
                        <th>@L["Admin_Logs_Table_Description"].Value</th>
                        <th>@L["Admin_Logs_Table_Actions"].Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="ids"
                                           value="@log.Id"
                                           form="adminLogBulkDelete"
                                           data-admin-log-select
                                           aria-label="@L["Admin_Logs_Select"].Value" />
                                </td>
                                <td><span class="badge">@log.CreatedAtUtc.ToLocalTime().ToString("g", polishCulture)</span></td>
                                <td><span class="status status-open">@FormatType(log.Type)</span></td>
                                <td>
                                    <strong>@(log.ActorDisplayName ?? log.ActorUserId ?? "-")</strong>
                                    @if (!string.IsNullOrWhiteSpace(log.ActorUserId))
                                    {
                                        <div class="muted">@log.ActorUserId</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.TargetDisplayName) || !string.IsNullOrWhiteSpace(log.TargetUserId))
                                    {
                                        <strong>@(log.TargetDisplayName ?? log.TargetUserId)</strong>
                                        @if (!string.IsNullOrWhiteSpace(log.TargetUserId))
                                        {
                                            <div class="muted">@log.TargetUserId</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (log.GameSlug is not null)
                                    {
                                        <a asp-controller="Games" asp-action="Details" asp-route-slug="@log.GameSlug">
                                            @(log.GameTitle ?? log.GameSlug)
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(log.GameTitle) && log.GameTitle != log.GameSlug)
                                        {
                                            <div class="muted">@log.GameSlug</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(log.Message) ? "-" : log.Message)</div>
                                    @if (log.Rating.HasValue)
                                    {
                                        <div class="muted">@L["Admin_Logs_Rating_Label"].Value @log.Rating</div>
                                    }
                                </td>
                                <td>
                                    <form asp-action="DeleteLog" method="post" class="admin-table__actions">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@log.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn-link text-danger admin-log-action" onclick="return confirm('@L["Admin_Logs_Delete_Confirm"].Value');">
                                            @L["Admin_Logs_Delete"].Value
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="empty">@L["Admin_Logs_Empty"].Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bulkForm = document.getElementById('adminLogBulkDelete');
            if (!bulkForm) {
                return;
            }

            const selectAll = bulkForm.querySelector('[data-admin-logs-select-all]');
            const deleteButton = bulkForm.querySelector('[data-admin-logs-delete]');
            const checkboxes = Array.from(document.querySelectorAll('[data-admin-log-select]'));

            const updateBulkState = () => {
                const anyChecked = checkboxes.some(cb => cb.checked);
                if (deleteButton) {
                    deleteButton.disabled = !anyChecked;
                }
                if (selectAll) {
                    selectAll.checked = checkboxes.length > 0 && checkboxes.every(cb => cb.checked);
                }
            };

            if (selectAll) {
                selectAll.addEventListener('change', () => {
                    checkboxes.forEach(cb => {
                        cb.checked = selectAll.checked;
                    });
                    updateBulkState();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkState);
            });

            updateBulkState();
        });
    </script>
}