@using System.Linq
@using Bgp.Domain.Enums
@using Bgp.Web.Helpers
@model AdminGamesViewModel
@{
    ViewData["Title"] = L["Admin_Games_Title"].Value;
    var filterValue = Model.Filter?.ToString();
    var statuses = Enum.GetValues<GameApprovalStatus>();
    string FormatCategories(GameCategory categories)
    {
        if (categories == GameCategory.None)
        {
            return L["Admin_Games_Metadata_None"].Value;
        }

        var labels = GameMetadataOptions.CategoryDefinitions
            .Where(def => (categories & def.Category) != 0)
            .Select(def => L[def.ResourceKey].Value)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        return labels.Count == 0 ? L["Admin_Games_Metadata_None"].Value : string.Join(", ", labels);
    }

    string FormatModes(GameMode modes)
    {
        if (modes == GameMode.None)
        {
            return L["Admin_Games_Metadata_None"].Value;
        }

        var labels = GameMetadataOptions.ModeDefinitions
            .Where(def => (modes & def.Mode) != 0)
            .Select(def => L[def.ResourceKey].Value)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        return labels.Count == 0 ? L["Admin_Games_Metadata_None"].Value : string.Join(", ", labels);
    }
}

<section class="admin-section">
    <nav class="admin-nav">
        <a class="admin-nav__item" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item active" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
    </nav>

    <header class="admin-header">
        <div>
            <h1>@L["Admin_Games_Title"].Value</h1>
            <p>@L["Admin_Games_Subtitle"].Value</p>
        </div>
        <form method="get" class="admin-filter">
            <label>
                <span>@L["Admin_Games_Filter_Label"].Value</span>
                <select name="status">
                    <option value="">@L["Admin_Games_Filter_All"].Value</option>
                    @foreach (var status in statuses)
                    {
                        var selected = filterValue == status.ToString() ? "selected" : null;
                        <option value="@status" selected="@selected">@L[$"Dashboard_Games_Status_{status}"].Value</option>
                    }
                </select>
            </label>
            <button class="btn-primary btn-compact" type="submit">@L["Admin_Games_Filter_Apply"].Value</button>
        </form>
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessKey))
    {
        <div class="alert success">@L[Model.SuccessKey].Value</div>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorKey))
    {
        <div class="alert error">@L[Model.ErrorKey].Value</div>
    }

    <div class="table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Dashboard_Games_Title"].Value</th>
                    <th>@L["Admin_Games_Table_Owner"].Value</th>
                    <th>@L["Dashboard_Games_Submitted"].Value</th>
                    <th>@L["Dashboard_Games_Status"].Value</th>
                    <th>@L["Admin_Games_Table_Actions"].Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Games.Any())
                {
                    foreach (var game in Model.Games)
                    {
                        <tr>
                            <td>
                                <strong>@game.Title</strong>
                                <div class="game-meta">@game.Slug</div>
                                <div class="game-meta">@L["Admin_Games_Metadata_Current"].Value: @FormatCategories(game.Categories)</div>
                                <div class="game-meta">@L["Admin_Games_Metadata_ProposedCategories_Label"].Value: @FormatCategories(game.ProposedCategories)</div>
                                <div class="game-meta">@L["Admin_Games_Metadata_Modes_Current"].Value: @FormatModes(game.Modes)</div>
                                <div class="game-meta">@L["Admin_Games_Metadata_Modes_Proposed"].Value: @FormatModes(game.ProposedModes)</div>
                                @if (!string.IsNullOrWhiteSpace(game.ModerationNotes))
                                {
                                    <div class="game-note">@game.ModerationNotes</div>
                                }
                            </td>
                            <td>@game.Owner</td>
                            <td>@game.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td><span class="status-pill @($"status-{game.Status.ToString().ToLowerInvariant()}")">@L[$"Dashboard_Games_Status_{game.Status}"].Value</span></td>
                            <td>
                                <div class="admin-actions vertical">
                                    <a class="btn-secondary btn-small" asp-action="PlayGame" asp-route-id="@game.Id" target="_blank">@L["Admin_Games_Test"].Value</a>
                                    <details class="admin-metadata">
                                        <summary>@L["Admin_Games_Metadata_Edit"].Value</summary>
                                        <form asp-action="UpdateGameMetadata" method="post" class="admin-metadata-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@game.Id" />
                                            <label>
                                                <span>@L["Admin_Games_Metadata_Title"].Value</span>
                                                <input type="text" name="Title" value="@game.Title" maxlength="120" required />
                                            </label>
                                            <label>
                                                <span>@L["Admin_Games_Metadata_Slug"].Value</span>
                                                <input type="text" name="Slug" value="@game.Slug" maxlength="140" required />
                                            </label>
                                            <label>
                                                <span>@L["Admin_Games_Metadata_Author"].Value</span>
                                                <input type="text" value="@game.Owner" readonly />
                                            </label>
                                            <label>
                                                <span>@L["Admin_Games_Metadata_Description"].Value</span>
                                                <textarea name="Description" maxlength="2000">@game.Description</textarea>
                                            </label>
                                            <label>
                                                <span>@L["Admin_Games_Metadata_Cover"].Value</span>
                                                <input type="text" name="CoverImagePath" value="@game.CoverImagePath" maxlength="256" />
                                            </label>
                                            <fieldset>
                                                <legend>@L["Admin_Games_Metadata_Categories"].Value</legend>
                                                <select name="Categories" multiple size="@(Math.Min(GameMetadataOptions.CategoryDefinitions.Count, 8))">
                                                    @foreach (var option in GameMetadataOptions.CategoryDefinitions)
                                                    {
                                                        var isSelected = (game.Categories & option.Category) != 0;
                                                        var label = L[option.ResourceKey].Value;
                                                        if ((game.ProposedCategories & option.Category) != 0 && !isSelected)
                                                        {
                                                            label = $"{label} ({L["Admin_Games_Metadata_Proposed"].Value})";
                                                        }
                                                        <option value="@((int)option.Category)" @(isSelected ? "selected" : null)>@label</option>
                                                    }
                                                </select>
                                            </fieldset>
                                            <fieldset>
                                                <legend>@L["Admin_Games_Metadata_Modes"].Value</legend>
                                                <select name="Modes" multiple size="@(Math.Min(GameMetadataOptions.ModeDefinitions.Count, 6))">
                                                    @foreach (var option in GameMetadataOptions.ModeDefinitions)
                                                    {
                                                        var isSelected = (game.Modes & option.Mode) != 0;
                                                        var label = L[option.ResourceKey].Value;
                                                        if ((game.ProposedModes & option.Mode) != 0 && !isSelected)
                                                        {
                                                            label = $"{label} ({L["Admin_Games_Metadata_Proposed"].Value})";
                                                        }
                                                        <option value="@((int)option.Mode)" @(isSelected ? "selected" : null)>@label</option>
                                                    }
                                                </select>
                                            </fieldset>
                                            <div class="metadata-tags">
                                                <strong>@L["Admin_Games_Metadata_Tags"].Value</strong>
                                                @if (game.Tags.Any())
                                                {
                                                    <div class="tag-list">
                                                        @foreach (var tag in game.Tags)
                                                        {
                                                            var isChecked = tag.IsApproved;
                                                            <label class="option-chip">
                                                                <input type="checkbox" name="ApprovedTags" value="@tag.Id" @(isChecked ? "checked" : null) />
                                                                <span>@tag.Value</span>
                                                                @if (tag.IsPending)
                                                                {
                                                                    <span class="badge info">@L["Admin_Games_Metadata_TagPending"].Value</span>
                                                                }
                                                            </label>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="muted">@L["Admin_Games_Metadata_NoTags"].Value</p>
                                                }
                                            </div>
                                            <button class="btn-primary btn-small" type="submit">@L["Admin_Games_Metadata_Save"].Value</button>
                                        </form>
                                    </details>
                                    @if (game.Status != GameApprovalStatus.Approved)
                                    {
                                        <form asp-action="ApproveGame" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@game.Id" />
                                            <button class="btn-primary btn-small" type="submit">@L["Admin_Games_Approve"].Value</button>
                                        </form>
                                    }
                                    @if (game.Status != GameApprovalStatus.Rejected)
                                    {
                                        <details>
                                            <summary>@L["Admin_Games_Reject"].Value</summary>
                                            <form asp-action="RejectGame" method="post" class="admin-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@game.Id" />
                                                <textarea name="Notes" maxlength="500" placeholder="@L["Admin_Games_Reject_Notes"].Value"></textarea>
                                                <button class="btn-danger btn-small" type="submit">@L["Admin_Games_Reject_Submit"].Value</button>
                                            </form>
                                        </details>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty">@L["Admin_Games_Empty"].Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>