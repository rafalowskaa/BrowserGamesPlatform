@using System.Text.Json
@using System.Text.Json.Serialization
@using Bgp.Domain.Constants
@using Bgp.Domain.Enums
@using Bgp.Web.Helpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model AdminGamesViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Admin_Games_Title"].Value;
    var statuses = Enum.GetValues<GameApprovalStatus>();
    
    static List<int> ExtractCategoryValues(GameCategory categories)
    {
        var values = new List<int>();
        foreach (var option in GameMetadataOptions.CategoryDefinitions)
        {
            if ((categories & option.Category) != 0)
            {
                values.Add((int)option.Category);
            }
        }

        return values;
    }

    string FormatStatus(GameApprovalStatus status) => L[$"Dashboard_Games_Status_{status}"].Value;

    
    string FormatDate(DateTime date) => date.ToLocalTime().ToString("g");

    string? BuildRejectionTooltip(GameApprovalStatus status, DateTime? rejectedAtUtc)
    {
        var deadline = GetRejectionDeadline(status, rejectedAtUtc);
        if (deadline is null)
        {
            return null;
        }

        var daysRemaining = Math.Max(0, (int)Math.Ceiling((deadline.Value - DateTime.UtcNow).TotalDays));
        return string.Format(L["Games_Rejected_RemovalCountdown"].Value, daysRemaining);
    }

    DateTime? GetRejectionDeadline(GameApprovalStatus status, DateTime? rejectedAtUtc)
    {
        if (status != GameApprovalStatus.Rejected || rejectedAtUtc is null)
        {
            return null;
        }

        return rejectedAtUtc.Value.Add(GameModerationSettings.RejectedRetentionPeriod);
    }

    var serializerOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    serializerOptions.Converters.Add(new JsonStringEnumConverter());

    var gamesData = Model.Games.Select(game => new
    {
        id = game.Id,
        title = game.Title,
        slug = game.Slug,
        owner = game.Owner,
        createdAtUtc = game.CreatedAtUtc,
        rejectedAtUtc = game.RejectedAtUtc,
        status = game.Status,
        moderationNotes = game.ModerationNotes,
        proposedCategories = ExtractCategoryValues(game.ProposedCategories),
        categories = ExtractCategoryValues(game.Categories),
        description = game.Description,
        rules = game.Rules,
        coverImagePath = game.CoverImagePath,
        tags = game.Tags.Select(t => new { t.Id, t.Value, t.IsApproved, t.IsPending }).ToList()
    }).ToList();

    var categoryOptions = GameMetadataOptions.CategoryDefinitions
        .Select(def => new { value = (int)def.Category, label = L[def.ResourceKey].Value })
        .OrderBy(def => def.label, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    var statusLabels = statuses
        .ToDictionary(status => status.ToString(), status => L[$"Dashboard_Games_Status_{status}"].Value);
    
    var rejectionTemplate = L["Games_Rejected_RemovalCountdown"].Value;

    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var antiForgeryFieldName = antiforgeryTokens.FormFieldName;
    var antiForgeryToken = antiforgeryTokens.RequestToken;

    var successMessage = !string.IsNullOrEmpty(Model.SuccessKey) ? L[Model.SuccessKey].Value : string.Empty;
    var errorMessage = !string.IsNullOrEmpty(Model.ErrorKey) ? L[Model.ErrorKey].Value : string.Empty;
}

<section class="admin-section admin-games">
    <nav class="admin-nav">
        <a class="admin-nav__item" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item active" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item" asp-action="Content">@L["Admin_Nav_Content"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
        <a class="admin-nav__item" asp-action="Logs">@L["Admin_Nav_Logs"].Value</a>
        <a class="admin-nav__item" asp-action="Statistics">@L["Admin_Nav_Stats"].Value</a>
    </nav>

    <header class="admin-header">
        <div>
            <h1>@L["Admin_Games_Title"].Value</h1>
            <p>@L["Admin_Games_Subtitle"].Value</p>
        </div>
        <div class="admin-header__actions">
            <div class="admin-tabs" role="tablist" aria-label="@L["Admin_Games_Filter_Label"].Value">
                <a class="admin-tab@(Model.Filter is null ? " active" : string.Empty)" role="tab" aria-selected="@(Model.Filter is null ? "true" : "false")" asp-action="Games">@L["Admin_Games_Filter_All"].Value</a>
                @foreach (var status in statuses)
                {
                    var isActive = Model.Filter == status;
                    <a class="admin-tab@(isActive ? " active" : string.Empty)" role="tab" aria-selected="@(isActive ? "true" : "false")" asp-action="Games" asp-route-status="@status">@FormatStatus(status)</a>
                }
            </div>
        </div>
    </header>

    <div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="true"></div>

    <div id="admin-games-app"
         data-games='@Html.Raw(JsonSerializer.Serialize(gamesData, serializerOptions))'
         data-category-options='@Html.Raw(JsonSerializer.Serialize(categoryOptions, serializerOptions))'
         data-status-labels='@Html.Raw(JsonSerializer.Serialize(statusLabels, serializerOptions))'
         data-rejection-template="@rejectionTemplate"
         data-rejection-retention-days="@GameModerationSettings.RejectedRetentionPeriod.TotalDays"
         data-success-message="@successMessage"
         data-error-message="@errorMessage"
         data-anti-forgery-field="@antiForgeryFieldName"
         data-anti-forgery-token="@antiForgeryToken"
         data-saved-label="@L["Admin_Games_State_Saved"].Value"
         data-saving-label="@L["Admin_Games_State_Saving"].Value"
         data-unsaved-label="@L["Admin_Games_State_Unsaved"].Value"
         data-preview-label="@L["Admin_Games_Preview"].Value"
         data-reject-label="@L["Admin_Games_Reject"].Value"
         data-approve-label="@L["Admin_Games_Approve"].Value"
         data-edit-label="@L["Admin_Games_Metadata_Edit"].Value"
         data-test-label="@L["Admin_Games_Test"].Value"
         data-new-label="@L["Admin_Games_Label_New"].Value"
         data-rejected-label="@L["Admin_Games_Label_Rejected"].Value"
         data-added-label="@L["Admin_Games_Label_Added"].Value"
         data-removed-label="@L["Admin_Games_Label_Removed"].Value"
         data-remove-label="@L["Admin_Games_Metadata_Remove"].Value"
         data-accept-label="@L["Admin_Games_Metadata_Accept"].Value"
         data-restore-label="@L["Admin_Games_Metadata_Restore"].Value"
         data-bulk-approve-success="@L["Admin_Games_Bulk_Approve_Success"].Value"
         data-bulk-reject-success="@L["Admin_Games_Bulk_Reject_Success"].Value"
         data-preview-slug-template="@L["Admin_Games_Preview_Slug"].Value"
         data-preview-owner-template="@L["Admin_Games_Preview_Owner"].Value"
         data-preview-description-empty="@L["Admin_Games_Preview_NoDescription"].Value"
         data-preview-rules-empty="@L["Admin_Games_Preview_NoRules"].Value"
         data-tags-empty="@L["Admin_Games_Tags_Empty"].Value"
         data-save-success="@L["Admin_Games_Save_Success"].Value"
         data-save-error="@L["Admin_Games_Save_Error"].Value"
         data-moderation-approve-success="@L["Admin_Games_Moderation_Approve_Success"].Value"
         data-moderation-reject-success="@L["Admin_Games_Moderation_Reject_Success"].Value"
         data-moderation-error="@L["Admin_Games_Moderation_Error"].Value"
         data-empty-label="@L["Admin_Games_Empty"].Value">
        <div class="admin-games__bulkbar" data-bulk-bar>
            <label class="admin-checkbox">
                <input type="checkbox" data-select-all aria-label="@L["Admin_Games_Bulk_SelectAll"].Value" />
                <span></span>
            </label>
            <div class="bulk-actions" aria-live="polite">
                <span data-bulk-count>0</span> @L["Admin_Games_Bulk_Selected"].Value
                <button type="button" class="btn-outline btn-compact" data-bulk-approve disabled>@L["Admin_Games_Approve"].Value</button>
                <button type="button" class="btn-outline btn-compact" data-bulk-reject disabled>@L["Admin_Games_Reject"].Value</button>
                <button type="button" class="btn-outline btn-compact" data-bulk-edit disabled>@L["Admin_Games_Metadata_Edit"].Value</button>
            </div>
        </div>

        <div class="admin-games__list" role="grid" aria-describedby="admin-games-caption">
            <div class="admin-games__list-header" role="row">
                <span class="cell cell--checkbox" role="columnheader">&nbsp;</span>
                <span class="cell cell--title" role="columnheader">@L["Dashboard_Games_Title"].Value</span>
                <span class="cell cell--owner" role="columnheader">@L["Admin_Games_Table_Owner"].Value</span>
                <span class="cell cell--submitted" role="columnheader">@L["Dashboard_Games_Submitted"].Value</span>
                <span class="cell cell--status" role="columnheader">@L["Dashboard_Games_Status"].Value</span>
                <span class="cell cell--actions" role="columnheader">@L["Admin_Games_Table_Actions"].Value</span>
            </div>

    <div class="sr-only" id="admin-games-caption">@L["Admin_Games_Grid_Caption"].Value</div>

            @if (Model.Games.Any())
            {
                foreach (var game in Model.Games)
                {
                    var rejectionDeadline = GetRejectionDeadline(game.Status, game.RejectedAtUtc);
                    var rejectionTooltip = BuildRejectionTooltip(game.Status, game.RejectedAtUtc);
                    var rejectionDeadlineValue = rejectionDeadline?.ToString("O");
                    <div class="admin-games__row" role="row" data-game-row data-game-id="@game.Id" tabindex="0">
                        <div class="cell cell--checkbox" role="gridcell">
                            <label class="admin-checkbox">
                                <input type="checkbox" value="@game.Id" data-row-checkbox aria-label="@string.Format(L["Admin_Games_Grid_SelectGame"].Value, game.Title)" />
                                <span></span>
                            </label>
                        </div>
                        <div class="cell cell--title" role="gridcell">
                            <div class="game-title">@game.Title</div>
                            <div class="game-meta">@game.Slug</div>
                            <div class="game-meta">@FormatStatus(game.Status)</div>
                        </div>
                        <div class="cell cell--owner" role="gridcell">@game.Owner</div>
                        <div class="cell cell--submitted" role="gridcell">@FormatDate(game.CreatedAtUtc)</div>
                        <div class="cell cell--status" role="gridcell">
                             <span class="status-pill @($"status-{game.Status.ToString().ToLowerInvariant()}")"
                                  data-rejection-template="@rejectionTemplate"
                                  data-rejection-deadline="@rejectionDeadlineValue"
                                  title="@(rejectionTooltip ?? string.Empty)">@FormatStatus(game.Status)</span>
                        </div>
                        
                        <div class="cell cell--actions" role="gridcell">
                            <a class="btn-outline btn-compact" asp-action="PlayGame" asp-route-id="@game.Id" target="_blank" data-test-button data-shortcut="T">@L["Admin_Games_Test"].Value</a>
                            <button type="button" class="btn-outline btn-compact" data-approve-button>@L["Admin_Games_Approve"].Value</button>
                            <button type="button" class="btn-primary btn-compact" data-edit-button>@L["Admin_Games_Metadata_Edit"].Value</button>
                             @if (game.Status == GameApprovalStatus.Rejected)
                            {
                                <form asp-action="RemoveGame" method="post" class="inline-form" onsubmit="return confirm('@L["Admin_Games_Remove_Confirm"].Value');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@game.Id" />
                                    <button type="submit" class="btn-danger btn-compact">@L["Admin_Games_Remove"].Value</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="DeleteGame" method="post" class="inline-form" onsubmit="return confirm('@L["Admin_Games_Delete_Confirm"].Value');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@game.Id" />
                                    <button type="submit" class="btn-danger btn-compact">@L["Admin_Games_Delete"].Value</button>
                                </form>
                            }
                        </div>
                    </div>
                   
                    }
            }
            else
            {
            <div class="admin-games__empty" role="row">
                    <div class="cell cell--empty" role="gridcell">@L["Admin_Games_Empty"].Value</div>
                </div>
            }
        </div>

        <aside class="admin-games__drawer" data-drawer aria-hidden="true">
            <div class="drawer__overlay" data-drawer-close></div>
            <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
                <div class="drawer__header">
                    <h2 id="drawer-title">@L["Admin_Games_Metadata_Edit"].Value</h2>
                    <div class="drawer__header-actions">
                        <button type="button" class="btn-link" data-drawer-close>@L["Common_Close"].Value</button>
                    </div>
                </div>

                <div class="drawer__body">
                    <section class="drawer-preview" data-drawer-preview hidden>
                        <div class="preview-summary">
                            <div class="preview-cover" data-preview-cover></div>
                            <div class="preview-details">
                                <h3 data-preview-title></h3>
                                <p class="preview-meta" data-preview-slug></p>
                                <p class="preview-meta" data-preview-owner></p>
                                <p class="preview-meta" data-preview-status></p>
                                <div class="preview-tags" data-preview-tags></div>
                                <p class="preview-description" data-preview-description></p>
                                <p class="preview-description"><strong>@L["Admin_Games_Metadata_Rules"].Value:</strong> <span data-preview-rules></span></p>
                            </div>
                        </div>
                        <div class="preview-actions">
                           <a class="btn-outline" data-preview-test target="_blank">@L["Admin_Games_Test"].Value</a>
                            <form asp-action="ApproveGame" method="post" data-preview-approve>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="" />
                                <button type="submit" class="btn-primary">@L["Admin_Games_Approve"].Value</button>
                            </form>
                            <form asp-action="ClearGameRankings" method="post" class="inline-form" onsubmit="return confirm('@L["Admin_Games_Rankings_Clear_Confirm"].Value');" data-preview-clear-rankings>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="" />
                                <button type="submit" class="btn-outline">@L["Admin_Games_Rankings_Clear"].Value</button>
                            </form>
                            <form asp-action="RemoveGame" method="post" class="inline-form" onsubmit="return confirm('@L["Admin_Games_Remove_Confirm"].Value');" data-preview-delete hidden>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="" />
                                <button type="submit" class="btn-danger">@L["Admin_Games_Remove"].Value</button>
                            </form>
                            <button type="button" class="btn-outline" data-open-moderation>@L["Admin_Games_Reject"].Value</button>
                        </div>
                    </section>

                    <section class="drawer-editor" data-drawer-editor hidden>
                        <div class="editor-layout">
                            <aside class="editor-summary" data-editor-summary>
                                <div class="summary-cover" data-summary-cover></div>
                                <div class="summary-content">
                                    <h3 data-summary-title></h3>
                                    <dl class="summary-list">
                                        <div>
                                            <dt>@L["Admin_Games_Metadata_Author"].Value</dt>
                                            <dd data-summary-owner></dd>
                                        </div>
                                        <div>
                                            <dt>@L["Dashboard_Games_Submitted"].Value</dt>
                                            <dd data-summary-created></dd>
                                        </div>
                                        <div>
                                            <dt>@L["Dashboard_Games_Status"].Value</dt>
                                            <dd data-summary-status></dd>
                                        </div>
                                        <div>
                                            <dt>@L["Admin_Games_Metadata_Categories"].Value</dt>
                                            <dd data-summary-categories></dd>
                                        </div>
                                    </dl>
                                </div>
                            </aside>

                            <form class="editor-form" asp-action="UpdateGameMetadata" method="post" enctype="multipart/form-data" id="metadata-form" data-metadata-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="" data-field-id />
                                <div class="accordion" data-accordion>
                                    <article class="accordion-item" data-accordion-item="basics">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="true" data-accordion-trigger>
                                                <span>@L["Admin_Games_Accordion_Basics"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Title"].Value</span>
                                                <input type="text" name="Title" data-field-title maxlength="120" required />
                                                <small>@L["Admin_Games_Metadata_Title_Help"].Value</small>
                                            </label>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Slug"].Value</span>
                                                <input type="text" name="Slug" data-field-slug maxlength="140" required />
                                                <small>@L["Admin_Games_Metadata_Slug_Help"].Value</small>
                                            </label>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Author"].Value</span>
                                                <input type="text" data-field-owner readonly />
                                                <small>@L["Admin_Games_Metadata_Author_Help"].Value</small>
                                            </label>
                                        </div>
                                    </article>

                                    <article class="accordion-item" data-accordion-item="media">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                                                <span>@L["Admin_Games_Accordion_Media"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel hidden>
                                            <label class="form-field">
                                               <span>@L["Admin_Games_Metadata_Cover"].Value</span>
                                                <input type="text" name="CoverImagePath" data-field-cover maxlength="256" />
                                                <small>@L["Admin_Games_Metadata_Cover_Help"].Value</small>
                                                <div class="metadata-cover-upload">
                                                    <label class="metadata-cover-upload__button">
                                                        <span>@L["Dashboard_Common_SelectFile"].Value</span>
                                                        <input type="file" name="CoverImageUpload" accept="image/*" data-field-cover-upload />
                                                    </label>
                                                    <span class="metadata-cover-upload__filename" data-cover-upload-label data-default-label="@L["Dashboard_Common_NoFile"].Value">@L["Dashboard_Common_NoFile"].Value</span>
                                                </div>
                                            </label>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Package_Version"].Value</span>
                                                <input type="text" name="PackageVersion" data-field-package-version maxlength="40" />
                                                <small>@L["Admin_Games_Metadata_Package_Version_Help"].Value</small>
                                            </label>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Package"].Value</span>
                                                <div class="metadata-cover-upload">
                                                    <label class="metadata-cover-upload__button">
                                                        <span>@L["Dashboard_Common_SelectFile"].Value</span>
                                                        <input type="file" name="PackageUpload" accept=".zip" data-field-package-upload />
                                                    </label>
                                                    <span class="metadata-cover-upload__filename" data-package-upload-label data-default-label="@L["Dashboard_Common_NoFile"].Value">@L["Dashboard_Common_NoFile"].Value</span>
                                                </div>
                                                <small>@L["Admin_Games_Metadata_Package_Help"].Value</small>
                                            </label>
                                        </div>
                                    </article>

                                    <article class="accordion-item" data-accordion-item="classification">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                                                <span>@L["Admin_Games_Accordion_Classification"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel hidden>
                                            <div class="chips-field" data-chips-field="categories" data-hidden-name="Categories">
                                                <header>
                                                    <h4>@L["Admin_Games_Metadata_Categories"].Value</h4>
                                                    <div class="chips-tools">
                                                        <button type="button" class="btn-link" data-chips-undo title="@L["Common_Undo"].Value">↺</button>
                                                        <button type="button" class="btn-link" data-chips-redo title="@L["Common_Redo"].Value">↻</button>
                                                    </div>
                                                </header>
                                                <div class="chips-input">
                                                    <label>
                                                       <span>@L["Admin_Games_Metadata_Category_Add"].Value</span>
                                                        <input type="text" placeholder="@L["Admin_Games_Metadata_Category_Search"].Value" data-chips-input />
                                                    </label>
                                                    <div class="chips-suggestions" data-chips-suggestions></div>
                                                </div>
                                                <div class="chips-columns">
                                                    <div class="chips-column">
                                                        <h5>@L["Admin_Games_Metadata_Source_Proposed"].Value</h5>
                                                        <div class="chips-list" data-chips-list="proposed"></div>
                                                    </div>
                                                    <div class="chips-column">
                                                        <h5>@L["Admin_Games_Metadata_Source_Published"].Value</h5>
                                                        <div class="chips-list" data-chips-list="published"></div>
                                                    </div>
                                                </div>
                                                <div class="chips-hidden" data-chips-hidden></div>
                                            </div>
                                        </div>
                                    </article>

                                    <article class="accordion-item" data-accordion-item="description">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                                                <span>@L["Admin_Games_Accordion_Description"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel hidden>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Description"].Value</span>
                                                <textarea name="Description" data-field-description maxlength="2000"></textarea>
                                                <small>@L["Admin_Games_Metadata_Description_Help"].Value</small>
                                            </label>
                                            <div class="metadata-tags">
                                                <strong>@L["Admin_Games_Metadata_Tags"].Value</strong>
                                                <div class="tag-list" data-tags-list></div>
                                            </div>
                                        </div>
                                    </article>

                                    <article class="accordion-item" data-accordion-item="rules">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                                                <span>@L["Admin_Games_Accordion_Rules"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel hidden>
                                            <label class="form-field">
                                                <span>@L["Admin_Games_Metadata_Rules"].Value</span>
                                                <textarea name="Rules" data-field-rules></textarea>
                                                <small>@L["Admin_Games_Metadata_Rules_Help"].Value</small>
                                            </label>
                                        </div>
                                    </article>

                                    <article class="accordion-item" data-accordion-item="moderation">
                                        <header class="accordion-header">
                                            <button type="button" class="accordion-trigger" aria-expanded="false" data-accordion-trigger>
                                                 <span>@L["Admin_Games_Accordion_Moderation"].Value</span>
                                            </button>
                                        </header>
                                        <div class="accordion-panel" data-accordion-panel hidden>
                                            <div class="moderation-field">
                                                <label>
                                                    <span>@L["Dashboard_Games_Status"].Value</span>
                                                    <select data-field-status disabled>
                                                        @foreach (var status in statuses)
                                                        {
                                                            <option value="@status">@FormatStatus(status)</option>
                                                        }
                                                    </select>
                                                    <small>@L["Admin_Games_Moderation_Status_Help"].Value</small>
                                                </label>
                                            </div>
                                            <div class="moderation-field">
                                                <label>
                                                    <span>@L["Admin_Games_Moderation_Notes_Label"].Value</span>
                                                    <textarea data-field-notes maxlength="500" readonly></textarea>
                                                    <small>@L["Admin_Games_Moderation_Notes_Help"].Value</small>
                                                </label>
                                            </div>
                                            <form asp-action="RejectGame" method="post" class="moderation-reject" data-reject-form>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="" />
                                                <label>
                                                    <span>@L["Admin_Games_Reject_Notes"].Value</span>
                                                    <textarea name="Notes" maxlength="500" data-reject-notes></textarea>
                                                    <small>@L["Admin_Games_Reject_Notes_Help"].Value</small>
                                                </label>
                                                <button type="submit" class="btn-danger">@L["Admin_Games_Reject_Submit"].Value</button>
                                            </form>
                                        </div>
                                    </article>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>

                <footer class="drawer__footer" data-action-bar>
                    <div class="action-status" data-save-status>@L["Admin_Games_SaveStatus_Draft"].Value</div>
                    <div class="action-buttons">
                        <button type="submit" form="metadata-form" class="btn-primary btn-compact" data-save-button>@L["Common_Save"].Value</button>
                        <a class="btn-primary btn-compact" data-preview-link target="_blank">@L["Admin_Games_Preview"].Value</a>
                        <button type="button" class="btn-outline btn-compact" data-footer-reject>@L["Admin_Games_Reject"].Value</button>
                        <button type="button" class="btn-danger btn-compact" data-cancel-edit>@L["Common_Cancel"].Value</button>
                    </div>
                </footer>
            </div>
        </aside>
    </div>
    
</section>

@section Scripts {
    <script src="~/js/admin-games.js" asp-append-version="true"></script>
}