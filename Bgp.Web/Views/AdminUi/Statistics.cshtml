@model Bgp.Web.Models.StatsPageVm
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Admin_Stats_Title"].Value;
}

<section class="admin-section admin-stats" data-stats-root
         data-summary-url="@Url.Action("StatsSummary", "AdminUi")"
         data-series-url="@Url.Action("StatsSeries", "AdminUi")"
         data-heatmap-url="@Url.Action("StatsHeatmap", "AdminUi")"
         data-top-url="@Url.Action("StatsTop", "AdminUi")"
         data-drilldown-url="@Url.Action("StatsDrilldown", "AdminUi")"
         data-range="@Model.Filter.RangePreset"
         data-granularity="@Model.Filter.Granularity"
         data-start="@Model.Filter.StartDate.ToString("yyyy-MM-dd")"
         data-end="@Model.Filter.EndDate.ToString("yyyy-MM-dd")"
         data-compare="@Model.Filter.CompareEnabled.ToString().ToLowerInvariant()"
         data-show-inactive="@Model.Filter.ShowInactiveDays.ToString().ToLowerInvariant()"
         data-empty-text="@L["Admin_Stats_Empty"].Value"
         data-error-text="@L["Admin_Stats_Insights_Empty"].Value"
         data-range-label="@Model.Filter.RangeLabel"
         data-timezone="@Model.Timezone"
         data-average-rating-label="@L["Admin_Stats_AverageRating"].Value">
    <nav class="admin-nav">
        <a class="admin-nav__item" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item" asp-action="Content">@L["Admin_Nav_Content"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
        <a class="admin-nav__item" asp-action="Logs">@L["Admin_Nav_Logs"].Value</a>
        <a class="admin-nav__item active" asp-action="Statistics">@L["Admin_Nav_Stats"].Value</a>
    </nav>

    <header class="admin-header">
        <div>
            <h1>@L["Admin_Stats_Title"].Value</h1>
            <p>@L["Admin_Stats_Subtitle"].Value</p>
        </div>
    </header>

    @await Html.PartialAsync("Statistics/_StatsTabs")
    @await Html.PartialAsync("Statistics/_StatsFilterBar", Model)

    <div class="stats-tab-panels">
        <section class="stats-tab-panel is-active" data-tab-panel="overview">
            @await Html.PartialAsync("Statistics/_KpiGrid", Model)
            @await Html.PartialAsync("Statistics/_TrendChart")
            <div class="stats-section stats-section--grid">
                @await Html.PartialAsync("Statistics/_Heatmap")
                @await Html.PartialAsync("Statistics/_Insights")
            </div>
            <div class="stats-section stats-section--grid">
                <div class="stats-card" data-toplists>
                    <header class="stats-card__header">
                        <h3>@L["Admin_Stats_Details_Title"].Value</h3>
                        <p>@L["Admin_Stats_Details_Subtitle"].Value</p>
                    </header>
                    <div class="stats-details">
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_TopDays_Title"].Value</h4>
                            <ul data-top-days></ul>
                        </div>
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_TopGames_Title"].Value</h4>
                            <ul data-top-games></ul>
                        </div>
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_NewGames_Title"].Value</h4>
                            <ul data-new-games></ul>
                        </div>
                    </div>
                </div>
                <div class="stats-card" data-moderation-card>
                    <header class="stats-card__header">
                        <h3>@L["Admin_Stats_Moderation_Title"].Value</h3>
                        <p>@L["Admin_Stats_Moderation_Subtitle"].Value</p>
                    </header>
                    <div class="stats-details">
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_Moderation_Reports"].Value</h4>
                            <ul data-report-reasons></ul>
                        </div>
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_RatingDist_Title"].Value</h4>
                            <ul data-rating-distribution></ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stats-tab-panel" data-tab-panel="engagement">
            @await Html.PartialAsync("Statistics/_KpiGrid", Model)
            @await Html.PartialAsync("Statistics/_TrendChart")
            @await Html.PartialAsync("Statistics/_Heatmap")
        </section>

        <section class="stats-tab-panel" data-tab-panel="content">
            @await Html.PartialAsync("Statistics/_KpiGrid", Model)
            @await Html.PartialAsync("Statistics/_TrendChart")
            <div class="stats-section stats-section--grid">
                @await Html.PartialAsync("Statistics/_Heatmap")
                <div class="stats-card" data-toplists>
                    <header class="stats-card__header">
                        <h3>@L["Admin_Stats_Details_Title"].Value</h3>
                        <p>@L["Admin_Stats_Details_Subtitle"].Value</p>
                    </header>
                    <div class="stats-details">
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_TopGames_Title"].Value</h4>
                            <ul data-top-games></ul>
                        </div>
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_NewGames_Title"].Value</h4>
                            <ul data-new-games></ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stats-tab-panel" data-tab-panel="ratings">
            @await Html.PartialAsync("Statistics/_KpiGrid", Model)
            @await Html.PartialAsync("Statistics/_TrendChart")
            <div class="stats-section stats-section--grid">
                @await Html.PartialAsync("Statistics/_Heatmap")
                <div class="stats-card" data-ratings-card>
                    <header class="stats-card__header">
                        <h3>@L["Admin_Stats_RatingDist_Title"].Value</h3>
                        <p>@L["Admin_Stats_Trends_Subtitle"].Value</p>
                    </header>
                    <div class="stats-details">
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_RatingDist_Title"].Value</h4>
                            <ul data-rating-distribution></ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stats-tab-panel" data-tab-panel="moderation">
            @await Html.PartialAsync("Statistics/_KpiGrid", Model)
            @await Html.PartialAsync("Statistics/_TrendChart")
            <div class="stats-section stats-section--grid">
                @await Html.PartialAsync("Statistics/_Heatmap")
                <div class="stats-card" data-moderation-card>
                    <header class="stats-card__header">
                        <h3>@L["Admin_Stats_Moderation_Title"].Value</h3>
                        <p>@L["Admin_Stats_Moderation_Subtitle"].Value</p>
                    </header>
                    <div class="stats-details">
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_Moderation_Reports"].Value</h4>
                            <ul data-report-reasons></ul>
                        </div>
                        <div class="stats-details__block">
                            <h4>@L["Admin_Stats_RatingDist_Title"].Value</h4>
                            <ul data-rating-distribution></ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    @await Html.PartialAsync("Statistics/_Drawer")
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin-stats.js" asp-append-version="true"></script>
}