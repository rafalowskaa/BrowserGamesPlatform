@using Bgp.Domain.Enums
@using Bgp.Web.Helpers
@model Bgp.Domain.Entities.Game
@{
    ViewData["Title"] = L["Admin_Games_Test_Title"].Value;
    var playUrl = ViewBag.PlayUrl as string;
    var owner = ViewBag.Owner as string ?? Model.CreatedByUserId.ToUpperInvariant();
    var approvedTags = Model.Tags?.Where(t => t.IsApproved).Select(t => t.Value).OrderBy(t => t).ToList() ?? new List<string>();
    string FormatModes(GameMode modes)
    {
        if (modes == GameMode.None)
        {
            return L["Games_Details_Mode_Unspecified"].Value;
        }

        var labels = GameMetadataOptions.ModeDefinitions
            .Where(def => (modes & def.Mode) != 0)
            .Select(def => L[def.ResourceKey].Value)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        return labels.Count == 0 ? L["Games_Details_Mode_Unspecified"].Value : string.Join(", ", labels);
    }

    string FormatCategories(GameCategory categories)
    {
        if (categories == GameCategory.None)
        {
            return L["Games_Details_Category_Unspecified"].Value;
        }

        var labels = GameMetadataOptions.CategoryDefinitions
            .Where(def => (categories & def.Category) != 0)
            .Select(def => L[def.ResourceKey].Value)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        return labels.Count == 0 ? L["Games_Details_Category_Unspecified"].Value : string.Join(", ", labels);
    }
}

<section class="panel">
    <header class="panel__header">
        <div>
            <h2>@Model.Title</h2>
            <p class="muted">@L["Admin_Games_Test_Subtitle"].Value</p>
        </div>
        <div class="panel__meta">
            <span>@L["Admin_Games_Metadata_Author"].Value: @owner</span>
            <span>@L["Dashboard_Games_Status"].Value: @L[$"Dashboard_Games_Status_{Model.ApprovalStatus}"].Value</span>
        </div>
    </header>

    <p>@Model.Description</p>

    <div class="game-meta-panel">
        <div><strong>@L["Games_Details_Modes"].Value</strong><span>@FormatModes(Model.Modes)</span></div>
        <div><strong>@L["Games_Details_Categories"].Value</strong><span>@FormatCategories(Model.Categories)</span></div>
        @if (approvedTags.Any())
        {
            <div class="game-tags">
                <strong>@L["Games_Details_Tags"].Value</strong>
                <div class="tag-list">
                    @foreach (var tag in approvedTags)
                    {
                        <span class="badge subtle">@tag</span>
                    }
                </div>
            </div>
        }
    </div>

    @if (playUrl is not null)
    {
        <div class="player">
            <iframe src="@playUrl" title="game" loading="lazy"></iframe>
        </div>
    }
    else
    {
        <div class="alert">@L["Details_NoBuild"].Value</div>
    }
</section>