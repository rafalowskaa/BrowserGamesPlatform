<div class="stats-card" data-insights-card>
    <header class="stats-card__header">
        <h3>@L["Admin_Stats_Insights_Title"].Value</h3>
        <p>@L["Admin_Stats_Insights_Subtitle"].Value</p>
    </header>
    <div class="stats-insights" data-insights></div>
    <p class="stats-empty" data-insights-empty hidden>@L["Admin_Stats_Insights_Empty"].Value</p>
</div>