<div class="stats-card" data-heatmap-card>
    <header class="stats-card__header">
        <h3>@L["Admin_Stats_Heatmap_Title"].Value</h3>
        <p>@L["Admin_Stats_Heatmap_Subtitle"].Value</p>
    </header>
    <div class="stats-heatmap" data-heatmap>
        <div class="stats-heatmap__head">
            <span>@L["Admin_Stats_Heatmap_Date"].Value</span>
            <span>@L["Admin_Stats_Kpi_Logins"].Value</span>
            <span>@L["Admin_Stats_Kpi_GamesPlayed"].Value</span>
            <span>@L["Admin_Stats_Kpi_Comments"].Value</span>
            <span>@L["Admin_Stats_Kpi_Ratings"].Value</span>
            <span>@L["Admin_Stats_Kpi_GamesPublished"].Value</span>
        </div>
        <div class="stats-heatmap__body" data-heatmap-body></div>
        <p class="stats-empty" data-heatmap-empty hidden>@L["Admin_Stats_Empty"].Value</p>
    </div>
</div>