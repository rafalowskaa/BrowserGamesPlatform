<div class="stats-tabs" role="tablist">
    <button class="stats-tab is-active" type="button" role="tab" aria-selected="true" data-tab="overview">@L["Admin_Stats_Tab_Overview"].Value</button>
    <button class="stats-tab" type="button" role="tab" aria-selected="false" data-tab="engagement">@L["Admin_Stats_Tab_Engagement"].Value</button>
    <button class="stats-tab" type="button" role="tab" aria-selected="false" data-tab="content">@L["Admin_Stats_Tab_Content"].Value</button>
    <button class="stats-tab" type="button" role="tab" aria-selected="false" data-tab="ratings">@L["Admin_Stats_Tab_Ratings"].Value</button>
    <button class="stats-tab" type="button" role="tab" aria-selected="false" data-tab="moderation">@L["Admin_Stats_Tab_Moderation"].Value</button>
</div>