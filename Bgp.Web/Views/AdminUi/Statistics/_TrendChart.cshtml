<section class="stats-section" data-trend-section>
    <header class="stats-section__header">
        <div>
            <h2>@L["Admin_Stats_Trends_Title"].Value</h2>
            <p>@L["Admin_Stats_Trends_Subtitle"].Value</p>
        </div>
        <div class="stats-trend-controls">
            <label class="stats-filter">
                <span>@L["Admin_Stats_Trends_Metric"].Value</span>
                <select data-metric-select>
                    <option value="activeUsers">@L["Admin_Stats_Kpi_ActiveUsers"].Value</option>
                    <option value="logins">@L["Admin_Stats_Kpi_Logins"].Value</option>
                    <option value="gamesPlayed">@L["Admin_Stats_Kpi_GamesPlayed"].Value</option>
                    <option value="comments">@L["Admin_Stats_Kpi_Comments"].Value</option>
                    <option value="ratings">@L["Admin_Stats_Kpi_Ratings"].Value</option>
                    <option value="gamesPublished">@L["Admin_Stats_Kpi_GamesPublished"].Value</option>
                </select>
            </label>
            <label class="stats-toggle">
                <input type="checkbox" data-multi-series-toggle />
                <span>@L["Admin_Stats_Trends_Multi"].Value</span>
            </label>
        </div>
    </header>
    <div class="stats-chart-card" data-trend-chart>
        <canvas data-trend-canvas height="120"></canvas>
        <div class="stats-legend" data-trend-legend>
            <span class="stats-legend__item" data-tone="active">@L["Admin_Stats_Kpi_ActiveUsers"].Value</span>
            <span class="stats-legend__item" data-tone="logins">@L["Admin_Stats_Kpi_Logins"].Value</span>
            <span class="stats-legend__item" data-tone="games">@L["Admin_Stats_Kpi_GamesPlayed"].Value</span>
            <span class="stats-legend__item" data-tone="comments">@L["Admin_Stats_Kpi_Comments"].Value</span>
            <span class="stats-legend__item" data-tone="ratings">@L["Admin_Stats_Kpi_Ratings"].Value</span>
            <span class="stats-legend__item" data-tone="published">@L["Admin_Stats_Kpi_GamesPublished"].Value</span>
        </div>
        <p class="stats-empty" data-trend-empty hidden>@L["Admin_Stats_Empty"].Value</p>
    </div>
</section>