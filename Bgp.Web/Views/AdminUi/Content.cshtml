@using System
@using System.Linq
@model AdminHomeContentViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Admin_Content_Title"].Value;
    var nextFactSort = Model.Facts.Any() ? Model.Facts.Max(f => f.SortOrder) + 1 : 1;
    var nextEventSort = Model.Events.Any() ? Model.Events.Max(e => e.SortOrder) + 1 : 1;
    var previewUrlBase = Url.Action("Index", "Home") ?? "/";
    var previewUrl = $"{previewUrlBase}?preview=draft&token=demo";

    string BuildExpiryBadge(DateTime endsAtUtc)
    {
        var span = endsAtUtc.ToLocalTime() - DateTime.Now;
        if (span.TotalSeconds <= 0)
        {
            return L["Admin_Content_Event_Expiry_Expired"].Value;
        }

        if (span.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)Math.Ceiling(span.TotalHours));
            return string.Format(L["Admin_Content_Event_Expiry_Hours"].Value, hours);
        }

        var days = Math.Max(1, (int)Math.Ceiling(span.TotalDays));
        return string.Format(L["Admin_Content_Event_Expiry_Days"].Value, days);
    }
}
<section class="admin-section admin-content-page"
         data-admin-content-root
         data-trending-url="/api/home/trending?limit=24"
         data-game-lookup-url="/api/games/"
         data-featured-slug-prompt="@L["Admin_Content_Feature_Prompt_Slug"].Value"
         data-featured-error="@L["Admin_Content_Feature_Error_Game"].Value"
         data-featured-random-error="@L["Admin_Content_Feature_Error_Random"].Value"
         data-featured-placeholder="@Url.Content("~/img/placeholders/game-cover.svg")">
    <nav class="admin-nav">
        <a class="admin-nav__item" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item active" asp-action="Content">@L["Admin_Nav_Content"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
    </nav>

    <header class="admin-header admin-content-page__header">
        <div>
            <h1>@L["Admin_Content_Title"].Value</h1>
            <p>@L["Admin_Content_Subtitle"].Value</p>
        </div>
    </header>

    <div class="admin-toast-stack" aria-live="polite">
        @if (!string.IsNullOrEmpty(Model.SuccessKey))
        {
            <div class="admin-toast is-success" data-admin-toast>@L[Model.SuccessKey].Value</div>
        }
        else if (!string.IsNullOrEmpty(Model.ErrorKey))
        {
            <div class="admin-toast is-error" data-admin-toast>@L[Model.ErrorKey].Value</div>
        }
    </div>

    <div class="admin-home-grid">
        <aside class="admin-home-grid__column admin-home-grid__column--nav">
            <div class="admin-home-nav" role="navigation" aria-label="@L["Admin_Content_HomeNav_AriaLabel"].Value">
                <div class="admin-home-nav__title">@L["Admin_Content_HomeNav_Title"].Value</div>
                <ul>
                    <li><button type="button" class="admin-home-nav__item is-active" data-admin-section-button="#feature">@L["Admin_Content_HomeNav_Feature"].Value</button></li>
                    <li><button type="button" class="admin-home-nav__item" data-admin-section-button="#facts">@L["Admin_Content_HomeNav_Facts"].Value</button></li>
                    <li><button type="button" class="admin-home-nav__item" data-admin-section-button="#events">@L["Admin_Content_HomeNav_Events"].Value</button></li>
                    <li><button type="button" class="admin-home-nav__item" data-admin-section-button="#layout">@L["Admin_Content_HomeNav_Layout"].Value</button></li>
                </ul>
            </div>
            <div class="admin-home-history">
                <h3>@L["Admin_Content_History_Title"].Value</h3>
                <p>@L["Admin_Content_History_Description"].Value</p>
                <button type="button" class="btn-secondary btn-small" disabled>@L["Admin_Content_History_Button"].Value</button>
            </div>
        </aside>

        <div class="admin-home-grid__column admin-home-grid__column--editor">
            <div class="admin-editor-toolbar">
                <div class="admin-editor-toolbar__primary">
                    <button type="button" class="btn-primary btn-small">@L["Admin_Content_Toolbar_Add"].Value</button>
                    <button type="button" class="btn-secondary btn-small">@L["Admin_Content_Toolbar_PublishAll"].Value</button>
                </div>
                <div class="admin-editor-toolbar__filters">
                    <label>
                        <span>@L["Admin_Content_Toolbar_SearchLabel"].Value</span>
                        <input type="search" placeholder="@L["Admin_Content_Toolbar_SearchPlaceholder"].Value" />
                    </label>
                    <label>
                        <span>@L["Admin_Content_Status_Label"].Value</span>
                        <select>
                            <option>@L["Admin_Content_Toolbar_Filter_All"].Value</option>
                            <option>@L["Admin_Content_Status_Draft"].Value</option>
                            <option>@L["Admin_Content_Status_Active"].Value</option>
                            <option>@L["Admin_Content_Status_Scheduled"].Value</option>
                        </select>
                    </label>
                </div>
            </div>

            <section id="feature" class="admin-editor-section" data-admin-section>
                <header>
                    <div>
                        <p class="admin-editor-section__eyebrow">@L["Admin_Content_Feature_Eyebrow"].Value</p>
                        <h2>@L["Admin_Content_Feature_Title"].Value</h2>
                        <p class="muted">@L["Admin_Content_Feature_Description"].Value</p>
                    </div>
                    <div class="admin-editor-section__actions">
                        <button type="button" class="btn-ghost btn-small">@L["Admin_Content_Feature_Action_Randomize"].Value</button>
                        <button type="button" class="btn-outline btn-small">@L["Admin_Content_Feature_Action_Replace"].Value</button>
                    </div>
                </header>
                @{
                    var featuredPlaceholder = Url.Content("~/img/placeholders/game-cover.svg");
                    var featuredCover = string.IsNullOrWhiteSpace(Model.FeaturedGame?.CoverImagePath)
                    ? featuredPlaceholder
                    : Url.Content(Model.FeaturedGame.CoverImagePath);
                    var featuredStart = Model.FeaturedGame?.StartsAtUtc.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
                    var featuredEnd = Model.FeaturedGame?.EndsAtUtc.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
                }
                <article class="admin-editor-card admin-editor-card--feature" data-featured-section>
                    <div class="admin-featured-card">
                        <div class="admin-featured-card__preview">
                            <div class="admin-featured-card__cover" data-featured-cover style="background-image:url('@featuredCover');"></div>
                            <div class="admin-featured-card__details">
                                <p class="admin-featured-card__slug" data-featured-slug>@(Model.FeaturedGame?.GameSlug ?? L["Admin_Content_Feature_GamePlaceholder"].Value)</p>
                                <h3 data-featured-title-display>@(Model.FeaturedGame?.GameTitle ?? L["Admin_Content_Feature_GameValue"].Value)</h3>
                                <p class="muted" data-featured-preview-description>@(Model.FeaturedGame?.Description ?? L["Admin_Content_Feature_DescriptionPlaceholder"].Value)</p>
                            </div>
                        </div>
                        <form asp-action="SaveFeaturedGame" method="post" class="admin-card-form" data-featured-form>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@Model.FeaturedGame?.Id" data-featured-id />
                            <input type="hidden" name="GameId" value="@Model.FeaturedGame?.GameId" data-featured-game-id />
                            <div class="admin-field admin-field--inline">
                                <label>
                                    <span>@L["Admin_Content_Feature_GameLabel"].Value</span>
                                    <input type="text" value="@Model.FeaturedGame?.GameTitle" readonly data-featured-title-input placeholder="@L["Admin_Content_Feature_GamePlaceholder"].Value" />
                                </label>
                                <label>
                                    <span>@L["Admin_Content_Feature_SlugLabel"].Value</span>
                                    <input type="text" value="@Model.FeaturedGame?.GameSlug" readonly data-featured-slug-input placeholder="@L["Admin_Content_Feature_SlugPlaceholder"].Value" />
                                </label>
                            </div>
                            <div class="admin-field">
                                <label>
                                    <span>@L["Admin_Content_Feature_DescriptionLabel"].Value</span>
                                    <textarea name="Description" rows="3" placeholder="@L["Admin_Content_Feature_DescriptionPlaceholder"].Value" data-inline-input>@Model.FeaturedGame?.Description</textarea>
                                </label>
                            </div>
                            <div class="admin-field admin-field--inline admin-featured-card__schedule">
                                <label>
                                    <span>@L["Admin_Content_Feature_StartLabel"].Value</span>
                                    <input type="datetime-local" name="StartsAt" value="@featuredStart" data-featured-start />
                                </label>
                                <label>
                                    <span>@L["Admin_Content_Feature_EndLabel"].Value</span>
                                    <input type="datetime-local" name="EndsAt" value="@featuredEnd" data-featured-end />
                                </label>
                                <label>
                                    <span>@L["Admin_Content_Status_Label"].Value</span>
                                    <select name="IsActive" data-featured-status>
                                        <option value="false" selected="@((Model.FeaturedGame?.IsActive ?? false) ? null : "selected")">@L["Admin_Content_Status_Draft"].Value</option>
                                        <option value="true" selected="@((Model.FeaturedGame?.IsActive ?? false) ? "selected" : null)">@L["Admin_Content_Status_Active"].Value</option>
                                    </select>
                                </label>
                            </div>
                            <div class="admin-card-form__footer admin-featured-card__footer">
                                <div class="admin-featured-card__actions">
                                    <button type="button" class="btn-ghost btn-small" data-featured-random>@L["Admin_Content_Feature_Action_Randomize"].Value</button>
                                    <button type="button" class="btn-outline btn-small" data-featured-replace>@L["Admin_Content_Feature_Action_Replace"].Value</button>
                                </div>
                                <div class="admin-card-buttons">
                                    <button class="btn-primary btn-small" type="submit">@L["Admin_Content_Save"].Value</button>
                                </div>
                            </div>
                        </form>
                        @if (Model.FeaturedGame is not null)
                        {
                            <form asp-action="DeleteFeaturedGame" method="post" class="inline-form admin-card-delete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@Model.FeaturedGame.Id" />
                                <button class="btn-ghost btn-small" type="submit" onclick="return confirm('@L["Admin_Content_DeleteConfirm"].Value');">@L["Admin_Content_Delete"].Value</button>
                            </form>
                        }
                    </div>
                    <footer>
                        <small class="muted">@L["Admin_Content_Feature_Footer"].Value</small>
                    </footer>
                </article>
            </section>

            <section id="facts" class="admin-editor-section" data-admin-section hidden>
                <header>
                    <div>
                        <p class="admin-editor-section__eyebrow">@L["Admin_Content_Facts_Eyebrow"].Value</p>
                        <h2>@L["Admin_Content_Facts_Title"].Value</h2>
                        <p class="muted">@L["Admin_Content_Facts_Description"].Value</p>
                    </div>
                    <span class="admin-badge admin-badge--limit">@string.Format(L["Admin_Content_Facts_Limit"].Value, 6)</span>
                </header>
                <div class="admin-editor-list" data-dnd-list>
                    @if (Model.Facts.Any())
                    {
                        foreach (var fact in Model.Facts)
                        {
                            var updated = fact.UpdatedAtUtc?.ToLocalTime().ToString("g");
                            var status = fact.IsActive ? L["Admin_Content_Status_Active"].Value : L["Admin_Content_Status_Draft"].Value;
                            <article class="admin-editor-card" data-dnd-item>
                                <button type="button" class="admin-editor-card__handle" data-dnd-handle aria-label="@L["Admin_Content_Aria_DragCard"].Value">⋮⋮</button>
                                <div class="admin-editor-card__meta">
                                    <span>@string.Format(L["Admin_Content_Metadata_Created"].Value, fact.CreatedAtUtc.ToLocalTime().ToString("g"))</span>
                                    @if (!string.IsNullOrEmpty(updated))
                                    {
                                        <span class="muted">@string.Format(L["Admin_Content_Metadata_Updated"].Value, updated)</span>
                                    }
                                    <span class="admin-badge @(fact.IsActive ? "admin-badge--success" : "admin-badge--muted")">@status</span>
                                </div>
                                <form asp-action="SaveFact" method="post" class="admin-card-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@fact.Id" />
                                    <input type="hidden" name="IsActive" value="@(fact.IsActive ? "true" : "false")" data-status-input />
                                    <input type="hidden" name="SortOrder" value="@fact.SortOrder" class="admin-sort-input" />
                                    <label>
                                        <span>@L["Admin_Content_Facts_ContentLabel"].Value</span>
                                        <textarea name="Content" rows="3" data-inline-input readonly>@fact.Content</textarea>
                                    </label>
                                    <div class="admin-card-form__footer">
                                        <label>
                                            <span>@L["Admin_Content_Status_Label"].Value</span>
                                            <select class="admin-status-select" data-status-toggle>
                                                <option value="draft" selected="@(fact.IsActive ? null : "selected")">@L["Admin_Content_Status_Draft"].Value</option>
                                                <option value="active" selected="@(fact.IsActive ? "selected" : null)">@L["Admin_Content_Status_Active"].Value</option>
                                                <option value="scheduled" disabled>@L["Admin_Content_Status_Scheduled"].Value</option>
                                            </select>
                                        </label>
                                        <span class="admin-order-indicator">@string.Format(L["Admin_Content_OrderIndicator"].Value, fact.SortOrder)</span>
                                        <div class="admin-card-buttons">
                                            <button class="btn-primary btn-small" type="submit">@L["Admin_Content_Save"].Value</button>
                                        </div>
                                    </div>
                                </form>
                                <form asp-action="DeleteFact" method="post" class="inline-form admin-card-delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@fact.Id" />
                                    <button class="btn-ghost btn-small" type="submit" onclick="return confirm('@L["Admin_Content_DeleteConfirm"].Value');">@L["Admin_Content_Delete"].Value</button>
                                </form>
                            </article>
                        }
                    }
                    else
                    {
                        <p class="muted">@L["Admin_Content_Facts_Empty"].Value</p>
                    }
                </div>
                <article class="admin-editor-card admin-editor-card--accent">
                    <h3>@L["Admin_Content_Facts_Add"].Value</h3>
                    <form asp-action="SaveFact" method="post" class="admin-card-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IsActive" value="false" data-status-input />
                        <input type="hidden" name="SortOrder" value="@nextFactSort" />
                        <label>
                            <span>@L["Admin_Content_Facts_ContentLabel"].Value</span>
                            <textarea name="Content" rows="3" placeholder="@L["Admin_Content_Facts_Placeholder"].Value" data-inline-input></textarea>
                        </label>
                        <div class="admin-card-form__footer">
                            <label>
                                <span>@L["Admin_Content_Status_Label"].Value</span>
                                <select class="admin-status-select" data-status-toggle>
                                    <option value="draft">@L["Admin_Content_Status_Draft"].Value</option>
                                    <option value="active" selected>@L["Admin_Content_Status_Active"].Value</option>
                                    <option value="scheduled" disabled>@L["Admin_Content_Status_Scheduled"].Value</option>
                                </select>
                            </label>
                            <span class="admin-order-indicator">@string.Format(L["Admin_Content_OrderIndicator"].Value, nextFactSort)</span>
                            <div class="admin-card-buttons">
                                <button class="btn-primary btn-small" type="submit">@L["Admin_Content_Add"].Value</button>
                            </div>
                        </div>
                    </form>
                    
                </article>
            </section>

            <section id="events" class="admin-editor-section" data-admin-section hidden>
                <header>
                    <div>
                        <p class="admin-editor-section__eyebrow">@L["Admin_Content_Events_Eyebrow"].Value</p>
                        <h2>@L["Admin_Content_Events_Title"].Value</h2>
                        <p class="muted">@L["Admin_Content_Events_Description"].Value</p>
                    </div>
                    <span class="admin-badge admin-badge--limit">@string.Format(L["Admin_Content_Events_Limit"].Value, 3)</span>
                </header>
                <div class="admin-editor-list" data-dnd-list>
                    @if (Model.Events.Any())
                    {
                        foreach (var evt in Model.Events)
                        {
                            var updated = evt.UpdatedAtUtc?.ToLocalTime().ToString("g");
                            var status = evt.IsActive ? L["Admin_Content_Status_Active"].Value : L["Admin_Content_Status_Draft"].Value;
                            var expiryBadge = BuildExpiryBadge(evt.EndsAtUtc);
                            <article class="admin-editor-card" data-dnd-item>
                                <button type="button" class="admin-editor-card__handle" data-dnd-handle aria-label="@L["Admin_Content_Aria_DragCard"].Value">⋮⋮</button>
                                <div class="admin-editor-card__meta">
                                    <span>@string.Format(L["Admin_Content_Metadata_Created"].Value, evt.CreatedAtUtc.ToLocalTime().ToString("g"))</span>
                                    @if (!string.IsNullOrEmpty(updated))
                                    {
                                        <span class="muted">@string.Format(L["Admin_Content_Metadata_Updated"].Value, updated)</span>
                                    }
                                    <span class="admin-badge @(evt.IsActive ? "admin-badge--success" : "admin-badge--muted")">@status</span>
                                    <span class="admin-badge admin-badge--warning">@expiryBadge</span>
                                </div>
                                <form asp-action="SaveEvent" method="post" class="admin-card-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@evt.Id" />
                                    <input type="hidden" name="IsActive" value="@(evt.IsActive ? "true" : "false")" data-status-input />
                                    <input type="hidden" name="SortOrder" value="@evt.SortOrder" class="admin-sort-input" />
                                    <div class="admin-field admin-field--inline">
                                        <label>
                                            <span>@L["Admin_Content_Event_TitleLabel"].Value</span>
                                            <input type="text" name="Title" value="@evt.Title" maxlength="160" data-inline-input readonly />
                                        </label>
                                        <label>
                                            <span>@L["Admin_Content_Event_RewardLabel"].Value</span>
                                            <input type="text" name="Reward" value="@evt.Reward" maxlength="160" data-inline-input readonly />
                                        </label>
                                    </div>
                                    <div class="admin-field admin-field--inline">
                                        <label>
                                            <span>@L["Admin_Content_Event_EndLabel"].Value</span>
                                            <input type="datetime-local" name="EndsAt" value="@evt.EndsAtUtc.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" data-inline-input readonly />
                                        </label>
                                        <label>
                                            <span>@L["Admin_Content_Status_Label"].Value</span>
                                            <select class="admin-status-select" data-status-toggle>
                                                <option value="draft" selected="@(evt.IsActive ? null : "selected")">@L["Admin_Content_Status_Draft"].Value</option>
                                                <option value="active" selected="@(evt.IsActive ? "selected" : null)">@L["Admin_Content_Status_Active"].Value</option>
                                                <option value="scheduled" disabled>@L["Admin_Content_Status_Scheduled"].Value</option>
                                            </select>
                                        </label>
                                        <span class="admin-order-indicator">@string.Format(L["Admin_Content_OrderIndicator"].Value, evt.SortOrder)</span>
                                    </div>
                                    <div class="admin-card-buttons">
                                        <button class="btn-primary btn-small" type="submit">@L["Admin_Content_Save"].Value</button>
                                    </div>
                                </form>
                                <form asp-action="DeleteEvent" method="post" class="inline-form admin-card-delete">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@evt.Id" />
                                    <button class="btn-ghost btn-small" type="submit" onclick="return confirm('@L["Admin_Content_DeleteConfirm"].Value');">@L["Admin_Content_Delete"].Value</button>
                                </form>
                            </article>
                        }
                    }
                    else
                    {
                        <p class="muted">@L["Admin_Content_Events_Empty"].Value</p>
                    }
                </div>
                <article class="admin-editor-card admin-editor-card--accent">
                    <h3>@L["Admin_Content_Events_Add"].Value</h3>
                    <form asp-action="SaveEvent" method="post" class="admin-card-form">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" name="IsActive" value="false" />
                        <input type="hidden" name="SortOrder" value="@nextEventSort" />
                        <div class="admin-field admin-field--inline">
                            <label>
                                <span>@L["Admin_Content_Event_TitleLabel"].Value</span>
                                <input type="text" name="Title" maxlength="160" placeholder="@L["Admin_Content_Event_TitlePlaceholder"].Value" data-inline-input />
                            </label>
                            <label>
                                <span>@L["Admin_Content_Event_RewardLabel"].Value</span>
                                <input type="text" name="Reward" maxlength="160" placeholder="@L["Admin_Content_Event_RewardPlaceholder"].Value" data-inline-input />
                            </label>
                        </div>
                        <div class="admin-field admin-field--inline">
                            <label>
                                <span>@L["Admin_Content_Event_EndLabel"].Value</span>
                                <input type="datetime-local" name="EndsAt" value="@DateTime.UtcNow.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                            </label>
                            <label>
                                <span>@L["Admin_Content_Status_Label"].Value</span>
                                <select class="admin-status-select" data-status-toggle>
                                    <option value="draft">@L["Admin_Content_Status_Draft"].Value</option>
                                    <option value="active" selected>@L["Admin_Content_Status_Active"].Value</option>
                                    <option value="scheduled" disabled>@L["Admin_Content_Status_Scheduled"].Value</option>
                                </select>
                            </label>
                            <span class="admin-order-indicator">@string.Format(L["Admin_Content_OrderIndicator"].Value, nextEventSort)</span>
                        </div>
                        <div class="admin-card-buttons">
                            <button class="btn-primary btn-small" type="submit">@L["Admin_Content_Add"].Value</button>
                        </div>
                    </form>
                    
                </article>
            </section>

            <section id="layout" class="admin-editor-section" data-admin-section hidden>
                <header>
                    <div>
                        <p class="admin-editor-section__eyebrow">@L["Admin_Content_Layout_Eyebrow"].Value</p>
                        <h2>@L["Admin_Content_Layout_Title"].Value</h2>
                        <p class="muted">@L["Admin_Content_Layout_Description"].Value</p>
                    </div>
                </header>
                <div class="admin-layout-list" data-dnd-list>
                    @{
                        var sections = new[]
                        {
                                        L["Admin_Content_Layout_Section_Hero"].Value,
                                        L["Admin_Content_Layout_Section_Feature"].Value,
                                        L["Admin_Content_Layout_Section_Recommended"].Value,
                                        L["Admin_Content_Layout_Section_Trending"].Value,
                                        L["Admin_Content_Layout_Section_Facts"].Value,
                                        L["Admin_Content_Layout_Section_Events"].Value,
                                        L["Admin_Content_Layout_Section_Join"].Value
                                        };
                    }
                    @foreach (var layoutSection in sections.Select((name, index) => new { name, index }))
                    {
                        <article class="admin-layout-item" data-dnd-item>
                            <button type="button" class="admin-editor-card__handle" data-dnd-handle aria-label="@L["Admin_Content_Aria_DragSection"].Value">⋮⋮</button>
                            <div class="admin-layout-item__body">
                                <strong>@layoutSection.name</strong>
                                <span class="muted">@string.Format(L["Admin_Content_Layout_Position"].Value, layoutSection.index + 1)</span>
                            </div>
                            <label class="switch">
                                <input type="checkbox" checked />
                                <span></span>
                                <span class="switch__label">@L["Admin_Content_Layout_SwitchLabel"].Value</span>
                            </label>
                        </article>
                    }
                </div>
            </section>
        </div>

        <aside class="admin-home-grid__column admin-home-grid__column--preview">
            <div class="admin-preview">
                <header class="admin-preview__header">
                    <h3>@L["Admin_Content_Preview_Title"].Value</h3>
                    
                </header>
                <div class="admin-preview__frame" data-preview-frame>
                    <iframe src="@previewUrl" title="@L["Admin_Content_Preview_IframeTitle"].Value" data-admin-preview></iframe>
                </div>
                <footer>
                    <p class="muted">@L["Admin_Content_Preview_Description"].Value</p>
                    <button type="button" class="btn-secondary btn-small">@L["Admin_Content_Preview_Refresh"].Value</button>
                </footer>
            </div>
        </aside>
    </div>

    <div class="admin-sticky-actions">
        <button type="button" class="btn-ghost">@L["Admin_Content_Action_Cancel"].Value</button>
        <div class="admin-sticky-actions__spacer"></div>
        <button type="button" class="btn-secondary">@L["Admin_Content_Action_SaveDraft"].Value</button>
