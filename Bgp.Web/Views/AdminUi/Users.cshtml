@using System.Collections.Generic
@using System.Linq
@using System.Security.Claims
@using Bgp.Web.Models
@model AdminUsersViewModel
@{
    ViewData["Title"] = L["Admin_Users_Title"].Value;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentAdmin = User.IsInRole("Admin");
    var isCurrentModerator = User.IsInRole("Moderator");
}

<section class="admin-section">
    <nav class="admin-nav">
        <a class="admin-nav__item active" asp-action="Users">@L["Admin_Nav_Users"].Value</a>
        <a class="admin-nav__item" asp-action="Games">@L["Admin_Nav_Games"].Value</a>
        <a class="admin-nav__item" asp-action="Reports">@L["Admin_Nav_Reports"].Value</a>
    </nav>

    <header class="admin-header">
        <div>
            <h1>@L["Admin_Users_Title"].Value</h1>
            <p>@L["Admin_Users_Subtitle"].Value</p>
        </div>
        <form method="get" class="admin-search">
            <input type="search" name="search" value="@Model.Search" placeholder="@L["Admin_Users_SearchPlaceholder"].Value" />
            <button class="btn-primary btn-compact" type="submit">@L["Admin_Users_SearchButton"].Value</button>
        </form>
    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessKey))
    {
        <div class="alert success">@L[Model.SuccessKey].Value</div>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorKey))
    {
        <div class="alert error">@L[Model.ErrorKey].Value</div>
    }

    @if (Model.DisplayNameRequests.Any())
    {
        <section class="admin-subpanel">
            <h2>@L["Admin_Users_DisplayName_PendingTitle"].Value</h2>
            <div class="table-wrapper">
                <table class="admin-table compact">
                    <thead>
                        <tr>
                            <th>@L["Admin_Users_DisplayName_Current"].Value</th>
                            <th>@L["Admin_Users_DisplayName_Requested"].Value</th>
                            <th>@L["Admin_Users_DisplayName_RequestedAt"].Value</th>
                            <th class="min">@L["Admin_Users_Table_Actions"].Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.DisplayNameRequests)
                        {
                            <tr>
                                <td>@request.CurrentDisplayName</td>
                                <td>@request.RequestedDisplayName</td>
                                <td>@(request.RequestedAtUtc?.ToLocalTime().ToString("g") ?? "-")</td>
                                <td>
                                    <div class="admin-actions">
                                        <form asp-action="ApproveDisplayName" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@request.UserId" />
                                            <button class="btn-primary btn-small" type="submit">@L["Admin_Users_DisplayName_Approve"].Value</button>
                                        </form>
                                        <form asp-action="RejectDisplayName" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@request.UserId" />
                                            <button class="btn-ghost btn-small" type="submit">@L["Admin_Users_DisplayName_Reject"].Value</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <div class="table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Admin_Users_Table_Name"].Value</th>
                    <th>@L["Admin_Users_Table_Email"].Value</th>
                    <th>@L["Admin_Users_Table_Created"].Value</th>
                    <th>@L["Admin_Users_Table_Status"].Value</th>
                    <th>@L["Admin_Users_Table_AccessLevel"].Value</th>
                    <th class="min">@L["Admin_Users_Table_Actions"].Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    foreach (var user in Model.Users)
                    {
                        var isCurrent = string.Equals(user.Id, currentUserId, StringComparison.Ordinal);
                        var canManage = isCurrentAdmin || (isCurrentModerator && (user.AccessLevel == AdminUserAccessLevel.User || isCurrent));
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@user.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>
                                @{
                                    var statusPillClass = user.IsBlocked ? "status-rejected" : "status-approved";
                                    string blockedTooltip = null;
                                    string statusTitleAttribute = string.Empty;

                                    if (user.IsBlocked)
                                    {
                                        var blockedTooltipParts = new List<string>();

                                        if (user.BlockedUntilUtc.HasValue)
                                        {
                                            blockedTooltipParts.Add(L["Admin_Users_Status_Blocked_Until", user.BlockedUntilUtc.Value.ToLocalTime().ToString("g")].Value);
                                        }
                                        else
                                        {
                                            blockedTooltipParts.Add(L["Admin_Users_Status_Blocked_Permanent"].Value);
                                        }

                                        if (!string.IsNullOrWhiteSpace(user.BlockReason))
                                        {
                                            blockedTooltipParts.Add(L["Admin_Users_Status_Blocked_Reason", user.BlockReason].Value);
                                        }

                                        blockedTooltip = string.Join("\n", blockedTooltipParts);
                                    }

                                    if (!string.IsNullOrEmpty(blockedTooltip))
                                    {
                                        statusTitleAttribute = $" title=\"{Html.AttributeEncode(blockedTooltip)}\"";
                                    }
                                }

                                <span class="status-pill @statusPillClass" @Html.Raw(statusTitleAttribute)>
                                    @(user.IsBlocked? L["Admin_Users_Status_Blocked"].Value : L["Admin_Users_Status_Active"].Value)
                                </span>

                            </td>
                            <td>
                                @{
                                    var accessKey = user.AccessLevel switch
                                    {
                                        AdminUserAccessLevel.Admin => "Admin_Users_Access_Admin",
                                        AdminUserAccessLevel.Moderator => "Admin_Users_Access_Moderator",
                                        _ => "Admin_Users_Access_User"
                                    };
                                }
                                <span>@L[accessKey].Value</span>
                            </td>
                            <td>
                                <div class="admin-actions vertical">
                                    @if (canManage)
                                    {
                                        <button class="btn-primary btn-small" type="button"
                                                data-user-edit
                                                data-user-id="@user.Id"
                                                data-user-display-name="@user.DisplayName"
                                                data-user-email="@user.Email"
                                                data-user-access="@user.AccessLevel">
                                            @L["Admin_Users_Edit"].Value
                                        </button>

                                        if (!isCurrent)
                                        {
                                            if (user.IsBlocked)
                                            {
                                                <form asp-action="UnblockUser" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button class="btn-ghost btn-small" type="submit">@L["Admin_Users_Unblock"].Value</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn-ghost btn-small" type="button"
                                                        data-user-block
                                                        data-user-id="@user.Id"
                                                        data-user-display-name="@user.DisplayName">
                                                    @L["Admin_Users_Block"].Value
                                                </button>
                                            }
                                        }
                                        if (!isCurrent)
                                        {
                                            <form asp-action="DeleteUser" method="post" class="admin-inline-form" onsubmit="return confirm('@L["Admin_Users_Delete_Confirm"].Value');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button class="btn-danger btn-small" type="submit">@L["Admin_Users_Delete"].Value</button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">@L["Admin_Users_AdminProtected"].Value</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty">@L["Admin_Users_Empty"].Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
<div class="modal-backdrop" id="userEditModal" hidden>
        <div class="modal-backdrop__overlay" data-modal-close></div>
        <div class="modal-dialog">
            <form asp-action="UpdateUser" method="post" class="modal-dialog__content" id="userEditForm">
                @Html.AntiForgeryToken()
                <h3>@L["Admin_Users_Edit_Title"].Value</h3>
                <input type="hidden" name="Id" value="" data-modal-input="id" />
                <div class="modal-dialog__control">
                    <label class="modal-dialog__label" for="modalDisplayName">@L["Admin_Users_Edit_DisplayName"].Value</label>
                    <input class="modal-dialog__input" id="modalDisplayName" name="DisplayName" maxlength="120" data-modal-input="displayName" required />
                </div>
                <div class="modal-dialog__control">
                    <label class="modal-dialog__label" for="modalEmail">@L["Admin_Users_Edit_Email"].Value</label>
                    <input class="modal-dialog__input" id="modalEmail" name="Email" type="email" data-modal-input="email" required />
                </div>
                @if (isCurrentAdmin)
                {
                    <div class="modal-dialog__control">
                        <label class="modal-dialog__label" for="modalAccessLevel">@L["Admin_Users_Edit_AccessLevel"].Value</label>
                        <select class="modal-dialog__input" id="modalAccessLevel" name="AccessLevel" data-modal-input="access">
                            <option value="Admin">@L["Admin_Users_Access_Admin"].Value</option>
                            <option value="Moderator">@L["Admin_Users_Access_Moderator"].Value</option>
                            <option value="User">@L["Admin_Users_Access_User"].Value</option>
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="AccessLevel" value="User" data-modal-input="access" />
                    <p class="modal-dialog__message">@L["Admin_Users_Edit_RoleInfo"].Value</p>
                }
                <div class="modal-dialog__actions">
                    <button type="button" class="btn-outline" data-modal-close>@L["Admin_Users_Edit_Cancel"].Value</button>
                    <button type="submit" class="btn-primary">@L["Admin_Users_Save"].Value</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-backdrop" id="userBlockModal" hidden>
        <div class="modal-backdrop__overlay" data-modal-close></div>
        <div class="modal-dialog">
            <form asp-action="BlockUser" method="post" class="modal-dialog__content" id="userBlockForm">
                @Html.AntiForgeryToken()
                <h3>@L["Admin_Users_Block_Title"].Value</h3>
                <input type="hidden" name="Id" data-modal-input="id" />
                <p class="modal-dialog__message" data-block-message data-template="@L["Admin_Users_Block_Message"].Value"></p>
                <div class="modal-dialog__control">
                    <label class="modal-dialog__label" for="modalBlockReason">@L["Admin_Users_Block_Reason_Label"].Value</label>
                    <textarea class="modal-dialog__input" id="modalBlockReason" name="Reason" maxlength="250" data-modal-input="reason" required></textarea>
                    <span class="muted admin-block-form__hint">@L["Admin_Users_Block_Reason_Help"].Value</span>
                </div>
                <div class="modal-dialog__control">
                    <label class="modal-dialog__label" for="modalBlockedUntil">@L["Admin_Users_Block_Until_Label"].Value</label>
                    <input class="modal-dialog__input" id="modalBlockedUntil" name="BlockedUntil" type="datetime-local" data-modal-input="until" />
                    <span class="muted admin-block-form__hint">@L["Admin_Users_Block_Help"].Value</span>
                </div>
                <div class="modal-dialog__actions">
                    <button type="button" class="btn-outline" data-modal-close>@L["Admin_Users_Block_Cancel"].Value</button>
                    <button type="submit" class="btn-danger">@L["Admin_Users_Block_Confirm"].Value</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}