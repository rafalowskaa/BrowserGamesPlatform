@model Bgp.Web.Controllers.LoginVm
@{
    ViewData["Title"] = L["Auth_Login_Title"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
<section class="auth auth--login">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Login_Eyebrow"].Value</span>
        <h1>@L["Auth_Login_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Login_Tagline"].Value</p>
        <ul class="auth-hero__features">
            <li>@L["Auth_Login_Feature_Games"].Value</li>
            <li>@L["Auth_Login_Feature_Community"].Value</li>
            <li>@L["Auth_Login_Feature_Insights"].Value</li>
        </ul>
        <div class="auth-hero__cta">
            <span>@L["Auth_Login_NoAccount"].Value</span>
            <a class="btn-outline" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Login_RegisterLink"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Login_FormTitle"].Value</h2>
            <p>@L["Auth_Login_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="Login" method="post" class="form-vertical">
            <input type="hidden" asp-for="ReturnUrl" />
            <label for="LoginOrEmail">@L["Auth_Login_LoginOrEmail"].Value</label>
            <input asp-for="LoginOrEmail" id="LoginOrEmail" autocomplete="username" />
            <span asp-validation-for="LoginOrEmail" class="val"></span>

            <div class="password-field">

                <label for="Password">@L["Auth_Login_Password"].Value</label>
                <div class="password-field__input">
                    <input asp-for="Password" id="Password" type="password" autocomplete="current-password" aria-describedby="PasswordToggleHint" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle="Password"
                            data-password-show="@L["Auth_Password_Show"].Value"
                            data-password-hide="@L["Auth_Password_Hide"].Value"
                            data-password-shortcut="Alt+P"
                            aria-label="@L["Auth_Password_Show"].Value"
                            tabindex="-1">
                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <g class="password-toggle__icon-eye">
                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </g>
                            <g class="password-toggle__icon-eye-off">
                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                <path d="M15 12a3 3 0 00-3-3" />
                                <path d="M3 3l18 18" />
                            </g>
                        </svg>
                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                    </button>
                </div>
                
            </div>
            <span asp-validation-for="Password" class="val"></span>

            <label class="check"><input asp-for="RememberMe" /> @L["Auth_Login_RememberMe"].Value</label>
            <a class="auth-card__link" asp-action="ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Login_ForgotPassword"].Value</a>

            <button class="btn-primary" type="submit">@L["Auth_Login_LoginButton"].Value</button>
        </form>
        <p class="auth-card__hint">@Html.Raw(string.Format(L["Auth_Login_PolicyHint"].Value, Url.Action("Policy", "Home")))</p>
    </div>
</section>
