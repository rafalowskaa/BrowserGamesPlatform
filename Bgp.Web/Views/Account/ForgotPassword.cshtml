@model Bgp.Web.Controllers.ForgotPasswordVm
@{
    ViewData["Title"] = L["Auth_Forgot_Title"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
<section class="auth auth--forgot">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Forgot_Eyebrow"].Value</span>
        <h1>@L["Auth_Forgot_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Forgot_Lead"].Value</p>
        <div class="auth-hero__cta">
            <span>@L["Auth_Forgot_Remembered"].Value</span>
            <a class="btn-outline" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Forgot_Back"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Forgot_FormTitle"].Value</h2>
            <p>@L["Auth_Forgot_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="ForgotPassword" method="post" class="form-vertical">
            <input type="hidden" asp-for="ReturnUrl" />
            <label for="ForgotIdentifier">@L["Auth_Forgot_LoginOrEmail"].Value</label>
            <input asp-for="LoginOrEmail" id="ForgotIdentifier" autocomplete="username" />
            <span asp-validation-for="LoginOrEmail" class="val"></span>

            <button class="btn-primary" type="submit">@L["Auth_Forgot_Submit"].Value</button>
        </form>
    </div>
</section>