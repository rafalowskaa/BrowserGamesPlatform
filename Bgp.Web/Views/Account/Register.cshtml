@model Bgp.Web.Controllers.RegisterVm
@{
    ViewData["Title"] = L["Auth_Register_Title"].Value;
}
<section class="auth auth--register">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Register_Eyebrow"].Value</span>
        <h1>@L["Auth_Register_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Register_Tagline"].Value</p>
        <ul class="auth-hero__features">
            <li>@L["Auth_Register_Feature_Create"].Value</li>
            <li>@L["Auth_Register_Feature_Share"].Value</li>
            <li>@L["Auth_Register_Feature_Grow"].Value</li>
        </ul>
        <div class="auth-hero__cta">
            <span>@L["Auth_Register_HaveAccount"].Value</span>
            <a class="btn-outline" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Register_Back"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Register_FormTitle"].Value</h2>
            <p>@L["Auth_Register_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="Register" method="post" class="form-vertical">
            <input type="hidden" asp-for="ReturnUrl" />
            <label for="RegisterLogin">@L["Auth_Register_Login"].Value</label>
            <input asp-for="Login" id="RegisterLogin" autocomplete="username" />
            <span asp-validation-for="Login" class="val"></span>

            <label for="RegisterEmail">@L["Auth_Register_Email"].Value</label>
            <input asp-for="Email" id="RegisterEmail" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="val"></span>

            <label for="RegisterPassword">@L["Auth_Register_Password"].Value</label>
            <div class="password-field">
                <input asp-for="Password" id="RegisterPassword" type="password" autocomplete="new-password" />
                <button type="button"
                        class="password-toggle"
                        data-password-toggle="RegisterPassword"
                        data-password-show="@L["Auth_Password_Show"].Value"
                        data-password-hide="@L["Auth_Password_Hide"].Value"
                        aria-label="@L["Auth_Password_Show"].Value">
                    <span class="password-toggle__icon" aria-hidden="true">🔍</span>
                    <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                </button>
            </div>
            <span asp-validation-for="Password" class="val"></span>

            <label for="RegisterConfirm">@L["Auth_Register_ConfirmPassword"].Value</label>
            <div class="password-field">
                <input asp-for="ConfirmPassword" id="RegisterConfirm" type="password" autocomplete="new-password" />
                <button type="button"
                        class="password-toggle"
                        data-password-toggle="RegisterConfirm"
                        data-password-show="@L["Auth_Password_Show"].Value"
                        data-password-hide="@L["Auth_Password_Hide"].Value"
                        aria-label="@L["Auth_Password_Show"].Value">
                    <span class="password-toggle__icon" aria-hidden="true">🔍</span>
                    <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="val"></span>

            <button class="btn-primary" type="submit">@L["Auth_Register_Create"].Value</button>
        </form>
    </div>
</section>
