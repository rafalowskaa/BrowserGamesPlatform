@model Bgp.Web.ViewModels.RegisterVm
@using System.Linq
@using Bgp.Web.Helpers
@{
    ViewData["Title"] = L["Auth_Register_Title"].Value;

    bool HasError(string propertyName) => ViewData.ModelState.TryGetValue(propertyName, out var entry) && entry.Errors.Count > 0;
    var hasCredentialErrors = HasError(nameof(Model.Login)) || HasError(nameof(Model.Email)) || HasError(nameof(Model.Password)) || HasError(nameof(Model.ConfirmPassword));

    var showRecoveryStep = !hasCredentialErrors && (
        HasError(nameof(Model.BirthDate)) ||
        HasError(nameof(Model.SecurityQuestion1)) ||
        HasError(nameof(Model.SecurityQuestion1Custom)) ||
        HasError(nameof(Model.SecurityAnswer1)) ||
        HasError(nameof(Model.SecurityQuestion2)) ||
        HasError(nameof(Model.SecurityQuestion2Custom)) ||
        HasError(nameof(Model.SecurityAnswer2)) ||
        HasError(nameof(Model.SecurityQuestion3)) ||
        HasError(nameof(Model.SecurityQuestion3Custom)) ||
        HasError(nameof(Model.SecurityAnswer3)) ||
        !string.IsNullOrWhiteSpace(Model.Email) ||
        Model.BirthDate.HasValue ||
        !string.IsNullOrWhiteSpace(Model.SecurityQuestion1) ||
        !string.IsNullOrWhiteSpace(Model.SecurityAnswer1) ||
        !string.IsNullOrWhiteSpace(Model.SecurityQuestion2) ||
        !string.IsNullOrWhiteSpace(Model.SecurityAnswer2) ||
        !string.IsNullOrWhiteSpace(Model.SecurityQuestion3) ||
        !string.IsNullOrWhiteSpace(Model.SecurityAnswer3));

    bool showQuestion2 = !string.IsNullOrWhiteSpace(Model.SecurityQuestion2) ||
                         !string.IsNullOrWhiteSpace(Model.SecurityAnswer2) ||
                         HasError(nameof(Model.SecurityQuestion2)) ||
                         HasError(nameof(Model.SecurityQuestion2Custom)) ||
                         HasError(nameof(Model.SecurityAnswer2));

    bool showQuestion3 = !string.IsNullOrWhiteSpace(Model.SecurityQuestion3) ||
                         !string.IsNullOrWhiteSpace(Model.SecurityAnswer3) ||
                         HasError(nameof(Model.SecurityQuestion3)) ||
                         HasError(nameof(Model.SecurityQuestion3Custom)) ||
                         HasError(nameof(Model.SecurityAnswer3));

    bool question1HasError = HasError(nameof(Model.SecurityQuestion1)) || HasError(nameof(Model.SecurityQuestion1Custom)) || HasError(nameof(Model.SecurityAnswer1));
    bool question2HasError = HasError(nameof(Model.SecurityQuestion2)) || HasError(nameof(Model.SecurityQuestion2Custom)) || HasError(nameof(Model.SecurityAnswer2));
    bool question3HasError = HasError(nameof(Model.SecurityQuestion3)) || HasError(nameof(Model.SecurityQuestion3Custom)) || HasError(nameof(Model.SecurityAnswer3));

    bool ShouldShowCustom(string? key, string? customValue, string customErrorMember) =>
        string.Equals(key?.Trim(), SecurityQuestionCatalog.CustomKey, System.StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(customValue)
        || HasError(customErrorMember);

    bool showQuestion1Custom = ShouldShowCustom(Model.SecurityQuestion1, Model.SecurityQuestion1Custom, nameof(Model.SecurityQuestion1Custom));
    bool showQuestion2Custom = ShouldShowCustom(Model.SecurityQuestion2, Model.SecurityQuestion2Custom, nameof(Model.SecurityQuestion2Custom));
    bool showQuestion3Custom = ShouldShowCustom(Model.SecurityQuestion3, Model.SecurityQuestion3Custom, nameof(Model.SecurityQuestion3Custom));

    var questions = new[]
    {
        new
        {
            Index = 1,
            QuestionValue = Model.SecurityQuestion1 ?? string.Empty,
            CustomValue = Model.SecurityQuestion1Custom ?? string.Empty,
            AnswerValue = Model.SecurityAnswer1 ?? string.Empty,
            ShowCustom = showQuestion1Custom,
            HasError = question1HasError,
            HasValue = !string.IsNullOrWhiteSpace(Model.SecurityQuestion1) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityQuestion1Custom) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityAnswer1)
        },
        new
        {
            Index = 2,
            QuestionValue = Model.SecurityQuestion2 ?? string.Empty,
            CustomValue = Model.SecurityQuestion2Custom ?? string.Empty,
            AnswerValue = Model.SecurityAnswer2 ?? string.Empty,
            ShowCustom = showQuestion2Custom,
            HasError = question2HasError,
            HasValue = !string.IsNullOrWhiteSpace(Model.SecurityQuestion2) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityQuestion2Custom) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityAnswer2)
        },
        new
        {
            Index = 3,
            QuestionValue = Model.SecurityQuestion3 ?? string.Empty,
            CustomValue = Model.SecurityQuestion3Custom ?? string.Empty,
            AnswerValue = Model.SecurityAnswer3 ?? string.Empty,
            ShowCustom = showQuestion3Custom,
            HasError = question3HasError,
            HasValue = !string.IsNullOrWhiteSpace(Model.SecurityQuestion3) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityQuestion3Custom) ||
                       !string.IsNullOrWhiteSpace(Model.SecurityAnswer3)
        }
    };

    int initialCount = 0;
    for (var i = 0; i < questions.Length; i++)
    {
        var question = questions[i];
        var hasValue = question.HasValue || question.HasError;

        if (hasValue)
        {
            initialCount = i + 1;
        }
    }

    bool hasExistingQuestions = initialCount > 0;
    if (!hasExistingQuestions)
    {
        initialCount = 1;
    }

    int initialActive = -1;
    for (var i = 0; i < questions.Length; i++)
    {
        if (questions[i].HasError)
        {
            initialActive = i;
            break;
        }
    }

    if (initialActive < 0 && initialCount > 0)
    {
        initialActive = initialCount - 1;
    }
    bool initialQuestionsEnabled = hasExistingQuestions;


    var maxQuestions = questions.Length;
    int serverVisibleCount = 0;
    for (var i = 0; i < questions.Length; i++)
    {
        if (questions[i].HasValue || questions[i].HasError)
        {
            serverVisibleCount = i + 1;
        }
    }

    bool enabled = initialQuestionsEnabled || serverVisibleCount > 0;
    if (!hasExistingQuestions)
    {
        enabled = true;
    }
    int visibleCount = 0;
    if (enabled)
    {
        var maxVisible = Math.Max(Math.Max(initialCount, serverVisibleCount), 1);
        visibleCount = Math.Min(maxVisible, maxQuestions);
    }

    int activeIndex = enabled ? initialActive : -1;
    if (enabled)
    {
        if (activeIndex < 0 && serverVisibleCount > 0)
        {
            activeIndex = Math.Min(serverVisibleCount - 1, visibleCount - 1);
        }

        if (activeIndex < 0 && visibleCount > 0)
        {
            activeIndex = visibleCount - 1;
        }
    }
    else
    {
        activeIndex = -1;
    }

    bool hasActive = enabled && activeIndex >= 0 && activeIndex < visibleCount;
    bool hasAnswers = false;
    for (var i = 0; i < visibleCount; i++)
    {
        if (questions[i].HasValue)
        {
            hasAnswers = true;
            break;
        }
    }

    bool emptyHintHidden = enabled && visibleCount > 0 && (hasAnswers || hasActive);
    bool listHidden = !enabled;

    var questionStates = questions.Select((question, index) =>
    {
        var state = "hidden";
        if (enabled && index < visibleCount)
        {
            state = hasActive && index == activeIndex ? "active" : "collapsed";
        }

        if (state == "collapsed" && !question.HasValue && !question.HasError)
        {
            state = "active";
        }

        var isVisible = state != "hidden";
        var isActive = state == "active";
        var isCollapsed = state == "collapsed" && question.HasValue;
        var isComplete = isVisible && !isActive && question.HasValue;

        return new
        {
            question.Index,
            question.QuestionValue,
            question.CustomValue,
            question.AnswerValue,
            question.ShowCustom,
            question.HasError,
            question.HasValue,
            IsVisible = isVisible,
            IsActive = isActive,
            IsCollapsed = isCollapsed,
            IsComplete = isComplete,
            ShowSummary = isCollapsed,
            ShowBody = isActive
        };
    }).ToArray();

    var questionState1 = questionStates[0];
    var questionState2 = questionStates[1];
    var questionState3 = questionStates[2];

    var securityQuestionsTooltip = string.Join("\n", new[]
    {
        L["Auth_Register_SecurityQuestions_Info"].Value,
        L["Auth_SecurityQuestions_CaseInsensitiveHint"].Value
    }
        .Where(hint => !string.IsNullOrWhiteSpace(hint))
        .Select(hint => $"• {hint}"));
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
<section class="auth auth--register">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Register_Eyebrow"].Value</span>
        <h1>@L["Auth_Register_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Register_Tagline"].Value</p>
        <ul class="auth-hero__features">
            <li>@L["Auth_Register_Feature_Create"].Value</li>
            <li>@L["Auth_Register_Feature_Share"].Value</li>
            <li>@L["Auth_Register_Feature_Grow"].Value</li>
        </ul>
        <div class="auth-hero__cta">
            <span>@L["Auth_Register_HaveAccount"].Value</span>
            <a class="btn-outline" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Register_Back"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Register_FormTitle"].Value</h2>
            <p>@L["Auth_Register_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="Register" method="post" class="form-vertical" id="RegisterForm" data-register-form data-password-digit-message="@L["Auth_Register_Password_RequireDigit"].Value" data-password-mismatch-message="@L["Auth_Register_Password_Mismatch"].Value">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-step" data-step="credentials" @((showRecoveryStep ? " hidden" : string.Empty))>
                <label for="RegisterLogin">@L["Auth_Register_Login"].Value</label>
                <input asp-for="Login" id="RegisterLogin" autocomplete="username" />
                <span asp-validation-for="Login" class="val"></span>

                <div class="password-field">
                    <label for="RegisterPassword">@L["Auth_Register_Password"].Value</label>
                    <div class="password-field__input">
                        <input asp-for="Password" id="RegisterPassword" type="password" autocomplete="new-password" aria-describedby="RegisterPasswordToggleHint" />
                        <button type="button"
                                class="password-toggle"
                                data-password-toggle="RegisterPassword"
                                data-password-show="@L["Auth_Password_Show"].Value"
                                data-password-hide="@L["Auth_Password_Hide"].Value"
                                data-password-shortcut="Alt+P"
                                aria-label="@L["Auth_Password_Show"].Value"
                                tabindex="-1">
                            <span class="password-toggle__emoji" aria-hidden="true">👁️</span>
                            <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                        </button>
                    </div>
                </div>

                <span asp-validation-for="Password" class="val"></span>

                <div class="password-field">
                    <label for="RegisterConfirm">@L["Auth_Register_ConfirmPassword"].Value</label>
                    <div class="password-field__input">
                        <input asp-for="ConfirmPassword" id="RegisterConfirm" type="password" autocomplete="new-password" aria-describedby="RegisterConfirmToggleHint" />
                        <button type="button"
                                class="password-toggle"
                                data-password-toggle="RegisterConfirm"
                                data-password-show="@L["Auth_Password_Show"].Value"
                                data-password-hide="@L["Auth_Password_Hide"].Value"
                                data-password-shortcut="Alt+P"
                                aria-label="@L["Auth_Password_Show"].Value"
                                tabindex="-1">
                            <span class="password-toggle__emoji" aria-hidden="true">👁️</span>
                            <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                        </button>
                    </div>
                </div>

                <span asp-validation-for="ConfirmPassword" class="val"></span>

                <label for="RegisterEmail">@L["Auth_Register_Email"].Value</label>
                <input asp-for="Email" id="RegisterEmail" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="val"></span>

                <div class="form-step__actions">
                    <button type="button" class="btn-primary" data-register-next>@L["Auth_Register_NextStep"].Value</button>
                </div>
            </div>
            <div class="form-step" data-step="recovery" @((showRecoveryStep ? string.Empty : " hidden"))>

                <div class="birthdate-field">
                    <label for="RegisterBirthDate" class="form-label-with-hint">
                        @L["Auth_Register_BirthDate"].Value
                        <span class="form-label__optional">(@L["Common_Optional"].Value)</span>
                        <button type="button"
                                class="info-hint"
                                data-tooltip="@L["Auth_Register_BirthDate_Hint"].Value"
                                title="@L["Auth_Register_BirthDate_Hint"].Value"
                                aria-label="@L["Auth_Register_BirthDate_Hint"].Value">
                            i
                        </button>
                    </label>
                    <input asp-for="BirthDate" id="RegisterBirthDate" type="date" autocomplete="bday" />
                </div>
               
                <span asp-validation-for="BirthDate" class="val"></span>

                <div class="security-questions@(enabled ? string.Empty : " security-questions--disabled")"
                     data-security-questions
                     data-custom-option="@SecurityQuestionCatalog.CustomKey"
                     data-answer-minlength="3"
                     data-question-minlength="5"
                     data-max-questions="3"
                     data-initial-count="@initialCount"
                     data-initial-active="@activeIndex"
                     data-initial-enabled="@((enabled ? "true" : "false"))"
                     data-label-add-first="@L["Auth_Register_SecurityQuestions_AddFirst"].Value"
                     data-label-add-next="@L["Auth_Register_SecurityQuestions_AddAnother"].Value"
                     data-message-question-required="@L["Auth_Register_SecurityQuestions_SelectRequired"].Value"
                     data-message-custom-min="@L["Auth_Register_SecurityQuestions_Custom_MinLength"].Value"
                     data-message-answer-min="@L["Auth_SecurityQuestions_Answer_MinLength"].Value"
                     data-message-answer-common="@L["Auth_SecurityQuestions_Answer_Common"].Value"
                     data-message-answer-matches="@L["Auth_SecurityQuestions_Answer_MatchesQuestion"].Value">
                    <div class="security-questions__header">
                        <div class="security-questions__title">
                            <h3 class="form-label-with-hint">
                                <span>@L["Auth_Register_SecurityQuestions_Title"].Value</span>
                                <button type="button"
                                        class="info-hint"
                                        data-tooltip="@securityQuestionsTooltip"
                                        title="@securityQuestionsTooltip"
                                        aria-label="@securityQuestionsTooltip">
                                    i
                                </button>
                            </h3>
                        </div>
                        
                        <p class="security-questions__empty" data-empty-hint @((emptyHintHidden ? " hidden" : string.Empty))>@L["Auth_Register_SecurityQuestions_EmptyState"].Value</p>
                    </div>
                    <div class="security-questions__list" data-question-list @((listHidden ? " hidden" : string.Empty))>
                        <div class="security-question@(questionState1.IsActive ? " is-active" : string.Empty)@(questionState1.IsCollapsed ? " is-collapsed" : string.Empty)@(questionState1.IsComplete ? " is-complete" : string.Empty)"
                             data-question-item
                             data-question-index="1"
                             data-has-error="@(question1HasError ? "true" : "false")" @((questionState1.IsVisible ? string.Empty : " hidden"))>
                            <div class="security-question__summary" data-question-summary @((questionState1.ShowSummary ? string.Empty : " hidden"))>
                                <button type="button"
                                        class="security-question__summary-button"
                                        data-summary-edit
                                        aria-controls="SecurityQuestion1Body"
                                        aria-expanded="@((questionState1.IsActive ? "true" : "false"))">
                                    <span class="security-question__summary-question" data-summary-question>&nbsp;</span>
                                </button>
                            </div>
                            <div class="security-question__body" id="SecurityQuestion1Body" data-question-body @((questionState1.ShowBody ? string.Empty : " hidden"))>
                                <div class="security-question__fields">
                                    <div>
                                        <label for="SecurityQuestion1">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 1)</label>
                                        <select asp-for="SecurityQuestion1" id="SecurityQuestion1" data-question-select data-custom-option="@SecurityQuestionCatalog.CustomKey">
                                            <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                            @foreach (var option in Model.SecurityQuestionOptions)
                                            {
                                                if (string.Equals(option.Key, SecurityQuestionCatalog.CustomKey, System.StringComparison.Ordinal))
                                                {
                                                    continue;
                                                }

                                                <option value="@option.Key" data-allows-multiple="@(option.AllowsCustomPrompt ? "true" : "false")">@option.Label</option>
                                            }
                                            <option value="@SecurityQuestionCatalog.CustomKey" data-custom="true" data-allows-multiple="true">@L["Auth_Register_SecurityQuestions_Custom"].Value</option>

                                        </select>
                                        <span asp-validation-for="SecurityQuestion1" class="val" data-error-question></span>
                                    </div>
                                    <div class="security-question__custom-group" data-custom-container @((showQuestion1Custom ? string.Empty : " hidden"))>
                                        <label class="sr-only" for="SecurityQuestion1Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                                        <input asp-for="SecurityQuestion1Custom" id="SecurityQuestion1Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                                        <span asp-validation-for="SecurityQuestion1Custom" class="val" data-error-custom></span>
                                    </div>
                                    <div>
                                        <label class="security-question__answer" for="SecurityAnswer1">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                                        <div class="password-field password-field--answer">
                                            <div class="password-field__input">
                                                <input asp-for="SecurityAnswer1" id="SecurityAnswer1" type="text" autocomplete="off" data-answer-input minlength="3" />
                                                <button type="button"
                                                        class="password-toggle"
                                                        data-password-toggle="SecurityAnswer1"
                                                        data-password-show="@L["Auth_Password_Show"].Value"
                                                        data-password-hide="@L["Auth_Password_Hide"].Value"
                                                        data-password-default="show"
                                                        aria-label="@L["Auth_Password_Hide"].Value"
                                                        tabindex="-1">
                                                    <span class="password-toggle__emoji" aria-hidden="true">👁️</span>
                                                    <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="SecurityAnswer1" class="val" data-error-answer></span>
                                    </div>
                                </div>
                                <div class="security-question__actions">
                                    
                                    <button type="button" class="btn-link" data-question-remove @((enabled && questionState1.IsVisible ? string.Empty : " disabled aria-disabled=\"true\""))>@L["Auth_Register_SecurityQuestions_RemoveThis"].Value</button>
                                </div>
                            </div>
                        </div>


                        <div class="security-question@(questionState2.IsActive ? " is-active" : string.Empty)@(questionState2.IsCollapsed ? " is-collapsed" : string.Empty)@(questionState2.IsComplete ? " is-complete" : string.Empty)"
                             data-question-item
                             data-question-index="2"
                             data-has-error="@(question2HasError ? "true" : "false")" @((questionState2.IsVisible ? string.Empty : " hidden"))>
                            <div class="security-question__summary" data-question-summary @((questionState2.ShowSummary ? string.Empty : " hidden"))>
                                <button type="button"
                                        class="security-question__summary-button"
                                        data-summary-edit
                                        aria-controls="SecurityQuestion2Body"
                                        aria-expanded="@((questionState2.IsActive ? "true" : "false"))">
                                    <span class="security-question__summary-question" data-summary-question>&nbsp;</span>
                                </button>
                            </div>
                            <div class="security-question__body" id="SecurityQuestion2Body" data-question-body @((questionState2.ShowBody ? string.Empty : " hidden"))>
                                <div class="security-question__fields">
                                    <div>
                                        <label for="SecurityQuestion2">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 2)</label>
                                        <select asp-for="SecurityQuestion2" id="SecurityQuestion2" data-question-select data-custom-option="@SecurityQuestionCatalog.CustomKey">
                                            <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                            @foreach (var option in Model.SecurityQuestionOptions)
                                            {
                                                if (string.Equals(option.Key, SecurityQuestionCatalog.CustomKey, System.StringComparison.Ordinal))
                                                {
                                                    continue;
                                                }

                                                <option value="@option.Key" data-allows-multiple="@(option.AllowsCustomPrompt ? "true" : "false")">@option.Label</option>
                                            }
                                            <option value="@SecurityQuestionCatalog.CustomKey" data-custom="true" data-allows-multiple="true">@L["Auth_Register_SecurityQuestions_Custom"].Value</option>

                                        </select>
                                        <span asp-validation-for="SecurityQuestion2" class="val" data-error-question></span>
                                    </div>
                                    <div class="security-question__custom-group" data-custom-container @((showQuestion2Custom ? string.Empty : " hidden"))>
                                        <label class="sr-only" for="SecurityQuestion2Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                                        <input asp-for="SecurityQuestion2Custom" id="SecurityQuestion2Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                                        <span asp-validation-for="SecurityQuestion2Custom" class="val" data-error-custom></span>
                                    </div>
                                    <div>
                                        <label class="security-question__answer" for="SecurityAnswer2">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                                        <div class="password-field password-field--answer">
                                            <div class="password-field__input">
                                                <input asp-for="SecurityAnswer2" id="SecurityAnswer2" type="text" autocomplete="off" data-answer-input minlength="3" />
                                                <button type="button"
                                                        class="password-toggle"
                                                        data-password-toggle="SecurityAnswer2"
                                                        data-password-show="@L["Auth_Password_Show"].Value"
                                                        data-password-hide="@L["Auth_Password_Hide"].Value"
                                                        data-password-default="show"
                                                        aria-label="@L["Auth_Password_Hide"].Value"
                                                        tabindex="-1">
                                                    <span class="password-toggle__emoji" aria-hidden="true">👁️</span>
                                                    <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="SecurityAnswer2" class="val" data-error-answer></span>
                                    </div>
                                </div>
                                <div class="security-question__actions">
                                    
                                    <button type="button" class="btn-link" data-question-remove @((enabled && questionState2.IsVisible ? string.Empty : " disabled aria-disabled=\"true\""))>@L["Auth_Register_SecurityQuestions_RemoveThis"].Value</button>
                                </div>
                            </div>

                        </div>


                        <div class="security-question@(questionState3.IsActive ? " is-active" : string.Empty)@(questionState3.IsCollapsed ? " is-collapsed" : string.Empty)@(questionState3.IsComplete ? " is-complete" : string.Empty)"
                             data-question-item
                             data-question-index="3"
                             data-has-error="@(question3HasError ? "true" : "false")" @((questionState3.IsVisible ? string.Empty : " hidden"))>
                            <div class="security-question__summary" data-question-summary @((questionState3.ShowSummary ? string.Empty : " hidden"))>
                                <button type="button"
                                        class="security-question__summary-button"
                                        data-summary-edit
                                        aria-controls="SecurityQuestion3Body"
                                        aria-expanded="@((questionState3.IsActive ? "true" : "false"))">
                                    <span class="security-question__summary-question" data-summary-question>&nbsp;</span>
                                </button>
                            </div>
                            <div class="security-question__body" id="SecurityQuestion3Body" data-question-body @((questionState3.ShowBody ? string.Empty : " hidden"))>
                                <div class="security-question__fields">
                                    <div>
                                        <label for="SecurityQuestion3">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 3)</label>
                                        <select asp-for="SecurityQuestion3" id="SecurityQuestion3" data-question-select data-custom-option="@SecurityQuestionCatalog.CustomKey">
                                            <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                            @foreach (var option in Model.SecurityQuestionOptions)
                                            {
                                                if (string.Equals(option.Key, SecurityQuestionCatalog.CustomKey, System.StringComparison.Ordinal))
                                                {
                                                    continue;
                                                }

                                                <option value="@option.Key" data-allows-multiple="@(option.AllowsCustomPrompt ? "true" : "false")">@option.Label</option>
                                            }
                                            <option value="@SecurityQuestionCatalog.CustomKey" data-custom="true" data-allows-multiple="true">@L["Auth_Register_SecurityQuestions_Custom"].Value</option>

                                        </select>
                                        <span asp-validation-for="SecurityQuestion3" class="val" data-error-question></span>
                                    </div>
                                    <div class="security-question__custom-group" data-custom-container @((showQuestion3Custom ? string.Empty : " hidden"))>
                                        <label class="sr-only" for="SecurityQuestion3Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                                        <input asp-for="SecurityQuestion3Custom" id="SecurityQuestion3Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                                        <span asp-validation-for="SecurityQuestion3Custom" class="val" data-error-custom></span>
                                    </div>
                                    <div>
                                        <label class="security-question__answer" for="SecurityAnswer3">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                                        <div class="password-field password-field--answer">
                                            <div class="password-field__input">
                                                <input asp-for="SecurityAnswer3" id="SecurityAnswer3" type="text" autocomplete="off" data-answer-input minlength="3" />
                                                <button type="button"
                                                        class="password-toggle"
                                                        data-password-toggle="SecurityAnswer3"
                                                        data-password-show="@L["Auth_Password_Show"].Value"
                                                        data-password-hide="@L["Auth_Password_Hide"].Value"
                                                        data-password-default="show"
                                                        aria-label="@L["Auth_Password_Hide"].Value"
                                                        tabindex="-1">
                                                    <span class="password-toggle__emoji" aria-hidden="true">👁️</span>
                                                    <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                                                </button>
                                            </div>
                                        </div>
                                        <span asp-validation-for="SecurityAnswer3" class="val" data-error-answer></span>
                                    </div>
                                </div>
                                <div class="security-question__actions">

                                    <button type="button" class="btn-link" data-question-remove @((enabled && questionState3.IsVisible ? string.Empty : " disabled aria-disabled=\"true\""))>@L["Auth_Register_SecurityQuestions_RemoveThis"].Value</button>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="security-questions__actions">
                        <button type="button" class="btn-primary" data-questions-add>@(initialQuestionsEnabled? L["Auth_Register_SecurityQuestions_AddAnother"].Value : L["Auth_Register_SecurityQuestions_AddFirst"].Value)</button>
                    </div>
                </div>

                <div class="form-step__actions">
                    <button type="button" class="btn-outline" data-register-back>@L["Auth_Register_PreviousStep"].Value</button>
                    <button class="btn-primary" type="submit">@L["Auth_Register_Create"].Value</button>
                </div>
            </div>


        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-register-form]');
            if (!form) {
                return;
            }

            const passwordInput = form.querySelector('#RegisterPassword');
            const confirmInput = form.querySelector('#RegisterConfirm');
            const passwordDigitMessage = form.getAttribute('data-password-digit-message') || '';
            const passwordMismatchMessage = form.getAttribute('data-password-mismatch-message') || '';

            if (passwordInput) {
                passwordInput.addEventListener('input', () => {
                    passwordInput.setCustomValidity('');
                });
            }

            if (confirmInput) {
                confirmInput.addEventListener('input', () => {
                    confirmInput.setCustomValidity('');
                });
            }


            const steps = {
                credentials: form.querySelector('[data-step="credentials"]'),
                recovery: form.querySelector('[data-step="recovery"]')
            };

            const switchToStep = (stepKey) => {
                const entries = Object.entries(steps);
                for (const [key, element] of entries) {
                    if (!element) {
                        continue;
                    }
                    element.hidden = key !== stepKey;
                }
            };

            const nextButton = form.querySelector('[data-register-next]');
            if (nextButton) {
                nextButton.addEventListener('click', () => {
                    const credentialsStep = steps.credentials;
                    if (!credentialsStep) {
                        return;
                    }

                    if (passwordInput) {
                        if (!/\d/.test(passwordInput.value || '')) {
                            passwordInput.setCustomValidity(passwordDigitMessage);
                        } else {
                            passwordInput.setCustomValidity('');
                        }
                    }

                    if (confirmInput) {
                        if (passwordInput && (confirmInput.value || '') !== (passwordInput.value || '')) {
                            confirmInput.setCustomValidity(passwordMismatchMessage);
                        } else {
                            confirmInput.setCustomValidity('');
                        }
                    }


                    const inputs = Array.from(credentialsStep.querySelectorAll('input'))
                        .filter(input => input.type !== 'hidden' && !input.disabled);

                    for (const input of inputs) {
                        if (!input.reportValidity()) {
                            input.focus();
                            return;
                        }
                    }

                    switchToStep('recovery');

                    const firstRecoveryField = steps.recovery?.querySelector('input, select');
                    if (firstRecoveryField) {
                        firstRecoveryField.focus();
                    }
                });
            }

            const backButton = form.querySelector('[data-register-back]');
            if (backButton) {
                backButton.addEventListener('click', () => {
                    switchToStep('credentials');
                    const firstCredentialField = steps.credentials?.querySelector('input');
                    if (firstCredentialField) {
                        firstCredentialField.focus();
                    }
                });
            }

            const questionsContainer = form.querySelector('[data-security-questions]');
            if (questionsContainer && window.Bgp && typeof window.Bgp.initSecurityQuestions === 'function') {
                window.Bgp.initSecurityQuestions(questionsContainer);
            }
        })();
    </script>
}
