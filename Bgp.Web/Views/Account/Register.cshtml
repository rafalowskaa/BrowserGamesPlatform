@model Bgp.Web.Controllers.RegisterVm
@{
    ViewData["Title"] = L["Auth_Register_Title"].Value;
}
<section class="auth auth--register">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Register_Eyebrow"].Value</span>
        <h1>@L["Auth_Register_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Register_Tagline"].Value</p>
        <ul class="auth-hero__features">
            <li>@L["Auth_Register_Feature_Create"].Value</li>
            <li>@L["Auth_Register_Feature_Share"].Value</li>
            <li>@L["Auth_Register_Feature_Grow"].Value</li>
        </ul>
        <div class="auth-hero__cta">
            <span>@L["Auth_Register_HaveAccount"].Value</span>
            <a class="btn-outline" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Register_Back"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Register_FormTitle"].Value</h2>
            <p>@L["Auth_Register_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="Register" method="post" class="form-vertical">
            <input type="hidden" asp-for="ReturnUrl" />
            <label for="RegisterLogin">@L["Auth_Register_Login"].Value</label>
            <input asp-for="Login" id="RegisterLogin" autocomplete="username" />
            <span asp-validation-for="Login" class="val"></span>

            <label for="RegisterEmail">@L["Auth_Register_Email"].Value</label>
            <input asp-for="Email" id="RegisterEmail" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="val"></span>

            <label for="RegisterBirthDate">@L["Auth_Register_BirthDate"].Value</label>
            <input asp-for="BirthDate" id="RegisterBirthDate" type="date" autocomplete="bday" />
            <span class="form-hint">@L["Auth_Register_BirthDate_Hint"].Value</span>
            <span asp-validation-for="BirthDate" class="val"></span>

            <div class="password-field">
                <label for="RegisterPassword">@L["Auth_Register_Password"].Value</label>
                <div class="password-field__input">
                    <input asp-for="Password" id="RegisterPassword" type="password" autocomplete="new-password" aria-describedby="RegisterPasswordToggleHint" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle="RegisterPassword"
                            data-password-show="@L["Auth_Password_Show"].Value"
                            data-password-hide="@L["Auth_Password_Hide"].Value"
                            data-password-shortcut="Alt+P"
                            aria-label="@L["Auth_Password_Show"].Value"
                            tabindex="-1">
                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <g class="password-toggle__icon-eye">
                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </g>
                            <g class="password-toggle__icon-eye-off">
                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                <path d="M15 12a3 3 0 00-3-3" />
                                <path d="M3 3l18 18" />
                            </g>
                        </svg>
                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                    </button>
                </div>
                
            </div>
            <span asp-validation-for="Password" class="val"></span>

            
            <div class="password-field">
                <label for="RegisterConfirm">@L["Auth_Register_ConfirmPassword"].Value</label>
                <div class="password-field__input">
                    <input asp-for="ConfirmPassword" id="RegisterConfirm" type="password" autocomplete="new-password" aria-describedby="RegisterConfirmToggleHint" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle="RegisterConfirm"
                            data-password-show="@L["Auth_Password_Show"].Value"
                            data-password-hide="@L["Auth_Password_Hide"].Value"
                            data-password-shortcut="Alt+P"
                            aria-label="@L["Auth_Password_Show"].Value"
                            tabindex="-1">
                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <g class="password-toggle__icon-eye">
                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </g>
                            <g class="password-toggle__icon-eye-off">
                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                <path d="M15 12a3 3 0 00-3-3" />
                                <path d="M3 3l18 18" />
                            </g>
                        </svg>
                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                    </button>
                </div>
                
            </div>
            <span asp-validation-for="ConfirmPassword" class="val"></span>

            <div class="security-questions">
                <h3>@L["Auth_Register_SecurityQuestions_Title"].Value</h3>
                <p class="form-hint">@L["Auth_Register_SecurityQuestions_Description"].Value</p>

                <div class="security-question">
                    <label for="SecurityQuestion1">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 1)</label>
                    <select asp-for="SecurityQuestion1" id="SecurityQuestion1">
                        <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                        @foreach (var option in Model.SecurityQuestionOptions)
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span asp-validation-for="SecurityQuestion1" class="val"></span>
                    <label class="security-question__custom" for="SecurityQuestion1Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                    <input asp-for="SecurityQuestion1Custom" id="SecurityQuestion1Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                    <span asp-validation-for="SecurityQuestion1Custom" class="val"></span>
                    <label class="security-question__answer" for="SecurityAnswer1">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                    <input asp-for="SecurityAnswer1" id="SecurityAnswer1" type="password" autocomplete="off" />
                    <span asp-validation-for="SecurityAnswer1" class="val"></span>
                </div>

                <div class="security-question">
                    <label for="SecurityQuestion2">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 2)</label>
                    <select asp-for="SecurityQuestion2" id="SecurityQuestion2">
                        <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                        @foreach (var option in Model.SecurityQuestionOptions)
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span asp-validation-for="SecurityQuestion2" class="val"></span>
                    <label class="security-question__custom" for="SecurityQuestion2Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                    <input asp-for="SecurityQuestion2Custom" id="SecurityQuestion2Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                    <span asp-validation-for="SecurityQuestion2Custom" class="val"></span>
                    <label class="security-question__answer" for="SecurityAnswer2">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                    <input asp-for="SecurityAnswer2" id="SecurityAnswer2" type="password" autocomplete="off" />
                    <span asp-validation-for="SecurityAnswer2" class="val"></span>
                </div>

                <div class="security-question">
                    <label for="SecurityQuestion3">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 3)</label>
                    <select asp-for="SecurityQuestion3" id="SecurityQuestion3">
                        <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                        @foreach (var option in Model.SecurityQuestionOptions)
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span asp-validation-for="SecurityQuestion3" class="val"></span>
                    <label class="security-question__custom" for="SecurityQuestion3Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                    <input asp-for="SecurityQuestion3Custom" id="SecurityQuestion3Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                    <span asp-validation-for="SecurityQuestion3Custom" class="val"></span>
                    <label class="security-question__answer" for="SecurityAnswer3">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                    <input asp-for="SecurityAnswer3" id="SecurityAnswer3" type="password" autocomplete="off" />
                    <span asp-validation-for="SecurityAnswer3" class="val"></span>
                </div>
            </div>

            <button class="btn-primary" type="submit">@L["Auth_Register_Create"].Value</button>
        </form>
    </div>
</section>
