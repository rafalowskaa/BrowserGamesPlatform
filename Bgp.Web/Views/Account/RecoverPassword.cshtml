@model Bgp.Web.Controllers.RecoverPasswordVm
@{
    ViewData["Title"] = L["Auth_Recover_Title"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
<section class="auth auth--recover">
    <div class="auth-hero">
        <span class="eyebrow">@L["Auth_Recover_Eyebrow"].Value</span>
        <h1>@L["Auth_Recover_Heading"].Value</h1>
        <p class="auth-hero__lead">@L["Auth_Recover_Lead"].Value</p>
        <div class="auth-hero__cta">
            <span>@L["Auth_Recover_Remembered"].Value</span>
            <a class="btn-outline" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Recover_Back"].Value</a>
        </div>
    </div>
    <div class="auth-card">
        <div class="auth-card__header">
            <h2>@L["Auth_Recover_FormTitle"].Value</h2>
            <p>@L["Auth_Recover_FormSubtitle"].Value</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="val-summary"></div>
        <form asp-action="RecoverPassword" method="post" class="form-vertical">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="LoginOrEmail" />
            <input type="hidden" asp-for="ReturnUrl" />

            @if (Model.Questions.Any())
            {
                <div class="security-questions" data-security-questions data-sequential="false">
                    <div class="form-hint form-hint--muted">@L["Auth_SecurityQuestions_CaseInsensitiveHint"].Value</div>

                    @for (var i = 0; i < Model.Questions.Count; i++)
                    {
                        var answerId = $"RecoverAnswer{i + 1}";
                        <div class="security-question">
                            <input type="hidden" asp-for="Questions[i].Key" />
                            <input type="hidden" asp-for="Questions[i].Prompt" />
                            <label asp-for="Questions[i].Answer">@Model.Questions[i].Prompt</label>
                            <div class="password-field password-field--answer">
                                <div class="password-field__input">
                                    <input asp-for="Questions[i].Answer" id="@answerId" type="text" autocomplete="off" data-answer-input />
                                    <button type="button"
                                            class="password-toggle"
                                            data-password-toggle="@answerId"
                                            data-password-show="@L["Auth_Password_Show"].Value"
                                            data-password-hide="@L["Auth_Password_Hide"].Value"
                                            data-password-default="show"
                                            aria-label="@L["Auth_Password_Hide"].Value"
                                            tabindex="-1">
                                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <g class="password-toggle__icon-eye">
                                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </g>
                                            <g class="password-toggle__icon-eye-off">
                                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                                <path d="M15 12a3 3 0 00-3-3" />
                                                <path d="M3 3l18 18" />
                                            </g>
                                        </svg>
                                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                                    </button>
                                </div>
                            </div>
                            <span asp-validation-for="Questions[i].Answer" class="val"></span>
                        </div>
                    }
                </div>
            }

            <div class="password-field">
                <label for="RecoverNewPassword">@L["Auth_Recover_NewPassword"].Value</label>
                <div class="password-field__input">
                    <input asp-for="NewPassword" id="RecoverNewPassword" type="password" autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle="RecoverNewPassword"
                            data-password-show="@L["Auth_Password_Show"].Value"
                            data-password-hide="@L["Auth_Password_Hide"].Value"
                            data-password-shortcut="Alt+P"
                            aria-label="@L["Auth_Password_Show"].Value"
                            tabindex="-1">
                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <g class="password-toggle__icon-eye">
                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </g>
                            <g class="password-toggle__icon-eye-off">
                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                <path d="M15 12a3 3 0 00-3-3" />
                                <path d="M3 3l18 18" />
                            </g>
                        </svg>
                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                    </button>
                </div>
            </div>
            <span asp-validation-for="NewPassword" class="val"></span>

            <div class="password-field">
                <label for="RecoverConfirmPassword">@L["Auth_Recover_ConfirmPassword"].Value</label>
                <div class="password-field__input">
                    <input asp-for="ConfirmPassword" id="RecoverConfirmPassword" type="password" autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle="RecoverConfirmPassword"
                            data-password-show="@L["Auth_Password_Show"].Value"
                            data-password-hide="@L["Auth_Password_Hide"].Value"
                            data-password-shortcut="Alt+P"
                            aria-label="@L["Auth_Password_Show"].Value"
                            tabindex="-1">
                        <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <g class="password-toggle__icon-eye">
                                <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </g>
                            <g class="password-toggle__icon-eye-off">
                                <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                <path d="M15 12a3 3 0 00-3-3" />
                                <path d="M3 3l18 18" />
                            </g>
                        </svg>
                        <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                    </button>
                </div>
            </div>
            <span asp-validation-for="ConfirmPassword" class="val"></span>

            <button class="btn-primary" type="submit">@L["Auth_Recover_Submit"].Value</button>
        </form>
    </div>
</section>