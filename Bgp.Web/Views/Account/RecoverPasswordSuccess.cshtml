@model Bgp.Web.Controllers.RecoverPasswordSuccessVm
@{
    ViewData["Title"] = L["Auth_Recover_Success_Title"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
<section class="auth auth--recover-success">
    <div class="auth-card auth-card--centered">
        <div class="auth-card__header">
            <h1>@L["Auth_Recover_Success_Heading"].Value</h1>
            <p>@string.Format(L["Auth_Recover_Success_Message"].Value, Model.LoginOrEmail)</p>
        </div>
        <a class="btn-primary" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L["Auth_Recover_Success_Login"].Value</a>
    </div>
</section>