﻿@using System.Globalization
@using System.Linq
@using System.Text.Json
@using Bgp.Domain.Enums
@using Bgp.Web.Models
@model DashboardViewModel
@{
    ViewData["Title"] = L["Dashboard_Title"].Value;
    var activeTab = (ViewData["ActiveTab"] as string ?? "overview").ToLowerInvariant();
    var successKey = TempData["DashboardSuccess"] as string;
    var successMessage = successKey switch
    {
        "ProfileUpdated" => L["Dashboard_Success_Profile"].Value,
        "EmailUpdated" => L["Dashboard_Success_Email"].Value,
        "PasswordUpdated" => L["Dashboard_Success_Password"].Value,
        "RecoveryUpdated" => L["Dashboard_Success_Recovery"].Value,
        "GameCreated" => L["Dashboard_Success_Game"].Value,
        "DisplayNameRequested" => L["Dashboard_Success_DisplayNameRequested"].Value,
        _ => null
    };
    var includeProfileScripts = false;
    var includeOverviewScripts = false;
    var includeGamesScripts = false;

    string StatusClass(GameApprovalStatus status) => status switch
    {
        GameApprovalStatus.Approved => "status-approved",
        GameApprovalStatus.Rejected => "status-rejected",
        _ => "status-pending"
    };
    string StatusLabel(GameApprovalStatus status) => status switch
    {
        GameApprovalStatus.Approved => L["Dashboard_Games_Status_Approved"].Value,
        GameApprovalStatus.Rejected => L["Dashboard_Games_Status_Rejected"].Value,
        _ => L["Dashboard_Games_Status_Pending"].Value
    };
}

<section class="dashboard">
    <header class="dashboard-header">
        <div>
            <h1>@L["Dashboard_Title"].Value</h1>
            <p>@L["Dashboard_Overview_Description"].Value</p>
        </div>
    </header>

    <nav class="dashboard-nav">
        <a class="dashboard-nav__item@(activeTab == "overview" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="overview">@L["Dashboard_Overview_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "profile" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="profile">@L["Dashboard_Profile_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "stats" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="stats">@L["Dashboard_Stats_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "games" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="games">@L["Dashboard_Games_AddTab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "friends" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="friends">@L["Dashboard_Friends_Tab"].Value</a>
    </nav>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert success">@successMessage</div>
    }

    @switch (activeTab)
    {
        case "profile":
            includeProfileScripts = true;
            var selectedProfilePanel = (ViewData["ProfilePanel"] as string ?? "info").ToLowerInvariant();
            if (selectedProfilePanel == "email" || selectedProfilePanel == "password")
            {
                selectedProfilePanel = "security";
            }
            <section class="dashboard-panel profile-panel">
                @{
                    var rank = Model.Profile.Rank;
                    var nextAccentColor = rank.NextAccentColor ?? rank.AccentColor;
                    var nextAccentHighlight = rank.NextAccentHighlightColor ?? rank.AccentHighlightColor;
                    var nextAccentGlow = rank.NextAccentGlowColor ?? rank.AccentGlowColor;
                }
                <div class="profile-hero">
                    <div class="profile-hero__trophy profile-hero__trophy--left" style="--trophy-color:@rank.AccentColor; --trophy-highlight:@rank.AccentHighlightColor; --trophy-glow:@rank.AccentGlowColor;">
                        @if (!string.IsNullOrEmpty(rank.TrophyImage))
                        {
                            <img src="@rank.TrophyImage" alt="@rank.DisplayName" class="profile-hero__trophy-image" />
                        }
                        <span>@rank.DisplayName</span>
                    </div>
                    <div class="profile-hero__center">
                        <div class="profile-avatar-frame">
                            @if (!string.IsNullOrEmpty(Model.Profile.AvatarUrl))
                            {
                                <img src="@Model.Profile.AvatarUrl" alt="avatar" class="profile-avatar-frame__image" />
                            }
                            else
                            {
                                <span class="profile-avatar-frame__placeholder">@L["Dashboard_Profile_NoAvatar"].Value</span>
                            }
                        </div>
                        <div class="profile-hero__identity">
                            <h2 class="profile-hero__name">@Model.Profile.DisplayName</h2>
                            <span class="profile-hero__rank-badge" style="--rank-color:@rank.AccentColor; --rank-highlight:@rank.AccentHighlightColor; --rank-glow:@rank.AccentGlowColor;">
                                <span>@rank.DisplayName</span>
                            </span>
                        </div>
                        @if (Model.Profile.IsBirthdayToday)
                        {
                             <span class="profile-hero__birthday">@L["Dashboard_Profile_Birthday_Today"].Value</span>
                        }
                        <div class="profile-progress" style="--rank-accent:@rank.AccentColor; --rank-highlight:@rank.AccentHighlightColor; --rank-glow:@rank.AccentGlowColor;">
                            <div class="profile-progress__track">
                                <div class="profile-progress__fill" style="width:@Model.Profile.Rank.ProgressPercent%"></div>
                            </div>
                            <div class="profile-progress__meta">
                                <span>@string.Format(L["Dashboard_Profile_Rank_ProgressLabel"].Value, Model.Profile.Rank.XpIntoCurrent, Model.Profile.Rank.XpRequiredForNext)</span>
                                <span>@string.Format(L["Dashboard_Profile_Rank_TotalXp"].Value, Model.Profile.Rank.ExperiencePoints)</span>
                            </div>
                            
                        </div>
                        
                    </div>
                    <div class="profile-hero__trophy profile-hero__trophy--right" style="--trophy-color:@nextAccentColor; --trophy-highlight:@nextAccentHighlight; --trophy-glow:@nextAccentGlow;">
                        @if (!string.IsNullOrEmpty(rank.NextTrophyImage))
                        {
                            <img src="@rank.NextTrophyImage" alt="@(rank.NextDisplayName ?? L["Dashboard_Profile_Rank_Max"].Value)" class="profile-hero__trophy-image" />
                        }
                        else if (!string.IsNullOrEmpty(rank.TrophyImage))
                        {
                            <img src="@rank.TrophyImage" alt="@rank.DisplayName" class="profile-hero__trophy-image profile-hero__trophy-image--muted" />
                        }
                        <span>@(rank.NextDisplayName ?? L["Dashboard_Profile_Rank_Max"].Value)</span>
                    </div>
                </div>

                <div class="profile-highlights">
                    @foreach (var highlight in Model.Profile.Highlights.Take(4))
                    {
                        <article class="profile-highlight">
                            <h3>@highlight.Title</h3>
                            <p>@highlight.Description</p>
                        </article>
                    }
                </div>

                <div class="profile-actions">
                    <div class="profile-actions__menu">
                        <label for="profileAction">@L["Dashboard_Profile_Actions_Label"].Value</label>
                        <select id="profileAction" class="profile-actions__select" data-default="@selectedProfilePanel">
                            <option value="info" selected="@(selectedProfilePanel == "info" ? "selected" : null)">@L["Dashboard_Profile_Actions_EditInfo"].Value</option>
                            <option value="security" selected="@(selectedProfilePanel == "security" ? "selected" : null)">@L["Dashboard_Profile_Actions_Security"].Value</option>
                        </select>
                    </div>

                    <div class="profile-actions__panel is-active" data-action="info">
                        <h3>@L["Dashboard_Profile_UpdateTitle"].Value</h3>
                        <p>@L["Dashboard_Profile_UpdateDescription"].Value</p>
                        @{
                            var months = Enumerable.Range(1, 12)
                            .Select(i => new { Value = i, Name = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames[i - 1] })
                            .Select(m => new { m.Value, Name = string.IsNullOrWhiteSpace(m.Name) ? m.Value.ToString("00") : m.Name })
                            .ToList();
                            var days = Enumerable.Range(1, 31).ToList();
                            var hasPendingDisplayName = !string.IsNullOrWhiteSpace(Model.Profile.PendingDisplayName);
                            var changeAvailableAt = Model.Profile.DisplayNameChangeAvailableAtUtc;
                            var canRequestDisplayNameChange = !hasPendingDisplayName && (!changeAvailableAt.HasValue || changeAvailableAt.Value <= DateTime.UtcNow);
                            var displayNameBlockedMessage = changeAvailableAt.HasValue
                            ? string.Format(L["Dashboard_Profile_DisplayName_ConfirmBlocked"].Value, changeAvailableAt.Value.ToLocalTime().ToString("f"))
                            : L["Dashboard_Profile_DisplayName_ConfirmBlocked_Generic"].Value;
                            var displayNameLocked = hasPendingDisplayName || !canRequestDisplayNameChange;
                            var displayNameActionTitle = displayNameLocked ? displayNameBlockedMessage : null;
                        }
                        <form asp-action="UpdateProfile"
                              method="post"
                              enctype="multipart/form-data"
                              class="profile-form"
                              data-display-name-can-request="@(canRequestDisplayNameChange ? "true" : "false")"
                              data-display-name-pending="@(hasPendingDisplayName ? "true" : "false")"
                              data-display-name-blocked-message="@displayNameBlockedMessage">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, null, new { @class = "val-summary" })
                            <div class="profile-field">
                                <div class="profile-field__input">
                                    <label for="DisplayName">@L["Dashboard_Profile_DisplayName"].Value</label>
                                    <input id="DisplayName" name="DisplayName" value="@Model.Profile.DisplayName" maxlength="120" data-current-name="@Model.Profile.DisplayName" />
                                    @if (hasPendingDisplayName)
                                    {
                                        <div class="form-hint form-hint--warning">@string.Format(L["Dashboard_Profile_DisplayName_PendingInfo"].Value, Model.Profile.PendingDisplayName, Model.Profile.PendingDisplayNameRequestedAtUtc?.ToLocalTime().ToString("g"))</div>
                                    }
                                    @Html.ValidationMessage("DisplayName", null, new { @class = "val" })
                                    @Html.ValidationMessage("DisplayNamePassword", null, new { @class = "val" })
                                    <input type="hidden" id="DisplayNamePasswordField" name="DisplayNamePassword" />
                                </div>
                                <div class="profile-field__actions">
                                    <button class="btn-primary btn-compact" type="submit" name="submitAction" value="displayName" @(displayNameLocked ? "disabled" : null) title="@(displayNameActionTitle ?? string.Empty)">@L["Dashboard_Profile_ApplyChange"].Value</button>
                                </div>
                                <div class="profile-field__visibility">
                                    <label for="DisplayNameVisibility">@L["Dashboard_Profile_DisplayNameVisibility"].Value</label>
                                    <select id="DisplayNameVisibility" name="DisplayNameVisibility">
                                        @foreach (var option in Model.Profile.VisibilityOptions)
                                        {
                                            var isSelected = option.Value == ((int)Model.Profile.DisplayNameVisibility).ToString();
                                            <option value="@option.Value" selected="@(isSelected ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>


                            <div class="profile-field">
                                <div class="profile-field__input">

                                    <label>@L["Dashboard_Profile_BirthDate"].Value</label>
                                    <div class="birthdate-picker">
                                        <select id="BirthMonth" name="BirthMonth">
                                            <option value="">@L["Dashboard_Profile_BirthDate_MonthPlaceholder"].Value</option>
                                            @foreach (var month in months)
                                            {
                                                var selected = month.Value == Model.Profile.BirthMonth ? "selected" : null;
                                                <option value="@month.Value" selected="@selected">@month.Name</option>
                                            }
                                        </select>
                                        <select id="BirthDay" name="BirthDay">
                                            <option value="">@L["Dashboard_Profile_BirthDate_DayPlaceholder"].Value</option>
                                            @foreach (var day in days)
                                            {
                                                var selected = day == Model.Profile.BirthDay ? "selected" : null;
                                                <option value="@day" selected="@selected">@day.ToString("00")</option>
                                            }
                                        </select>
                                    </div>
                                    @Html.ValidationMessage("BirthMonth", null, new { @class = "val" })
                                    @Html.ValidationMessage("BirthDay", null, new { @class = "val" })
                                </div>
                                <div class="profile-field__actions">
                                    <button class="btn-primary btn-compact" type="submit" name="submitAction" value="birthDate">@L["Dashboard_Profile_ApplyChange"].Value</button>
                                </div>
                                <div class="profile-field__visibility">
                                    <label for="BirthDateVisibility">@L["Dashboard_Profile_BirthDateVisibility"].Value</label>
                                    <select id="BirthDateVisibility" name="BirthDateVisibility">
                                        @foreach (var option in Model.Profile.VisibilityOptions)
                                        {
                                            var isSelected = option.Value == ((int)Model.Profile.BirthDateVisibility).ToString();
                                            <option value="@option.Value" selected="@(isSelected ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="profile-field">
                                <div class="profile-field__input">
                                    <label>@L["Dashboard_Profile_EmailLabel"].Value</label>
                                    <div class="profile-field__static">@Model.Profile.Email</div>
                                </div>
                                <div class="profile-field__actions">
                                    <button class="btn-primary btn-compact" type="submit" name="submitAction" value="emailVisibility">@L["Dashboard_Profile_ApplyChange"].Value</button>
                                </div>
                                <div class="profile-field__visibility">
                                    <label for="EmailVisibility">@L["Dashboard_Profile_EmailVisibility"].Value</label>
                                    <select id="EmailVisibility" name="EmailVisibility">
                                        @foreach (var option in Model.Profile.VisibilityOptions)
                                        {
                                            var isSelected = option.Value == ((int)Model.Profile.EmailVisibility).ToString();
                                            <option value="@option.Value" selected="@(isSelected ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="profile-field">
                                <div class="profile-field__input">
                                    <label for="Avatar">@L["Dashboard_Profile_Avatar"].Value</label>
                                    <div class="file-upload avatar-upload">
                                        <input id="Avatar" type="file" name="Avatar" accept="image/*" class="file-upload__input" />
                                        <label for="Avatar" class="btn-outline btn-compact file-upload__button" data-file-trigger>@L["Dashboard_Common_SelectFile"].Value</label>
                                        <span class="file-upload__meta" data-file-name data-placeholder="@L["Dashboard_Common_NoFile"].Value">@L["Dashboard_Common_NoFile"].Value</span>
                                        <div class="file-upload__tooltip" id="avatarTooltip" role="status">@L["Dashboard_Profile_Avatar_Hint"].Value</div>
                                    </div>
                                    @Html.ValidationMessage("Avatar", null, new { @class = "val" })
                                </div>
                                <div class="profile-field__actions">
                                    <button class="btn-primary btn-compact" type="submit" name="submitAction" value="avatar">@L["Dashboard_Profile_ApplyChange"].Value</button>
                                </div>
                                <div class="profile-field__visibility profile-field__visibility--empty"></div>
                            </div>
                        </form>
                        <div class="modal-backdrop" id="displayNameConfirmModal" hidden
                             data-confirm-message="@L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value"
                             data-blocked-message="@displayNameBlockedMessage"
                             data-agreement-error="@L["Dashboard_Profile_DisplayName_ConfirmAgreementError"].Value"
                             data-password-error="@L["Dashboard_Profile_DisplayName_ConfirmPasswordError"].Value">
                            <div class="modal-backdrop__overlay" data-modal-close></div>
                            <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="displayNameConfirmTitle">
                                <div class="modal-dialog__content">
                                    <h3 id="displayNameConfirmTitle">@L["Dashboard_Profile_DisplayName_ConfirmTitle"].Value</h3>
                                    <p class="modal-dialog__message" data-modal-message>@L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value</p>
                                    <p class="modal-dialog__warning" data-modal-warning hidden></p>
                                    <div class="modal-dialog__control" data-modal-agreement>
                                        <label class="checkbox">
                                            <input type="checkbox" id="displayNameConfirmAgree" />
                                            <span>@L["Dashboard_Profile_DisplayName_ConfirmAgreement"].Value</span>
                                        </label>
                                    </div>
                                    <div class="modal-dialog__control" data-modal-password>
                                        <label class="modal-dialog__label" for="displayNameConfirmPassword">@L["Dashboard_Profile_DisplayName_ConfirmPasswordLabel"].Value</label>
                                        <input type="password" id="displayNameConfirmPassword" class="modal-dialog__input" autocomplete="current-password" />
                                    </div>
                                    <div class="modal-dialog__actions">
                                        <button type="button" class="btn-outline btn-compact" data-modal-close>@L["Dashboard_Profile_DisplayName_ConfirmCancel"].Value</button>
                                        <button type="button" class="btn-primary btn-compact" data-modal-confirm>@L["Dashboard_Profile_DisplayName_ConfirmAccept"].Value</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="profile-actions__panel" data-action="security">
                        @{
                            bool RecoveryHasError(string key) => ViewData.ModelState.TryGetValue(key, out var state) && state.Errors.Count > 0;
                            var recoveryOptions = Model.Security.Recovery.SecurityQuestionOptions;
                            var recoveryQuestion1Option = recoveryOptions.FirstOrDefault(option => option.Key == Model.Security.Recovery.SecurityQuestion1);
                            var recoveryQuestion2Option = recoveryOptions.FirstOrDefault(option => option.Key == Model.Security.Recovery.SecurityQuestion2);
                            var recoveryQuestion3Option = recoveryOptions.FirstOrDefault(option => option.Key == Model.Security.Recovery.SecurityQuestion3);
                            var showRecoveryQuestion1Custom = (recoveryQuestion1Option?.AllowsCustomPrompt ?? false) || RecoveryHasError(nameof(UpdateRecoveryQuestionsInputModel.SecurityQuestion1Custom));
                            var showRecoveryQuestion2Custom = (recoveryQuestion2Option?.AllowsCustomPrompt ?? false) || RecoveryHasError(nameof(UpdateRecoveryQuestionsInputModel.SecurityQuestion2Custom));
                            var showRecoveryQuestion3Custom = (recoveryQuestion3Option?.AllowsCustomPrompt ?? false) || RecoveryHasError(nameof(UpdateRecoveryQuestionsInputModel.SecurityQuestion3Custom));
                        }
                        <div class="profile-security-grid profile-security-grid--split">
                            <div class="profile-security-grid__column">
                                <div class="profile-security-grid__item">
                                    <h3>@L["Dashboard_Profile_EmailTitle"].Value</h3>
                                    <p>@string.Format(L["Dashboard_Profile_EmailDescription"].Value, Model.Security.Email)</p>
                                    <form asp-action="UpdateEmail" method="post" class="profile-form">
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                                        <label for="Email">@L["Dashboard_Security_Email"].Value</label>
                                        <input id="Email" name="Email" type="email" value="@Model.Security.Email" autocomplete="email" />
                                        @Html.ValidationMessage("Email", null, new { @class = "val" })

                                        <label for="EmailPassword">@L["Dashboard_Security_EmailPassword"].Value</label>
                                        <input id="EmailPassword" name="Password" type="password" autocomplete="current-password" />
                                        @Html.ValidationMessage("Password", null, new { @class = "val" })

                                        <button class="btn-primary btn-compact" type="submit">@L["Dashboard_Security_SaveEmail"].Value</button>
                                    </form>
                                </div>
                                <div class="profile-security-grid__item">
                                    <h3>@L["Dashboard_Profile_PasswordTitle"].Value</h3>
                                    <p>@L["Dashboard_Profile_PasswordDescription"].Value</p>
                                    <form asp-action="ChangePassword" method="post" class="profile-form">
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                                        <label for="CurrentPassword">@L["Dashboard_Security_CurrentPassword"].Value</label>
                                        <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" />
                                        @Html.ValidationMessage("CurrentPassword", null, new { @class = "val" })

                                        <label for="NewPassword">@L["Dashboard_Security_NewPassword"].Value</label>
                                        <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" />
                                        @Html.ValidationMessage("NewPassword", null, new { @class = "val" })

                                        <label for="ConfirmPassword">@L["Dashboard_Security_ConfirmPassword"].Value</label>
                                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" />
                                        @Html.ValidationMessage("ConfirmPassword", null, new { @class = "val" })

                                        <button class="btn-primary btn-compact" type="submit">@L["Dashboard_Security_ChangePassword"].Value</button>
                                    </form>
                                </div>
                            </div>
                            <div class="profile-security-grid__column profile-security-grid__column--recovery">
                                <div class="profile-security-grid__item profile-security-grid__item--stacked">
                                    <h3>@L["Dashboard_Security_RecoveryTitle"].Value</h3>
                                    <p>@L["Dashboard_Security_RecoveryDescription"].Value</p>
                                    <form asp-action="UpdateRecoveryQuestions" method="post" class="profile-form">
                                        @Html.AntiForgeryToken()
                                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                                        @if (Model.Security.HasRecoveryConfigured)
                                        {
                                            <div class="form-hint form-hint--muted">@L["Dashboard_Security_RecoveryStatus_Configured"].Value</div>
                                        }
                                        else
                                        {
                                            <div class="form-hint form-hint--warning">@L["Dashboard_Security_RecoveryStatus_Missing"].Value</div>
                                        }

                                    <div class="security-questions" data-security-questions data-sequential="false" data-answer-minlength="3">
                                            <div class="form-hint form-hint--muted">@L["Auth_SecurityQuestions_CaseInsensitiveHint"].Value</div>

                                            <div class="security-question" data-question-index="1">
                                                <label for="ProfileSecurityQuestion1">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 1)</label>
                                                <select id="ProfileSecurityQuestion1" name="SecurityQuestion1" data-question-select>
                                                    <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                                    @foreach (var option in Model.Security.Recovery.SecurityQuestionOptions)
                                                    {
                                                        <option value="@option.Key"
                                                                data-allows-custom="@(option.AllowsCustomPrompt ? "true" : "false")"
                                                                selected="@(option.Key == Model.Security.Recovery.SecurityQuestion1 ? "selected" : null)">@option.Label</option>
                                                    }
                                                </select>
                                                @Html.ValidationMessage(nameof(UpdateRecoveryQuestionsInputModel.SecurityQuestion1), null, new { @class = "val" })
                                                <div class="security-question__custom-group" data-custom-container @((showRecoveryQuestion1Custom ? string.Empty : " hidden"))>
                                                    <label class="security-question__custom" for="ProfileSecurityQuestion1Custom">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                                                    <input id="ProfileSecurityQuestion1Custom" name="SecurityQuestion1Custom" value="@Model.Security.Recovery.SecurityQuestion1Custom" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                                                    @Html.ValidationMessage(nameof(UpdateRecoveryQuestionsInputModel.SecurityQuestion1Custom), null, new { @class = "val" })
                                                </div>
                                                <label class="security-question__answer" for="ProfileSecurityAnswer1">@L["Auth_Register_SecurityQuestions_Answer"].Value</label>
                                                <div class="password-field password-field--answer">
                                                    <div class="password-field__input">
                                                        <input id="ProfileSecurityAnswer1" name="SecurityAnswer1" type="text" autocomplete="off" value="@Model.Security.Recovery.SecurityAnswer1" data-answer-input minlength="3" />
                                                        <button type="button"
                                                                class="password-toggle"
                                                                data-password-toggle="ProfileSecurityAnswer1"
                                                                data-password-show="@L["Auth_Password_Show"].Value"
                                                                data-password-hide="@L["Auth_Password_Hide"].Value"
                                                                data-password-default="show"
                                                                aria-label="@L["Auth_Password_Hide"].Value"
                                                                tabindex="-1">
                                                            <svg class="password-toggle__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                <g class="password-toggle__icon-eye">
                                                                    <path d="M2.036 12.322c.125-.27 3.111-6.322 9.964-6.322 6.853 0 9.838 6.052 9.964 6.322a.75.75 0 010 .356c-.126.27-3.111 6.322-9.964 6.322-6.853 0-9.839-6.052-9.964-6.322a.75.75 0 010-.356z" />
                                                                    <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                                </g>
                                                                <g class="password-toggle__icon-eye-off">
                                                                    <path d="M3.98 8.223A10.477 10.477 0 001.934 12c1.676 3.948 5.35 6.75 9.806 6.75 1.73 0 3.37-.399 4.817-1.112" />
                                                                    <path d="M6.228 6.228A10.45 10.45 0 0111.74 5.25c4.456 0 8.13 2.802 9.806 6.75-.652 1.536-1.618 2.879-2.804 3.951" />
                                                                    <path d="M15 12a3 3 0 00-3-3" />
                                                                    <path d="M3 3l18 18" />
                                                                </g>
                                                            </svg>
                                                            <span class="sr-only" data-password-label>@L["Auth_Password_Show"].Value</span>
                                                        </button>
                                                    </div>
                                                </div>
                                                @Html.ValidationMessage(nameof(UpdateRecoveryQuestionsInputModel.SecurityAnswer1), null, new { @class = "val" })
                                            </div>


                                            <div class="security-question" data-question-index="2">
                                                <label for="ProfileSecurityQuestion2">@string.Format(L["Auth_Register_SecurityQuestion_Label"].Value, 2)</label>
                                                <select id="ProfileSecurityQuestion2" name="SecurityQuestion2" data-question-select>
                                                    <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                                    @foreach (var option in Model.Security.Recovery.SecurityQuestionOptions)
                                                    {
