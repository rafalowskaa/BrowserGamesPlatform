@section Scripts {
        if (includeOverviewScripts)
        {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
        }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploads = document.querySelectorAll('.file-upload');
            uploads.forEach(upload => {
                const input = upload.querySelector('.file-upload__input');
                const trigger = upload.querySelector('[data-file-trigger]');
                const nameTarget = upload.querySelector('[data-file-name]');
                const tooltip = upload.querySelector('.file-upload__tooltip');
                const placeholder = nameTarget ? (nameTarget.dataset.placeholder || nameTarget.textContent || '') : '';

                if (input && nameTarget) {
                    const updateFileName = () => {
                        if (input.files && input.files.length > 0) {
                            nameTarget.textContent = input.files[0].name;
                        }
                        else {
                            nameTarget.textContent = placeholder;
                        }
                    };
                    input.addEventListener('change', updateFileName);
                    updateFileName();
                }

                if (tooltip) {
                    let timerId;
                    const showTooltip = () => {
                        tooltip.classList.add('is-visible');
                        if (timerId) {
                            clearTimeout(timerId);
                        }
                        timerId = window.setTimeout(() => {
                            tooltip.classList.remove('is-visible');
                        }, 3200);
                    };

                    const hideTooltip = () => {
                        tooltip.classList.remove('is-visible');
                    };

                    const targets = [trigger, input].filter(Boolean);
                    targets.forEach(element => {
                        element.addEventListener('click', showTooltip);
                        element.addEventListener('focus', showTooltip);
                    });

                    upload.addEventListener('mouseleave', hideTooltip);
                }
            });
        });
    </script>
        if (includeProfileScripts)
        {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selector = document.getElementById('profileAction');
            if (selector) {
                const panels = document.querySelectorAll('.profile-actions__panel');
                const togglePanels = (value) => {
                    panels.forEach(panel => {
                        if (panel.dataset.action === value) {
                            panel.classList.add('is-active');
                        }
                        else {
                            panel.classList.remove('is-active');
                        }
                    });
                };

                const defaultValue = selector.dataset.default || selector.value;
                selector.value = defaultValue;
                togglePanels(defaultValue);
                selector.addEventListener('change', (event) => {
                    togglePanels(event.target.value);
                });
            }

            const profileForm = document.querySelector('.profile-form[data-display-name-can-request]');
            const displayNameInput = document.getElementById('DisplayName');
            const passwordHiddenField = document.getElementById('DisplayNamePasswordField');
            const modal = document.getElementById('displayNameConfirmModal');
            if (!profileForm || !displayNameInput || !passwordHiddenField || !modal) {
                return;
            }

            const modalMessage = modal.querySelector('[data-modal-message]');
            const warningMessage = modal.querySelector('[data-modal-warning]');
            const agreementWrapper = modal.querySelector('[data-modal-agreement]');
            const passwordWrapper = modal.querySelector('[data-modal-password]');
            const agreementCheckbox = modal.querySelector('#displayNameConfirmAgree');
            const passwordInput = modal.querySelector('#displayNameConfirmPassword');
            const confirmButton = modal.querySelector('[data-modal-confirm]');
            const closeButtons = modal.querySelectorAll('[data-modal-close]');
            const overlay = modal.querySelector('.modal-backdrop__overlay');

            const canRequestChange = profileForm.dataset.displayNameCanRequest === 'true';
            const hasPendingRequest = profileForm.dataset.displayNamePending === 'true';
            const confirmCopy = modal.dataset.confirmMessage || '';
            const blockedCopy = modal.dataset.blockedMessage || '';
            const agreementError = modal.dataset.agreementError || '';
            const passwordError = modal.dataset.passwordError || '';

            const resetModal = () => {
                if (warningMessage) {
                    warningMessage.textContent = '';
                    warningMessage.setAttribute('hidden', '');
                }
                if (agreementCheckbox) {
                    agreementCheckbox.checked = false;
                }
                if (passwordInput) {
                    passwordInput.value = '';
                }
                passwordHiddenField.value = '';
            };

            const closeModal = () => {
                resetModal();
                modal.setAttribute('hidden', '');
                modal.classList.remove('is-blocked');
                if (agreementWrapper) {
                    agreementWrapper.removeAttribute('hidden');
                }
                if (passwordWrapper) {
                    passwordWrapper.removeAttribute('hidden');
                }
                if (confirmButton) {
                    confirmButton.removeAttribute('hidden');
                    confirmButton.disabled = false;
                }
            };

            const showBlockedModal = () => {
                if (modalMessage) {
                    modalMessage.textContent = blockedCopy;
                }
                if (agreementWrapper) {
                    agreementWrapper.setAttribute('hidden', '');
                }
                if (passwordWrapper) {
                    passwordWrapper.setAttribute('hidden', '');
                }
                if (confirmButton) {
                    confirmButton.setAttribute('hidden', '');
                }
                modal.classList.add('is-blocked');
                modal.removeAttribute('hidden');
            };

            const showConfirmModal = () => {
                if (modalMessage) {
                    modalMessage.textContent = confirmCopy;
                }
                modal.classList.remove('is-blocked');
                modal.removeAttribute('hidden');
            };

            const displayBlocked = hasPendingRequest || !canRequestChange;

            const showWarning = (message) => {
                if (!warningMessage) {
                    return;
                }
                warningMessage.textContent = message;
                warningMessage.removeAttribute('hidden');
            };

            const hideWarning = () => {
                if (!warningMessage) {
                    return;
                }
                warningMessage.textContent = '';
                warningMessage.setAttribute('hidden', '');
            };

            const closeControls = () => {
                closeModal();
            };

            const openModal = () => {
                hideWarning();
                if (displayBlocked) {
                    showBlockedModal();
                }
                else {
                    showConfirmModal();
                }
            };

            if (confirmButton) {
                confirmButton.addEventListener('click', () => {
                    if (!agreementCheckbox || !passwordInput) {
                        profileForm.submit();
                        return;
                    }

                    if (!agreementCheckbox.checked) {
                        showWarning(agreementError);
                        return;
                    }

                    if (!passwordInput.value.trim()) {
                        showWarning(passwordError);
                        return;
                    }

                    hideWarning();
                    passwordHiddenField.value = passwordInput.value;
                    closeModal();
                    profileForm.submit();
                });
            }

            const closers = Array.from(closeButtons);
            if (overlay) {
                closers.push(overlay);
            }
            closers.forEach(button => {
                button.addEventListener('click', closeControls);
            });

            profileForm.addEventListener('submit', function (event) {
                const desiredName = (displayNameInput.value || '').trim();
                const currentName = (displayNameInput.dataset.currentName || '').trim();
                if (!desiredName || desiredName.toLowerCase() === currentName.toLowerCase()) {
                    return;
                }

                if (displayBlocked) {
                    event.preventDefault();
                    openModal();
                    return;
                }

                if (!passwordHiddenField.value) {
                    event.preventDefault();
                    openModal();
                }
            });
        });
    </script>
            }
            if (includeGamesScripts)
            {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wizard = document.querySelector('.game-wizard');
            if (!wizard) {
                return;
            }

            const steps = Array.from(wizard.querySelectorAll('.wizard-step'));
            const progress = Array.from(wizard.querySelectorAll('.wizard-progress__step'));

            const showWarning = (step, message) => {
                const warning = step.querySelector('[data-step-warning]');
                if (!warning) {
                    return;
                }
                if (message) {
                    warning.textContent = message;
                    warning.removeAttribute('hidden');
                }
                else {
                    warning.textContent = '';
                    warning.setAttribute('hidden', '');
                }
            };

            const setStepState = (index) => {
                const current = Math.max(0, Math.min(index, steps.length - 1));
                steps.forEach((step, idx) => {
                    if (idx === current) {
                        step.classList.add('is-active');
                    }
                    else {
                        step.classList.remove('is-active');
                    }
                    showWarning(step, '');
                });

                progress.forEach((item, idx) => {
                    item.classList.toggle('is-active', idx === current);
                    item.classList.toggle('is-complete', idx < current);
                });

                wizard.dataset.currentStep = String(current);
            };

            const stepIndexForElement = (element) => steps.findIndex(step => step.contains(element));

            const validateStep = (index) => {
                const step = steps[index];
                if (!step) {
                    return true;
                }

                const warningMessage = step.dataset.warning || '';
                switch (index) {
                    case 0: {
                        const packageInput = wizard.querySelector('#GamePackage');
                        const titleInput = wizard.querySelector('#GameTitle');
                        const hasPackage = packageInput && packageInput.files && packageInput.files.length > 0;
                        const hasTitle = titleInput && titleInput.value.trim().length > 0;
                        if (!hasPackage || !hasTitle) {
                            showWarning(step, warningMessage);
                            return false;
                        }
                        showWarning(step, '');
                        return true;
                    }
                    case 2: {
                        const categoriesSelect = wizard.querySelector('#GameCategories');
                        const categorySelected = categoriesSelect
                            ? Array.from(categoriesSelect.selectedOptions || []).length > 0
                            : false;
                        const modeSelected = wizard.querySelectorAll('input[name="SelectedModeValues"]:checked').length > 0;
                        if (!categorySelected || !modeSelected) {
                            showWarning(step, warningMessage);
                            return false;
                        }
                        showWarning(step, '');
                        return true;
                    }
                    default:
                        showWarning(step, '');
                        return true;
                }
            };

            const goToStep = (index) => {
                setStepState(index);
            };

            const nextButtons = wizard.querySelectorAll('[data-wizard-next]');
            nextButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const index = stepIndexForElement(button);
                    if (validateStep(index)) {
                        goToStep(index + 1);
                    }
                });
            });

            const prevButtons = wizard.querySelectorAll('[data-wizard-prev]');
            prevButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const index = stepIndexForElement(button);
                    goToStep(index - 1);
                });
            });

            const firstErrorStep = steps.findIndex(step => Array.from(step.querySelectorAll('.val')).some(message => message.textContent && message.textContent.trim().length > 0));
            if (firstErrorStep >= 0) {
                goToStep(firstErrorStep);
            }
            else {
                goToStep(0);
            }
        });
    </script>
        }
}