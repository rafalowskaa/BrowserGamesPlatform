﻿@using System.Globalization
@using System.Linq
@using System.Text.Json
@using Bgp.Domain.Constants
@using Bgp.Domain.Enums
@using Bgp.Web.Helpers
@using Bgp.Web.Models
@using Bgp.Web.ViewModels
@model DashboardViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard-games.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/friends.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Dashboard_Title"].Value;
    var activeTab = (ViewData["ActiveTab"] as string ?? "overview").ToLowerInvariant();
    var successKey = TempData["DashboardSuccess"] as string;
    var successMessage = successKey switch
    {
        "ProfileUpdated" => L["Dashboard_Success_Profile"].Value,
        "EmailUpdated" => L["Dashboard_Success_Email"].Value,
        "PasswordUpdated" => L["Dashboard_Success_Password"].Value,
        "RecoveryUpdated" => L["Dashboard_Success_Recovery"].Value,
        "GameCreated" => L["Dashboard_Success_Game"].Value,
        "DisplayNameRequested" => L["Dashboard_Success_DisplayNameRequested"].Value,
        "SessionsRevoked" => L["Dashboard_Success_Sessions"].Value,
        "Dashboard_Notifications_Delete_Success" => L["Dashboard_Notifications_Delete_Success"].Value,
        "ExperienceHistoryCleared" => L["Dashboard_Success_ExperienceHistoryCleared"].Value,
        _ => null
    };
    var includeProfileScripts = false;
    var includeOverviewScripts = false;
    var includeGamesScripts = false;
    var includeFriendsScripts = false;
    var includeRankingScripts = false;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    string StatusClass(GameApprovalStatus status) => status switch
    {
        GameApprovalStatus.Approved => "status-approved",
        GameApprovalStatus.Rejected => "status-rejected",
        _ => "status-pending"
    };
    string StatusLabel(GameApprovalStatus status) => status switch
    {
        GameApprovalStatus.Approved => L["Dashboard_Games_Status_Approved"].Value,
        GameApprovalStatus.Rejected => L["Dashboard_Games_Status_Rejected"].Value,
        _ => L["Dashboard_Games_Status_Pending"].Value
    };
    var rejectionTemplate = L["Games_Rejected_RemovalCountdown"].Value;

    string? BuildRejectionTooltip(GameApprovalStatus status, DateTime? rejectedAtUtc)
    {
        var deadline = GetRejectionDeadline(status, rejectedAtUtc);
        if (deadline is null)
        {
            return null;
        }

        var daysRemaining = Math.Max(0, (int)Math.Ceiling((deadline.Value - DateTime.UtcNow).TotalDays));
        return string.Format(L["Games_Rejected_RemovalCountdown"].Value, daysRemaining);
    }

    DateTime? GetRejectionDeadline(GameApprovalStatus status, DateTime? rejectedAtUtc)
    {
        if (status != GameApprovalStatus.Rejected || rejectedAtUtc is null)
        {
            return null;
        }

        return rejectedAtUtc.Value.Add(GameModerationSettings.RejectedRetentionPeriod);
    }
}
<section class="dashboard">
    <header class="dashboard-header">
        <div>
            <h1>@L["Dashboard_Title"].Value</h1>
            <p>@L["Dashboard_Overview_Description"].Value</p>
        </div>
    </header>

    <nav class="dashboard-nav">
        <a class="dashboard-nav__item@(activeTab == "overview" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="overview">@L["Dashboard_Overview_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "profile" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="profile">@L["Dashboard_Profile_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "stats" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="stats">@L["Dashboard_Stats_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "games" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="games">@L["Dashboard_Games_AddTab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "friends" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="friends">@L["Dashboard_Friends_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "notifications" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="notifications">
            @L["Dashboard_Notifications_Tab"].Value
            <span class="notification-badge" data-notifications-badge hidden>0</span>
        </a>
        <a class="dashboard-nav__item@(activeTab == "ranking" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="ranking">@L["Dashboard_Ranking_Tab"].Value</a>
        <a class="dashboard-nav__item@(activeTab == "history" ? " active" : string.Empty)" asp-action="Index" asp-route-tab="history">@L["Dashboard_ExperienceHistory_Tab"].Value</a>
    </nav>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert success">@successMessage</div>
    }

    @switch (activeTab)
    {
        case "profile":
            includeProfileScripts = true;
            var selectedProfilePanel = (ViewData["ProfilePanel"] as string ?? "profile").ToLowerInvariant();
            if (selectedProfilePanel == "email" || selectedProfilePanel == "password")
            {
                selectedProfilePanel = "security";
            }
            @await Html.PartialAsync("Partials/_ProfileTab", (Model, selectedProfilePanel))
            break;
        case "stats":
            <section class="dashboard-panel">
                <h2>@L["Dashboard_Stats_Tab"].Value</h2>
                <ul class="stats-list compact">
                    <li><span>@L["Dashboard_Stats_UploadedGames"].Value</span><strong>@Model.Stats.UploadedGames</strong></li>
                    <li><span>@L["Dashboard_Stats_TotalScores"].Value</span><strong>@Model.Stats.TotalScores</strong></li>
                    <li><span>@L["Dashboard_Stats_TotalReviews"].Value</span><strong>@Model.Stats.TotalReviews</strong></li>
                    <li><span>@L["Dashboard_Stats_Friends"].Value</span><strong>@Model.Stats.FriendsCount</strong></li>
                </ul>
            </section>
            break;
        case "games":
            includeGamesScripts = true;
            <section class="dashboard-panel games-panel">
                <header class="panel-header">
                    <div>
                        <h2>@L["Dashboard_Games_AddTitle"].Value</h2>
                        <p>@L["Dashboard_Games_AddDescription"].Value</p>
                    </div>
                    <aside class="panel-note">@L["Dashboard_Games_VerificationNotice"].Value</aside>
                </header>

                <form asp-action="CreateGame" method="post" enctype="multipart/form-data" class="game-wizard">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, null, new { @class = "val-summary" })


                    <div class="wizard-progress" role="list">
                        <span class="wizard-progress__step" data-step-index="0">@L["Dashboard_Games_Wizard_Step1_Short"].Value</span>
                        <span class="wizard-progress__step" data-step-index="1">@L["Dashboard_Games_Wizard_Step2_Short"].Value</span>
                        <span class="wizard-progress__step" data-step-index="2">@L["Dashboard_Games_Wizard_Step3_Short"].Value</span>
                        <span class="wizard-progress__step" data-step-index="3">@L["Dashboard_Games_Wizard_Step4_Short"].Value</span>
                    </div>


                    <div class="wizard-steps">
                        <section class="wizard-step" data-step="0" data-warning="@L["Dashboard_Games_Wizard_Step1_Warning"].Value">
                            <h3>@L["Dashboard_Games_Wizard_Step1_Title"].Value</h3>
                            <p class="wizard-step__intro">@L["Dashboard_Games_Wizard_Step1_Intro"].Value</p>
                            <div class="wizard-field">
                                <label for="GamePackage">@L["Dashboard_Games_Package"].Value</label>
                                <div class="file-upload">
                                    <input id="GamePackage" type="file" name="Package" accept=".zip" class="file-upload__input" />
                                    <label for="GamePackage" class="btn-outline btn-compact file-upload__button" data-file-trigger>@L["Dashboard_Common_SelectFile"].Value</label>
                                    <span class="file-upload__meta" data-file-name data-placeholder="@L["Dashboard_Common_NoFile"].Value">@L["Dashboard_Common_NoFile"].Value</span>
                                </div>
                                @Html.ValidationMessage("Package", null, new { @class = "val" })
                            </div>
                            <div class="wizard-field">
                                <label for="GameTitle">@L["Dashboard_Games_Title"].Value</label>
                                <input id="GameTitle"
                                       name="Title"
                                       type="text"
                                       value="@Model.NewGame.Title"
                                       maxlength="120"
                                       class="wizard-field__control" />
                                @Html.ValidationMessage("Title", null, new { @class = "val" })
                            </div>
                            <p class="wizard-step__warning" data-step-warning hidden></p>
                            <div class="wizard-actions">
                                <button type="button" class="btn-primary btn-compact" data-wizard-next>@L["Dashboard_Games_Wizard_Next"].Value</button>
                            </div>
                        </section>

                        <section class="wizard-step" data-step="1">
                            <h3>@L["Dashboard_Games_Wizard_Step2_Title"].Value</h3>
                            <p class="wizard-step__intro">@L["Dashboard_Games_Wizard_Step2_Intro"].Value</p>
                            <div class="wizard-field">
                                <label for="GameDescription">@L["Dashboard_Games_Description"].Value</label>
                                <textarea id="GameDescription" name="Description" maxlength="2000">@(Model.NewGame.Description ?? string.Empty)</textarea>
                                @Html.ValidationMessage("Description", null, new { @class = "val" })
                            </div>

                            <div class="wizard-field">
                                <label for="GameRules">@L["Dashboard_Games_Rules_Label"].Value</label>
                                <textarea id="GameRules" name="Rules">@(Model.NewGame.Rules ?? string.Empty)</textarea>
                                <div class="form-hint">@L["Dashboard_Games_Rules_Hint"].Value</div>
                                @Html.ValidationMessage("Rules", null, new { @class = "val" })
                            </div>

                            <div class="wizard-field">
                                <label for="GameCover">@L["Dashboard_Games_Cover"].Value</label>
                                <div class="file-upload">
                                    <input id="GameCover" type="file" name="CoverImage" accept="image/*" class="file-upload__input" />
                                    <label for="GameCover" class="btn-outline btn-compact file-upload__button" data-file-trigger>@L["Dashboard_Common_SelectFile"].Value</label>
                                    <span class="file-upload__meta" data-file-name data-placeholder="@L["Dashboard_Common_NoFile"].Value">@L["Dashboard_Common_NoFile"].Value</span>
                                </div>
                                @Html.ValidationMessage("CoverImage", null, new { @class = "val" })
                            </div>
                            <div class="wizard-field">
                                <label for="GameVersion">@L["Dashboard_Games_Version"].Value</label>
                                <input id="GameVersion" name="Version" value="@Model.NewGame.Version" maxlength="32" />
                                @Html.ValidationMessage("Version", null, new { @class = "val" })
                            </div>
                            <div class="wizard-actions">
                                <button type="button" class="btn-outline btn-compact" data-wizard-prev>@L["Dashboard_Games_Wizard_Back"].Value</button>
                                <button type="button" class="btn-primary btn-compact" data-wizard-next>@L["Dashboard_Games_Wizard_Next"].Value</button>
                            </div>
                        </section>

                        <section class="wizard-step" data-step="2" data-warning="@L["Dashboard_Games_Wizard_Step3_Warning"].Value">
                            <h3>@L["Dashboard_Games_Wizard_Step3_Title"].Value</h3>
                            <p class="wizard-step__intro">@L["Dashboard_Games_Wizard_Step3_Intro"].Value</p>
                            <div class="wizard-grid">
                                <div class="wizard-fieldset">
                                    <h4>@L["Dashboard_Games_Categories_Label"].Value</h4>
                                    <div class="form-hint">@L["Dashboard_Games_Categories_Hint"].Value</div>
                                    <select id="GameCategories"
                                            name="SelectedCategoryValues"
                                            multiple
                                            size="6"
                                            class="wizard-field__control">
                                        @foreach (var option in Model.NewGame.CategoryOptions)
                                        {
                                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                        }
                                    </select>
                                    @Html.ValidationMessage("SelectedCategoryValues", null, new { @class = "val" })
                                </div>
                            </div>
                            <p class="wizard-step__warning" data-step-warning hidden></p>
                            <div class="wizard-actions">
                                <button type="button" class="btn-outline btn-compact" data-wizard-prev>@L["Dashboard_Games_Wizard_Back"].Value</button>
                                <button type="button" class="btn-primary btn-compact" data-wizard-next>@L["Dashboard_Games_Wizard_Next"].Value</button>
                            </div>
                        </section>

                        <section class="wizard-step" data-step="3">
                            <h3>@L["Dashboard_Games_Wizard_Step4_Title"].Value</h3>
                            <p class="wizard-step__intro">@L["Dashboard_Games_Wizard_Step4_Intro"].Value</p>
                            <div class="wizard-field">
                                <label for="GameTags">@L["Dashboard_Games_Tags_Label"].Value</label>
                                <textarea id="GameTags" name="TagsRaw" maxlength="200" placeholder="@L["Dashboard_Games_Tags_Placeholder"].Value">@Model.NewGame.TagsRaw</textarea>
                                <div class="form-hint">@L["Dashboard_Games_Tags_Hint"].Value</div>
                                @Html.ValidationMessage("TagsRaw", null, new { @class = "val" })
                            </div>
                            <div class="form-hint form-hint--muted wizard-final-note">@L["Dashboard_Games_Wizard_FinalNotice"].Value</div>
                            <div class="wizard-actions">
                                <button type="button" class="btn-outline btn-compact" data-wizard-prev>@L["Dashboard_Games_Wizard_Back"].Value</button>
                                <button class="btn-primary btn-compact" type="submit">@L["Dashboard_Games_Wizard_Submit"].Value</button>
                            </div>
                        </section>
                    </div>

                    
                </form>

                <h3>@L["Dashboard_Games_ListHeading"].Value</h3>
                @if (Model.MyGames.Any())
                {

                    <div class="table-wrapper">
                        <table class="admin-table compact">
                            <thead>
                                <tr>
                                    <th>@L["Dashboard_Games_Title"].Value</th>
                                    <th>@L["Dashboard_Games_Status"].Value</th>
                                    <th>@L["Dashboard_Games_Submitted"].Value</th>
                                    <th>@L["Dashboard_Games_Rating"].Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var game in Model.MyGames)
                                {
                                    var rejectionDeadline = GetRejectionDeadline(game.ApprovalStatus, game.RejectedAtUtc);
                                    var rejectionDeadlineValue = rejectionDeadline?.ToString("O");
                                    var rejectionTooltip = BuildRejectionTooltip(game.ApprovalStatus, game.RejectedAtUtc);
                                    <tr>
                                        <td>
                                            <strong>@game.Title</strong>
                                            <div class="game-meta">@game.Slug</div>
                                            @if (game.ModerationNotes is not null && game.ApprovalStatus == GameApprovalStatus.Rejected)
                                            {
                                                <div class="game-note">@game.ModerationNotes</div>
                                            }
                                        </td>
                                        <td><span class="status-pill @StatusClass(game.ApprovalStatus)"
                                                  data-rejection-template="@rejectionTemplate"
                                                  data-rejection-deadline="@rejectionDeadlineValue"
                                                  title="@(rejectionTooltip ?? string.Empty)">@StatusLabel(game.ApprovalStatus)</span></td>
                                        <td>@game.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                        <td>@string.Format("{0:0.0}", game.AverageRating)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                }
                else
                {
                    <p class="empty">@L["Dashboard_Games_Empty"].Value</p>
                }
            </section>
            break;
        case "friends":
            includeFriendsScripts = true;

            <section class="dashboard-panel friends-panel">
                <article class="friends-section friends-section--search">
                    <h3>@L["Dashboard_Friends_SearchHeading"].Value</h3>
                    <p>@L["Dashboard_Friends_SearchDescription"].Value</p>
                    <div class="friends-search">
                        <input type="search" id="friendSearch" placeholder="@L["Dashboard_Friends_SearchPlaceholder"].Value" />
                        <button id="friendSearchBtn" class="btn-primary" type="button">@L["Dashboard_Friends_SearchButton"].Value</button>
                    </div>
                    <ul id="friendSearchResults" class="friends-list friends-list--muted"></ul>
                    <p id="friendSearchEmpty" class="empty">@L["Dashboard_Friends_SearchEmpty"].Value</p>
                </article>
                <article class="friends-section friends-section--list">
                    <h3>@L["Dashboard_Friends_CurrentHeading"].Value</h3>
                    <ul id="friendsAccepted" class="friends-list friends-list--detailed"></ul>
                    <p id="friendsAcceptedEmpty" class="empty">@L["Dashboard_Friends_Empty"].Value</p>
                </article>
                <article class="friends-section friends-section--requests">
                    <div class="friends-subsection">
                        <h3>@L["Dashboard_Friends_OutgoingHeading"].Value</h3>
                        <ul id="friendsOutgoing" class="friends-list friends-list--compact"></ul>
                        <p id="friendsOutgoingEmpty" class="empty">@L["Dashboard_Friends_NoOutgoing"].Value</p>
                    </div>
                    <div class="friends-subsection">
                        <h3>@L["Dashboard_Friends_IncomingHeading"].Value</h3>
                        <ul id="friendsIncoming" class="friends-list friends-list--compact"></ul>
                        <p id="friendsIncomingEmpty" class="empty">@L["Dashboard_Friends_NoIncoming"].Value</p>
                    </div>
                </article>

                <article class="friends-section">
                    <details id="friendsBlockedPanel" class="friends-blocked">
                        <summary>
                            <span>@L["Dashboard_Friends_BlockedHeading"].Value</span>
                            <span class="friends-blocked__count" data-friends-blocked-count>0</span>
                        </summary>
                        <ul id="friendsBlocked" class="friends-list friends-list--compact"></ul>
                        <p id="friendsBlockedEmpty" class="empty">@L["Dashboard_Friends_NoBlocked"].Value</p>
                    </details>
                </article>

                @{
                    var friendStrings = new
                    {
                        add = L["Dashboard_Friends_Add"].Value,
                        cancel = L["Dashboard_Friends_Cancel"].Value,
                        accept = L["Dashboard_Friends_Accept"].Value,
                        decline = L["Dashboard_Friends_Decline"].Value,
                        chat = L["Dashboard_Friends_Chat"].Value,
                        invite = L["Dashboard_Friends_InviteToGame"].Value,
                        inviteMessage = L["Dashboard_Friends_InviteMessage"].Value,
                        remove = L["Dashboard_Friends_Remove"].Value,
                        report = L["Dashboard_Friends_Report"].Value,
                        reportPrompt = L["Dashboard_Friends_ReportPrompt"].Value,
                        reportSuccess = L["Dashboard_Friends_ReportSuccess"].Value,
                        reportError = L["Dashboard_Friends_ReportError"].Value,
                        rankLabel = L["Dashboard_Friends_RankLabel"].Value,
                        rankUnknown = L["Dashboard_Friends_RankUnknown"].Value,
                        playingGame = L["Dashboard_Friends_Playing"].Value,
                        viewProfile = L["Dashboard_Friends_ViewProfile"].Value,
                        block = L["Dashboard_Friends_Block"].Value,
                        blockConfirm = L["Dashboard_Friends_BlockConfirm"].Value,
                        blockSuccess = L["Dashboard_Friends_BlockSuccess"].Value,
                        blockError = L["Dashboard_Friends_BlockError"].Value,
                        removeConfirm = L["Dashboard_Friends_RemoveConfirm"].Value,
                        unblock = L["Dashboard_Friends_Unblock"].Value,
                        unblockConfirm = L["Dashboard_Friends_UnblockConfirm"].Value,
                        blockedEmpty = L["Dashboard_Friends_NoBlocked"].Value,
                        searchMinChars = L["Dashboard_Friends_SearchMinChars"].Value
                    };

                }
                <script type="application/json" id="friendStrings">@Html.Raw(JsonSerializer.Serialize(friendStrings))</script>
            </section>
            break;
        case "notifications":
            <section class="dashboard-panel notifications-panel" data-notifications-view>
                <header class="panel-header">
                    <div>
                        <h2>@L["Dashboard_Notifications_Title"].Value</h2>
                        <p>@L["Dashboard_Notifications_Subtitle"].Value</p>
                    </div>
                </header>
                <ul class="notification-list" role="list">
                    @if (Model.Notifications.Any())
                    {
                        foreach (var notification in Model.Notifications)
                        {
                            <li class="notification-item">
                                @if (!string.IsNullOrWhiteSpace(notification.Link))
                                {
                                    <a class="notification-link" href="@notification.Link">
                                        <span class="notification-text">@notification.Message</span>
                                        <span class="notification-time">@notification.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="notification-link">
                                        <span class="notification-text">@notification.Message</span>
                                        <span class="notification-time">@notification.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                    </span>
                                }
                                <form asp-action="DeleteNotification" method="post" class="notification-remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit" class="btn-ghost" aria-label="@L["Dashboard_Notifications_Delete"].Value">✕</button>
                                </form>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="notification-empty">@L["Dashboard_Notifications_Empty"].Value</li>
                    }
                </ul>
            </section>
            break;
             case "ranking":
            includeRankingScripts = true;
            var rankingSection = new GlobalRankingSectionViewModel
            {
                Title = L["GlobalRanking_Title"].Value,
                Subtitle = L["GlobalRanking_Description"].Value,
                RankLabel = L["GlobalRanking_RankLabel"].Value,
                AvatarLabel = L["GlobalRanking_AvatarLabel"].Value,
                PlayerLabel = L["GlobalRanking_PlayerLabel"].Value,
                MostPlayedGameLabel = L["GlobalRanking_MostPlayedLabel"].Value,
                SearchPlaceholder = L["GlobalRanking_SearchPlaceholder"].Value,
                FilterLabel = L["GlobalRanking_FilterLabel"].Value,
                FilterAllLabel = L["GlobalRanking_Filter_All"].Value,
                LevelLabel = L["GlobalRanking_LevelLabel"].Value,
                ExperienceLabel = L["GlobalRanking_ExperienceLabel"].Value,
                RankTitleLabel = L["Dashboard_Friends_RankLabel"].Value,
                RankTitleUnknownLabel = L["Dashboard_Friends_RankUnknown"].Value,
                EmptyLabel = L["GlobalRanking_Empty"].Value,
                ActionsLabel = L["GlobalRanking_Actions_Label"].Value,
                ActionsMessage = L["GlobalRanking_Actions_Message"].Value,
                ActionsAddFriend = L["GlobalRanking_Actions_AddFriend"].Value,
                ActionsRemoveFriend = L["Dashboard_Friends_Remove"].Value,
                ActionsInvite = L["GlobalRanking_Actions_Invite"].Value,
                ActionsViewProfile = L["GlobalRanking_Actions_ViewProfile"].Value,
                ActionsMoreLabel = L["GlobalRanking_Actions_More"].Value,
                ActionsBlock = L["Dashboard_Friends_Block"].Value,
                ActionsBlockConfirm = L["Dashboard_Friends_BlockConfirm"].Value,
                ActionsBlockSuccess = L["Dashboard_Friends_BlockSuccess"].Value,
                ActionsBlockError = L["Dashboard_Friends_BlockError"].Value,
                ActionsReport = L["Dashboard_Friends_Report"].Value,
                ActionsReportPrompt = L["Dashboard_Friends_ReportPrompt"].Value,
                ActionsReportSuccess = L["Dashboard_Friends_ReportSuccess"].Value,
                ActionsReportError = L["Dashboard_Friends_ReportError"].Value,
                JumpToMeLabel = L["GlobalRanking_JumpToMe_Label"].Value,
                SelfBadgeLabel = L["GlobalRanking_SelfBadge"].Value,
                Data = Model.GlobalRanking,
                AnchorId = "dashboard-ranking"
            };
            <section class="dashboard-panel">
                @await Html.PartialAsync("_GlobalRanking", rankingSection)
            </section>
            break;
        case "history":
            <section class="dashboard-panel experience-history-panel">
                <header class="panel-header">
                    <div>
                        <h2>@L["Dashboard_ExperienceHistory_Title"].Value</h2>
                        <p>@L["Dashboard_ExperienceHistory_Subtitle"].Value</p>
                    </div>
                    <form asp-action="ClearExperienceHistory" method="post" class="inline-form" onsubmit="return confirm('@L["Dashboard_ExperienceHistory_Clear_Confirm"].Value');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-outline btn-compact">@L["Dashboard_ExperienceHistory_Clear"].Value</button>
                    </form>
                </header>
                <ul class="experience-history" role="list">
                    @if (Model.Profile.ExperienceHistory.Any())
                    {
                        foreach (var entry in Model.Profile.ExperienceHistory)
                        {
                            var amountClass = entry.Points >= 0 ? "is-positive" : "is-negative";
                            <li class="experience-history__item">
                                <div class="experience-history__meta">
                                    <div class="experience-history__heading">
                                        <strong>@entry.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(entry.GameTitle))
                                        {
                                            <span class="experience-history__game">@entry.GameTitle</span>
                                        }
                                    </div>
                                    <p>@entry.Description</p>
                                </div>
                                <div class="experience-history__aside">
                                    <span class="experience-history__amount @amountClass">
                                        @(entry.Points >= 0 ? "+" : string.Empty)@entry.Points
                                    </span>
                                    <span class="experience-history__label">@L["Dashboard_ExperienceHistory_PointsLabel"].Value</span>
                                    <time class="experience-history__time">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</time>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="experience-history__empty">@L["Dashboard_ExperienceHistory_Empty"].Value</li>
                    }
                </ul>
            </section>
            break;
        default:
            includeOverviewScripts = true;
            <section class="dashboard-panel">
                <h2>@L["Dashboard_Overview_Heading"].Value</h2>
                <p>@L["Dashboard_Overview_Subheading"].Value</p>
                <div class="grid">
                    @foreach (var game in Model.Games)
                    {
                        <article class="card card--link">
                            <a asp-controller="Games" asp-action="Details" asp-route-slug="@game.Slug" class="card__media-link">
                                <img src="@(game.CoverImagePath ?? "/img/placeholder.png")" alt="cover" />
                            </a>
                            <a asp-controller="Games" asp-action="Details" asp-route-slug="@game.Slug" class="card__hit">
                                <span class="sr-only">@game.Title</span>
                            </a>
                            <h3><a asp-controller="Games" asp-action="Details" asp-route-slug="@game.Slug">@game.Title</a></h3>
                            <p>@string.Format(L["Dashboard_Games_Rating"].Value, $"{game.AverageRating:0.0}")</p>
                        </article>
                    }
                </div>
            </section>

            break;
    }
</section>

@section Scripts {
        @if (includeOverviewScripts)
        {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
        }
        @if (includeFriendsScripts)
        {
    <script src="~/js/friends.js" asp-append-version="true"></script>
        }
        @if (includeRankingScripts)
        {
    <script src="~/js/ranking.js" asp-append-version="true"></script>
        }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploads = document.querySelectorAll('.file-upload');
            uploads.forEach(upload => {
                const input = upload.querySelector('.file-upload__input');
                const trigger = upload.querySelector('[data-file-trigger]');
                const nameTarget = upload.querySelector('[data-file-name]');
                const tooltip = upload.querySelector('.file-upload__tooltip');
                const placeholder = nameTarget ? (nameTarget.dataset.placeholder || nameTarget.textContent || '') : '';

                if (input && nameTarget) {
                    const updateFileName = () => {
                        if (input.files && input.files.length > 0) {
                            nameTarget.textContent = input.files[0].name;
                        }
                        else {
                            nameTarget.textContent = placeholder;
                        }
                    };
                    input.addEventListener('change', updateFileName);
                    updateFileName();
                }

                if (tooltip) {
                    let timerId;
                    const showTooltip = () => {
                        tooltip.classList.add('is-visible');
                        if (timerId) {
                            clearTimeout(timerId);
                        }
                        timerId = window.setTimeout(() => {
                            tooltip.classList.remove('is-visible');
                        }, 3200);
                    };

                    const hideTooltip = () => {
                        tooltip.classList.remove('is-visible');
                    };

                    const targets = [trigger, input].filter(Boolean);
                    targets.forEach(element => {
                        element.addEventListener('click', showTooltip);
                        element.addEventListener('focus', showTooltip);
                    });

                    upload.addEventListener('mouseleave', hideTooltip);
                }
            });
        });
    </script>
        @if (includeProfileScripts)
    {
        <script src="~/js/profile-editor.js" asp-append-version="true"></script>
    }
    @if (includeGamesScripts)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const wizard = document.querySelector('.game-wizard');
                if (!wizard) {
                    return;
                }
               const steps = Array.from(wizard.querySelectorAll('.wizard-step'));
                const progress = Array.from(wizard.querySelectorAll('.wizard-progress__step'));

                const showWarning = (step, message) => {
                    const warning = step.querySelector('[data-step-warning]');
                    if (!warning) {
                        return;
                    }
                    if (message) {
                        warning.textContent = message;
                        warning.removeAttribute('hidden');
                    }
                    else {
                        warning.textContent = '';
                        warning.setAttribute('hidden', '');
                    }
                     };

               const setStepState = (index) => {
                    const current = Math.max(0, Math.min(index, steps.length - 1));
                    steps.forEach((step, idx) => {
                        if (idx === current) {
                            step.classList.add('is-active');
                        }
                        else {
                            step.classList.remove('is-active');
                        }
                        showWarning(step, '');
                    });

                progress.forEach((item, idx) => {
                        item.classList.toggle('is-active', idx === current);
                        item.classList.toggle('is-complete', idx < current);
                    });

            wizard.dataset.currentStep = String(current);
                };

            const stepIndexForElement = (element) => steps.findIndex(step => step.contains(element));

                const validateStep = (index) => {
                    const step = steps[index];
                    if (!step) {
                        return true;
                    }
                    const warningMessage = step.dataset.warning || '';
                    switch (index) {
                        case 0: {
                            const packageInput = wizard.querySelector('#GamePackage');
                            const titleInput = wizard.querySelector('#GameTitle');
                            const hasPackage = packageInput && packageInput.files && packageInput.files.length > 0;
                            const hasTitle = titleInput && titleInput.value.trim().length > 0;
                            if (!hasPackage || !hasTitle) {
                                showWarning(step, warningMessage);
                                return false;
                            }
                            showWarning(step, '');
                            return true;
                        }
                        case 2: {
                            const categoriesSelect = wizard.querySelector('#GameCategories');
                            const categorySelected = categoriesSelect
                                ? Array.from(categoriesSelect.selectedOptions || []).length > 0
                                : false;
                                 if (!categorySelected) {
                                showWarning(step, warningMessage);
                                return false;
                            }
                            showWarning(step, '');
                            return true;
                        }
                        default:
                            showWarning(step, '');
                            return true;
                    }
                };

                const goToStep = (index) => {
                    setStepState(index);
                };

                const nextButtons = wizard.querySelectorAll('[data-wizard-next]');
                nextButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        const index = stepIndexForElement(button);
                        if (validateStep(index)) {
                            goToStep(index + 1);
                        }
                    });
                });
            

             const prevButtons = wizard.querySelectorAll('[data-wizard-prev]');
                prevButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        const index = stepIndexForElement(button);
                        goToStep(index - 1);
                    });
            });

            const firstErrorStep = steps.findIndex(step => Array.from(step.querySelectorAll('.val')).some(message => message.textContent && message.textContent.trim().length > 0));
            if (firstErrorStep >= 0) {
                goToStep(firstErrorStep);
            }
            else {
                goToStep(0);
            }
        });
    </script>
        }
}