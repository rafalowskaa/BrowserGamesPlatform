@using System.Globalization
@using Bgp.Web.Helpers
@using System.Linq
@model (Bgp.Web.Models.DashboardViewModel Vm, string SelectedPanel)
@{
    var vm = Model.Vm;
    var profile = vm.Profile;
    var security = vm.Security;
    var preferences = vm.Preferences;
    var selectedPanel = string.IsNullOrWhiteSpace(Model.SelectedPanel) ? "profile" : Model.SelectedPanel;
    var rank = profile.Rank;
    var hasRankTrophy = !string.IsNullOrEmpty(rank.TrophyImage);
    var identityClass = hasRankTrophy
        ? "profile-hero__identity profile-hero__identity--decorated"
        : "profile-hero__identity";
    var heroCoreClass = hasRankTrophy
    ? "profile-hero__core profile-hero__core--has-trophy"
    : "profile-hero__core";
    var months = Enumerable.Range(1, 12)
        .Select(i => new { Value = i, Name = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames[i - 1] })
        .Select(m => new { m.Value, Name = string.IsNullOrWhiteSpace(m.Name) ? m.Value.ToString("00") : m.Name })
        .ToList();
    var days = Enumerable.Range(1, 31).ToList();
    var hasPendingDisplayName = !string.IsNullOrWhiteSpace(profile.PendingDisplayName);
    var changeAvailableAt = profile.DisplayNameChangeAvailableAtUtc;
    var displayNameBlockedTemplate = L["Dashboard_Profile_DisplayName_ConfirmBlocked"].Value;
    var displayNameBlockedGeneric = L["Dashboard_Profile_DisplayName_ConfirmBlocked_Generic"].Value;
    var displayNameConfirmMessage = L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value;
    var displayNamePendingTemplate = L["Dashboard_Profile_DisplayName_PendingInfo"].Value;
    var canRequestDisplayNameChange = !hasPendingDisplayName && (!changeAvailableAt.HasValue || changeAvailableAt.Value <= DateTime.UtcNow);
    var displayNameBlockedMessage = changeAvailableAt.HasValue
        ? string.Format(displayNameBlockedTemplate, changeAvailableAt.Value.ToLocalTime().ToString("f"))
        : displayNameBlockedGeneric;
    var pendingDisplayNameMessage = hasPendingDisplayName
        ? string.Format(displayNamePendingTemplate, profile.PendingDisplayName, profile.PendingDisplayNameRequestedAtUtc?.ToLocalTime().ToString("g"))
        : string.Empty;
    var displayNameLocked = hasPendingDisplayName || !canRequestDisplayNameChange;
    var goals = profile.DailyGoals.Take(3).ToList();
    var highlights = profile.Highlights.Take(3).ToList();
    var sections = new (string Id, string Label)[]
    {
        ("profile", L["Dashboard_Profile_Local_Profile"].Value),
        ("privacy", L["Dashboard_Profile_Local_Privacy"].Value),
        ("security", L["Dashboard_Profile_Local_Security"].Value),
        ("preferences", L["Dashboard_Profile_Local_Preferences"].Value)
    };

    bool IsPanelActive(string id) => string.Equals(selectedPanel, id, StringComparison.OrdinalIgnoreCase);
    string GetPanelAttributes(string id) => IsPanelActive(id) ? string.Empty : " hidden aria-hidden=\"true\"";

    bool HasError(string propertyName) => ViewData.ModelState.TryGetValue(propertyName, out var entry) && entry.Errors.Count > 0;
    bool ShouldShowCustom(string? key, string? customValue, string customErrorMember) =>
        string.Equals(key?.Trim(), SecurityQuestionCatalog.CustomKey, StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(customValue)
        || HasError(customErrorMember);

    var question1HasError = HasError("SecurityQuestion1") || HasError("SecurityQuestion1Custom") || HasError("SecurityAnswer1");
    var question2HasError = HasError("SecurityQuestion2") || HasError("SecurityQuestion2Custom") || HasError("SecurityAnswer2");
    var question3HasError = HasError("SecurityQuestion3") || HasError("SecurityQuestion3Custom") || HasError("SecurityAnswer3");

    var showQuestion1Custom = ShouldShowCustom(security.Recovery.SecurityQuestion1, security.Recovery.SecurityQuestion1Custom, "SecurityQuestion1Custom");
    var showQuestion2Custom = ShouldShowCustom(security.Recovery.SecurityQuestion2, security.Recovery.SecurityQuestion2Custom, "SecurityQuestion2Custom");
    var showQuestion3Custom = ShouldShowCustom(security.Recovery.SecurityQuestion3, security.Recovery.SecurityQuestion3Custom, "SecurityQuestion3Custom");

    var recoveryQuestions = new[]
    {
        new
        {
            Index = 1,
            QuestionValue = security.Recovery.SecurityQuestion1 ?? string.Empty,
            CustomValue = security.Recovery.SecurityQuestion1Custom ?? string.Empty,
            AnswerValue = security.Recovery.SecurityAnswer1 ?? string.Empty,
            ShowCustom = showQuestion1Custom,
            HasError = question1HasError,
            HasValue = !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion1)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion1Custom)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityAnswer1)
        },
        new
        {
            Index = 2,
            QuestionValue = security.Recovery.SecurityQuestion2 ?? string.Empty,
            CustomValue = security.Recovery.SecurityQuestion2Custom ?? string.Empty,
            AnswerValue = security.Recovery.SecurityAnswer2 ?? string.Empty,
            ShowCustom = showQuestion2Custom,
            HasError = question2HasError,
            HasValue = !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion2)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion2Custom)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityAnswer2)
        },
        new
        {
            Index = 3,
            QuestionValue = security.Recovery.SecurityQuestion3 ?? string.Empty,
            CustomValue = security.Recovery.SecurityQuestion3Custom ?? string.Empty,
            AnswerValue = security.Recovery.SecurityAnswer3 ?? string.Empty,
            ShowCustom = showQuestion3Custom,
            HasError = question3HasError,
            HasValue = !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion3)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityQuestion3Custom)
                      || !string.IsNullOrWhiteSpace(security.Recovery.SecurityAnswer3)
        }
    };

    var maxQuestions = recoveryQuestions.Length;
    var initialCount = 0;
    for (var i = 0; i < recoveryQuestions.Length; i++)
    {
        var question = recoveryQuestions[i];
        if (question.HasValue || question.HasError)
        {
            initialCount = i + 1;
        }
    }

    var hasExistingQuestions = initialCount > 0;
    if (!hasExistingQuestions)
    {
        initialCount = 1;
    }

    var initialActive = -1;
    for (var i = 0; i < recoveryQuestions.Length; i++)
    {
        if (recoveryQuestions[i].HasError)
        {
            initialActive = i;
            break;
        }
    }

    if (initialActive < 0 && initialCount > 0)
    {
        initialActive = initialCount - 1;
    }

    var serverVisibleCount = 0;
    for (var i = 0; i < recoveryQuestions.Length; i++)
    {
        if (recoveryQuestions[i].HasValue || recoveryQuestions[i].HasError)
        {
            serverVisibleCount = i + 1;
        }
    }

    var initialQuestionsEnabled = security.HasRecoveryConfigured || hasExistingQuestions;
    var enabled = initialQuestionsEnabled || serverVisibleCount > 0;
    if (!hasExistingQuestions)
    {
        enabled = true;
    }

    var visibleCount = 0;
    if (enabled)
    {
        var maxVisible = Math.Max(Math.Max(initialCount, serverVisibleCount), 1);
        visibleCount = Math.Min(maxVisible, maxQuestions);
    }

    var activeIndex = enabled ? initialActive : -1;
    if (enabled)
    {
        if (activeIndex < 0 && serverVisibleCount > 0)
        {
            activeIndex = Math.Min(serverVisibleCount - 1, visibleCount - 1);
        }

        if (activeIndex < 0 && visibleCount > 0)
        {
            activeIndex = visibleCount - 1;
        }
    }
    else
    {
        activeIndex = -1;
    }

    var hasActive = enabled && activeIndex >= 0 && activeIndex < visibleCount;
    var hasAnswers = false;
    for (var i = 0; i < visibleCount; i++)
    {
        if (recoveryQuestions[i].HasValue)
        {
            hasAnswers = true;
            break;
        }
    }

    var emptyHintHidden = enabled && visibleCount > 0 && (hasAnswers || hasActive);
    var listHidden = !enabled;

    var questionStates = recoveryQuestions.Select((question, index) =>
    {
        var state = "hidden";
        if (enabled && index < visibleCount)
        {
            state = hasActive && index == activeIndex ? "active" : "collapsed";
        }

        if (state == "collapsed" && !question.HasValue && !question.HasError)
        {
            state = "active";
        }

        var isVisible = state != "hidden";
        var isActive = state == "active";
        var isCollapsed = state == "collapsed" && question.HasValue;
        var isComplete = isVisible && !isActive && question.HasValue;

        return new
        {
            question.Index,
            question.QuestionValue,
            question.CustomValue,
            question.AnswerValue,
            question.ShowCustom,
            question.HasError,
            question.HasValue,
            IsVisible = isVisible,
            IsActive = isActive,
            IsCollapsed = isCollapsed,
            IsComplete = isComplete,
            ShowSummary = isCollapsed,
            ShowBody = isActive
        };
    }).ToArray();

    var questionState1 = questionStates[0];
    var questionState2 = questionStates[1];
    var questionState3 = questionStates[2];

    var securityQuestionsTooltip = string.Join("\n", new[]
    {
        L["Auth_Register_SecurityQuestions_Info"].Value,
        L["Auth_SecurityQuestions_CaseInsensitiveHint"].Value
    }
        .Where(hint => !string.IsNullOrWhiteSpace(hint))
        .Select(hint => $"• {hint}"));

}

<section class="profile-shell" data-profile-root>
    <header class="profile-hero" style="--rank-accent:@rank.AccentColor; --rank-highlight:@rank.AccentHighlightColor; --rank-glow:@rank.AccentGlowColor;">
        
        <div class="@heroCoreClass">
            
            <div class="@identityClass">
                <div class="profile-hero__avatar"
                     data-profile-avatar
                     data-has-avatar="@(profile.HasAvatar ? "true" : "false")"
                     data-avatar-alt="@L["Dashboard_Profile_CurrentAvatar"].Value"
                     data-avatar-placeholder="@L["Dashboard_Profile_NoAvatar"].Value">
                    @if (profile.HasAvatar)
                    {
                        <img src="@profile.AvatarUrl" alt="@L["Dashboard_Profile_CurrentAvatar"].Value" data-profile-avatar-preview />
                    }
                    else
                    {
                        <span class="profile-hero__avatar-placeholder avatar-placeholder"
                              data-profile-avatar-preview
                              role="img"
                              aria-label="@L["Dashboard_Profile_NoAvatar"].Value"></span>
                    }
                    <button type="button"
                            class="profile-hero__avatar-overlay"
                            data-profile-avatar-trigger
                            aria-label="@L["Dashboard_Profile_Avatar_Change"].Value">
                        <span class="profile-hero__avatar-overlay-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 7.5h3l1.5-2h7L17 7.5h3a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2v-8a2 2 0 012-2z" />
                                <circle cx="12" cy="12.5" r="3.25" />
                            </svg>
                        </span>
                        <span class="profile-hero__avatar-overlay-label" data-avatar-overlay-label>@L["Dashboard_Profile_Avatar_Set"].Value</span>
                    </button>
                </div>
                <div class="profile-hero__summary">
                    <span class="profile-hero__badge" data-rank-pulse>@rank.DisplayName</span>
                    <h2 class="profile-hero__name">@profile.DisplayName</h2>
                    <p class="profile-hero__xp">@string.Format(L["Dashboard_Profile_Rank_TotalXp"].Value, rank.ExperiencePoints)</p>
                    <div class="profile-progress" data-profile-progress>
                        <div class="profile-progress__track">
                            <div class="profile-progress__fill" style="width:@rank.ProgressPercent%"></div>
                        </div>
                        <div class="profile-progress__meta">
                            <span>@string.Format(L["Dashboard_Profile_Rank_ProgressLabel"].Value, rank.XpIntoCurrent, rank.XpRequiredForNext)</span>
                        </div>
                    </div>
                </div>
            </div>
            @if (hasRankTrophy)
            {
                <div class="profile-hero__trophy-block" aria-label="@L["Dashboard_Profile_Rank_CurrentTrophy"].Value">
                    <div class="profile-hero__trophy-frame" data-profile-trophy>
                        <img src="@rank.TrophyImage" alt="@L["Dashboard_Profile_Rank_CurrentTrophy"].Value" class="profile-hero__trophy" />
                    </div>
                </div>
            }
        </div>
       
    </header>

    @if (!profile.HasAvatar)
    {
        <div class="profile-banner" role="note">
            <div>
                <h3>@L["Dashboard_Profile_Hero_NoAvatar_Title"].Value</h3>
                <p>@L["Dashboard_Profile_Hero_NoAvatar_Body"].Value</p>
            </div>
            <button type="button" class="btn-primary btn-small" data-profile-avatar-trigger>@L["Dashboard_Profile_Hero_NoAvatar_Cta"].Value</button>
        </div>
    }

    @if (goals.Count > 0)
    {
        <section class="profile-goals" aria-labelledby="profileGoalsTitle">
            <div class="profile-section-heading">
                <h3 id="profileGoalsTitle">@L["Dashboard_Profile_Goals_Title"].Value</h3>
                <span>@L["Dashboard_Profile_Goals_Subtitle"].Value</span>
            </div>
            <div class="profile-goals__list">
                @foreach (var goal in goals)
                {
                    <article class="profile-goal@(goal.IsCompleted ? " is-complete" : string.Empty)">
                        <div class="profile-goal__status" aria-hidden="true">
                            @(goal.IsCompleted ? "✔" : "○")
                        </div>
                        <div class="profile-goal__content">
                            <h4>@goal.Title</h4>
                            <p>@goal.Description</p>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (highlights.Count > 0)
    {
        <section class="profile-insights" aria-labelledby="profileInsightsTitle">
            <div class="profile-section-heading">
                <h3 id="profileInsightsTitle">@L["Dashboard_Profile_Insights_Title"].Value</h3>
                <span>@L["Dashboard_Profile_Insights_Subtitle"].Value</span>
            </div>
            <div class="profile-insights__list">
                @foreach (var highlight in highlights)
                {
                    <article class="profile-insight">
                        <h4>@highlight.Title</h4>
                        <p>@highlight.Description</p>
                    </article>
                }
            </div>
        </section>
    }

    <nav class="profile-local-nav" role="tablist">
        @foreach (var navSection in sections)
        {
            var isActive = string.Equals(navSection.Id, selectedPanel, StringComparison.OrdinalIgnoreCase);
            var panelDomId = $"profilePanel_{navSection.Id}";
            var tabDomId = $"profileTab_{navSection.Id}";
            <button type="button"
                    id="@tabDomId"
                    class="profile-local-nav__item@(isActive ? " is-active" : string.Empty)"
                    role="tab"
                    data-profile-nav="@navSection.Id"
                    aria-controls="@panelDomId"
                    aria-selected="@(isActive ? "true" : "false")"
                    tabindex="@(isActive ? "0" : "-1")">
                @navSection.Label
            </button>
        }
    </nav>

    <div class="profile-accordion" data-profile-accordion>
        <form asp-action="UpdateProfile"
              method="post"
              enctype="multipart/form-data"
              class="profile-editor"
              data-profile-form
              data-selected-panel="@selectedPanel"
              data-display-name-can-request="@(canRequestDisplayNameChange ? "true" : "false")"
              data-display-name-pending="@(hasPendingDisplayName ? "true" : "false")"
              data-display-name-blocked-message="@displayNameBlockedMessage"
              data-display-name-blocked-template="@displayNameBlockedTemplate"
              data-display-name-blocked-generic="@displayNameBlockedGeneric"
              data-display-name-confirm-message="@displayNameConfirmMessage"
              data-display-name-pending-template="@displayNamePendingTemplate"
              data-saving-text="@L["Dashboard_Profile_Status_Saving"].Value"
              data-saved-text="@L["Dashboard_Profile_Status_Saved"].Value"
              data-error-text="@L["Dashboard_Profile_Status_Error"].Value"
              data-toast-success="@L["Dashboard_Success_Profile"].Value"
              data-display-name-agreement-error="@L["Dashboard_Profile_DisplayName_ConfirmAgreementError"].Value"
              data-display-name-password-error="@L["Dashboard_Profile_DisplayName_ConfirmPasswordError"].Value"
              data-initial-language="@(!string.IsNullOrWhiteSpace(preferences.PreferredLanguage) ? preferences.PreferredLanguage : "system")"
              data-initial-theme="@(!string.IsNullOrWhiteSpace(preferences.PreferredTheme) ? preferences.PreferredTheme : "system")">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, null, new { @class = "val-summary" })
            @{
                var profilePanelId = "profilePanel_profile"; var profileTabId = "profileTab_profile"; var profileHeadingId = "profileHeading_profile"; var profileActive = IsPanelActive("profile");
            }
            <section class="profile-section@(profileActive ? " is-open" : string.Empty)"
                     data-profile-panel="profile"
                     id="@profilePanelId"
                     role="tabpanel"
                     aria-labelledby="@profileTabId" @Html.Raw(GetPanelAttributes("profile"))>
                <header class="profile-section__header">
                    <h3 id="@profileHeadingId" tabindex="-1">@L["Dashboard_Profile_ProfileSection_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_ProfileSection_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label for="DisplayName">@L["Dashboard_Profile_DisplayName"].Value</label>
                        <input id="DisplayName" name="DisplayName" value="@profile.DisplayName" maxlength="120" autocomplete="nickname" />
                        <div class="form-hint form-hint--warning@(hasPendingDisplayName ? string.Empty : " is-hidden")" data-display-name-pending-hint>@pendingDisplayNameMessage</div>
                        @Html.ValidationMessage("DisplayName", null, new { @class = "val" })
                        @Html.ValidationMessage("DisplayNamePassword", null, new { @class = "val" })
                        <input type="hidden" id="DisplayNamePasswordField" name="DisplayNamePassword" />
                    </div>

                    <div class="form-field form-field--row" data-profile-field>
                        <label>@L["Dashboard_Profile_BirthDate"].Value</label>
                        <div class="form-field__row">
                            <select id="BirthMonth" name="BirthMonth" data-original-value="@(profile.BirthMonth?.ToString() ?? string.Empty)">
                                <option value="">@L["Dashboard_Profile_BirthDate_MonthPlaceholder"].Value</option>
                                @foreach (var month in months)
                                {
                                    var isSelected = month.Value == profile.BirthMonth;
                                    <option value="@month.Value" selected="@(isSelected ? "selected" : null)">@month.Name</option>
                                }
                            </select>
                            <select id="BirthDay" name="BirthDay" data-original-value="@(profile.BirthDay?.ToString() ?? string.Empty)">
                                <option value="">@L["Dashboard_Profile_BirthDate_DayPlaceholder"].Value</option>
                                @foreach (var day in days)
                                {
                                    var isSelected = day == profile.BirthDay;
                                    <option value="@day" selected="@(isSelected ? "selected" : null)">@day</option>
                                }
                            </select>
                        </div>
                        <div class="form-hint">@L["Dashboard_Profile_BirthDate_Hint"].Value</div>
                        @Html.ValidationMessage("BirthMonth", null, new { @class = "val" })
                        @Html.ValidationMessage("BirthDay", null, new { @class = "val" })
                    </div>

                    <div class="form-field form-field--stack" data-profile-field>
                        <label>@L["Dashboard_Profile_Avatar"].Value</label>
                        <div class="avatar-dropzone" data-profile-avatar-drop>
                            <input id="Avatar" name="Avatar" type="file" accept="image/png,image/jpeg,image/jpg" data-profile-avatar-input />
                            <div class="avatar-dropzone__hint">
                                <strong>@L["Dashboard_Profile_Avatar_FormatTitle"].Value</strong>
                                <span>@L["Dashboard_Profile_Avatar_FormatDescription"].Value</span>
                                <button type="button" class="btn-ghost btn-small" data-profile-avatar-trigger>@L["Dashboard_Profile_Avatar_Change"].Value</button>
                            </div>
                        </div>
                        <div class="form-hint">@L["Dashboard_Profile_Avatar_Hint"].Value</div>
                        @Html.ValidationMessage("Avatar", null, new { @class = "val" })
                    </div>
                </div>
            </section>

            @{
                var privacyPanelId = "profilePanel_privacy"; var privacyTabId = "profileTab_privacy"; var privacyHeadingId = "profileHeading_privacy"; var privacyActive = IsPanelActive("privacy");
            }
            <section class="profile-section@(privacyActive ? " is-open" : string.Empty)"
                     data-profile-panel="privacy"
                     id="@privacyPanelId"
                     role="tabpanel"
                     aria-labelledby="@privacyTabId" @Html.Raw(GetPanelAttributes("privacy"))>
                <header class="profile-section__header">
                    <h3 id="@privacyHeadingId" tabindex="-1">@L["Dashboard_Profile_Privacy_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_Privacy_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_DisplayNameVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_DisplayNameVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"DisplayNameVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.DisplayNameVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="DisplayNameVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_BirthDateVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_BirthDateVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"BirthDateVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.BirthDateVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="BirthDateVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_EmailVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_EmailVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"EmailVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.EmailVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="EmailVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                </div>
            </section>

            @{
                var preferencesPanelId = "profilePanel_preferences"; var preferencesTabId = "profileTab_preferences"; var preferencesHeadingId = "profileHeading_preferences"; var preferencesActive = IsPanelActive("preferences");
            }
            <section class="profile-section@(preferencesActive ? " is-open" : string.Empty)"
                     data-profile-panel="preferences"
                     id="@preferencesPanelId"
                     role="tabpanel"
                     aria-labelledby="@preferencesTabId" @Html.Raw(GetPanelAttributes("preferences"))>
                <header class="profile-section__header">
                    <h3 id="@preferencesHeadingId" tabindex="-1">@L["Dashboard_Profile_Preferences_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_Preferences_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label for="PreferredLanguage">@L["Dashboard_Profile_Preferences_Language"].Value</label>
                        <select id="PreferredLanguage" name="PreferredLanguage">
                            @foreach (var option in preferences.LanguageOptions)
                            {
                                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label for="PreferredTheme">@L["Dashboard_Profile_Preferences_Theme"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_Preferences_Theme"].Value">
                            @foreach (var option in preferences.ThemeOptions)
                            {
                                var optionId = $"PreferredTheme_{option.Value}";
                                <input type="radio" id="@optionId" name="PreferredTheme" value="@option.Value" @(option.Selected ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field form-field--toggle" data-profile-field>
                        <input type="hidden" name="EnableEmailNotifications" value="false" />
                        <input type="checkbox" id="EnableEmailNotifications" name="EnableEmailNotifications" value="true" @(preferences.EnableEmailNotifications ? "checked" : null) />
                        <label for="EnableEmailNotifications">@L["Dashboard_Profile_Preferences_Email"].Value</label>
                    </div>
                    <div class="form-field form-field--toggle" data-profile-field>
                        <input type="hidden" name="EnableFriendInvites" value="false" />
                        <input type="checkbox" id="EnableFriendInvites" name="EnableFriendInvites" value="true" @(preferences.EnableFriendInvites ? "checked" : null) />
                        <label for="EnableFriendInvites">@L["Dashboard_Profile_Preferences_Invites"].Value</label>
                    </div>
                </div>
            </section>
        <div class="profile-action-bar" data-profile-actions>
                <div class="profile-action-bar__status" data-profile-status>@L["Dashboard_Profile_Status_Idle"].Value</div>
                <div class="profile-action-bar__buttons">
                    <button type="button" class="btn-outline" data-profile-cancel>@L["Dashboard_Profile_Action_Cancel"].Value</button>
                    <button type="submit" class="btn-primary" data-profile-save>@L["Dashboard_Profile_Action_Save"].Value</button>
                </div>
            </div>
        </form>

    @{
        var securityPanelId = "profilePanel_security"; var securityTabId = "profileTab_security"; var securityHeadingId = "profileHeading_security"; var securityActive = IsPanelActive("security");
    }
    <section class="profile-section@(securityActive ? " is-open" : string.Empty)"
             data-profile-panel="security"
             id="@securityPanelId"
             role="tabpanel"
             aria-labelledby="@securityTabId" @Html.Raw(GetPanelAttributes("security"))>
        <header class="profile-section__header">
            <h3 id="@securityHeadingId" tabindex="-1">@L["Dashboard_Profile_Security_Title"].Value</h3>
            <p>@L["Dashboard_Profile_Security_Subtitle"].Value</p>
        </header>
        <div class="profile-section__body profile-section__body--columns">
            <div class="profile-column">
                <article class="profile-card">
                    <h4>@L["Dashboard_Profile_EmailTitle"].Value</h4>
                    <p>@string.Format(L["Dashboard_Profile_EmailDescription"].Value, security.Email)</p>
                    <form asp-action="UpdateEmail" method="post" class="profile-form" data-profile-security-form>
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })
                        <label for="Email">@L["Dashboard_Security_Email"].Value</label>
                        <input id="Email" name="Email" type="email" value="@security.Email" autocomplete="email" class="form-control-sm" />
                        @Html.ValidationMessage("Email", null, new { @class = "val" })

                        <label for="EmailPassword">@L["Dashboard_Security_EmailPassword"].Value</label>
                        <input id="EmailPassword" name="Password" type="password" autocomplete="current-password" class="form-control-sm" />
                        @Html.ValidationMessage("Password", null, new { @class = "val" })

                        <button class="btn-primary" type="submit">@L["Dashboard_Profile_Security_SaveEmail"].Value</button>
                    </form>
                </article>

                <article class="profile-card">
                    <h4>@L["Dashboard_Profile_PasswordTitle"].Value</h4>
                    <p>@L["Dashboard_Profile_PasswordDescription"].Value</p>
                    <form asp-action="ChangePassword" method="post" class="profile-form" data-profile-security-form>
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                        <label for="CurrentPassword">@L["Dashboard_Security_CurrentPassword"].Value</label>
                        <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" class="form-control-sm" />
                        @Html.ValidationMessage("CurrentPassword", null, new { @class = "val" })

                        <label for="NewPassword">@L["Dashboard_Security_NewPassword"].Value</label>
                        <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" class="form-control-sm" />
                        @Html.ValidationMessage("NewPassword", null, new { @class = "val" })

                        <label for="ConfirmPassword">@L["Dashboard_Security_ConfirmPassword"].Value</label>
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" class="form-control-sm" />
                        @Html.ValidationMessage("ConfirmPassword", null, new { @class = "val" })

                        <button class="btn-primary" type="submit">@L["Dashboard_Profile_Security_SavePassword"].Value</button>
                    </form>
                </article>
            </div>

            <div class="profile-column">
                <article class="profile-card profile-card--recovery">
                    <h4>@L["Dashboard_Profile_Recovery_Title"].Value</h4>
                    <p>@L["Dashboard_Profile_Recovery_Subtitle"].Value</p>
                        <form asp-action="UpdateRecoveryQuestions"
                              method="post"
                              class="profile-form"
                              data-profile-security-form
                              data-recovery-questions-form
                              data-recovery-confirm-message="@L["Dashboard_Profile_Recovery_ConfirmMessage"].Value"
                              data-recovery-password-required="@L["Dashboard_Profile_Recovery_ConfirmPasswordRequired"].Value">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, null, new { @class = "val-summary" })
                        <input type="hidden" name="HasExistingAnswer1" value="@security.Recovery.HasSecurityAnswer1" />
                        <input type="hidden" name="HasExistingAnswer2" value="@security.Recovery.HasSecurityAnswer2" />
                        <input type="hidden" name="HasExistingAnswer3" value="@security.Recovery.HasSecurityAnswer3" />

                        <div class="security-questions@(enabled ? string.Empty : " security-questions--disabled")"
                             data-security-questions
                             data-custom-option="@SecurityQuestionCatalog.CustomKey"
                             data-questions-layout="expanded"
                             data-answer-minlength="3"
                             data-question-minlength="5"
                             data-max-questions="3"
                             data-initial-count="@initialCount"
                             data-initial-active="@activeIndex"
                             data-initial-enabled="@((enabled ? "true" : "false"))"
                             data-label-add-first="@L["Auth_Register_SecurityQuestions_AddFirst"].Value"
                             data-label-add-next="@L["Auth_Register_SecurityQuestions_AddAnother"].Value"
                             data-message-question-required="@L["Auth_Register_SecurityQuestions_SelectRequired"].Value"
                             data-message-custom-min="@L["Auth_Register_SecurityQuestions_Custom_MinLength"].Value"
                             data-message-answer-min="@L["Auth_SecurityQuestions_Answer_MinLength"].Value"
                             data-message-answer-common="@L["Auth_SecurityQuestions_Answer_Common"].Value"
                             data-message-answer-matches="@L["Auth_SecurityQuestions_Answer_MatchesQuestion"].Value">
                            <div class="security-questions__header">
                                <div class="security-questions__heading">
                                    <div class="security-questions__title">
                                        <h3 class="form-label-with-hint">
                                            <span>@L["Auth_Register_SecurityQuestions_Title"].Value</span>
                                            <button type="button"
                                                    class="info-hint"
                                                    data-tooltip="@securityQuestionsTooltip"
                                                    title="@securityQuestionsTooltip"
                                                    aria-label="@securityQuestionsTooltip">
                                                i
                                            </button>
                                        </h3>
                                            <p class="security-questions__description">@L["Auth_Register_SecurityQuestions_MaxHint"].Value</p>
                                    </div>
                                </div>
                                <p class="security-questions__empty" data-empty-hint @((emptyHintHidden ? " hidden" : string.Empty))>@L["Auth_Register_SecurityQuestions_EmptyState"].Value</p>
                               
                            </div>

                            <div class="security-questions__list" data-question-list @((listHidden ? " hidden" : string.Empty))>
                                @for (var i = 0; i < questionStates.Length; i++)
                                {
                                    var state = questionStates[i];
                                    var question = recoveryQuestions[i];
                                    var questionNumber = state.Index;
                                    var selectId = $"SecurityQuestion{questionNumber}";
                                    var bodyId = $"SecurityQuestion{questionNumber}Body";
                                    var customId = $"SecurityQuestion{questionNumber}Custom";
                                    var answerId = $"SecurityAnswer{questionNumber}";
                                    var questionKey = question.QuestionValue;
                                    var isCustomSelected = string.Equals(questionKey, SecurityQuestionCatalog.CustomKey, StringComparison.OrdinalIgnoreCase);
                                    var questionHasError = state.HasError ? "true" : "false";
                                    <div class="security-question@(state.IsActive ? " is-active" : string.Empty)@(state.IsCollapsed ? " is-collapsed" : string.Empty)@(state.IsComplete ? " is-complete" : string.Empty)"
                                         data-question-item
                                         data-question-index="@questionNumber"
                                         data-has-error="@questionHasError" @((state.IsVisible ? string.Empty : " hidden"))>
                                       
                                        <div class="security-question__body" id="@bodyId" data-question-body @((state.ShowBody ? string.Empty : " hidden"))>
                                            <div class="security-question__fields">
                                                <div>
                                                    <label for="@selectId">@string.Format(L["Dashboard_Profile_Recovery_QuestionLabel"].Value, questionNumber)</label>
                                                    <select id="@selectId" name="SecurityQuestion@questionNumber" data-question-select data-custom-option="@SecurityQuestionCatalog.CustomKey">
                                                        <option value="">@L["Auth_Register_SecurityQuestions_Select"].Value</option>
                                                        @foreach (var option in security.Recovery.SecurityQuestionOptions)
                                                        {
                                                            var isCustom = string.Equals(option.Key, SecurityQuestionCatalog.CustomKey, StringComparison.Ordinal);
                                                            if (!isCustom)
                                                            {
                                                                var isSelected = string.Equals(option.Key, questionKey, StringComparison.OrdinalIgnoreCase);
                                                                <option value="@option.Key" data-allows-multiple="@(option.AllowsCustomPrompt ? "true" : "false")" selected="@(isSelected ? "selected" : null)">@option.Label</option>
                                                            }
                                                        }
                                                        <option value="@SecurityQuestionCatalog.CustomKey" data-custom="true" data-allows-multiple="true" selected="@(isCustomSelected ? "selected" : null)">@L["Auth_Register_SecurityQuestions_Custom"].Value</option>
                                                    </select>
                                                    @Html.ValidationMessage($"SecurityQuestion{questionNumber}", null, new { @class = "val", data_error_question = string.Empty })
                                                </div>
                                                <div class="security-question__custom-group" data-custom-container @((question.ShowCustom ? string.Empty : " hidden"))>
                                                    <label class="sr-only" for="@customId">@L["Auth_Register_SecurityQuestions_Custom"].Value</label>
                                                    <input id="@customId" name="SecurityQuestion@questionNumber@("Custom")" value="@question.CustomValue" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" />
                                                    @Html.ValidationMessage($"SecurityQuestion{questionNumber}Custom", null, new { @class = "val", data_error_custom = string.Empty })
                                                </div>
                                                <div>
                                                    <input id="@answerId" name="SecurityAnswer@questionNumber" value="@question.AnswerValue" type="text" autocomplete="off" data-answer-input minlength="3" />
                                                    @Html.ValidationMessage($"SecurityAnswer{questionNumber}", null, new { @class = "val", data_error_answer = string.Empty })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                        <div class="form-actions">
                            <input id="RecoveryPassword" name="Password" type="hidden" />
                            @Html.ValidationMessage("Password", null, new { @class = "val" })
                            <button type="button" class="btn-outline" data-questions-add>@L["Auth_Register_SecurityQuestions_AddFirst"].Value</button>
                            <button class="btn-primary" type="submit" data-questions-save hidden>@L["Dashboard_Profile_Recovery_Save"].Value</button>
                        </div>
                    </form>
                </article>
                <article class="profile-card profile-card--sessions">
                    <h4>@L["Dashboard_Profile_Sessions_Title"].Value</h4>
                    <p>@L["Dashboard_Profile_Sessions_Description"].Value</p>
                    <ul class="profile-sessions" role="list">
                        <li class="profile-session">
                            <div>
                                <strong>@L["Dashboard_Profile_Sessions_Current"].Value</strong>
                                <span>@Context.Request.Headers["User-Agent"].FirstOrDefault()</span>
                            </div>
                            <span class="profile-session__badge">@L["Dashboard_Profile_Sessions_Active"].Value</span>
                        </li>
                    </ul>
                    <form asp-action="SignOutEverywhere" method="post" class="profile-sessions__actions">
                        @Html.AntiForgeryToken()
                        <button class="btn-outline" type="submit">@L["Dashboard_Profile_Sessions_SignOutAll"].Value</button>
                    </form>
                </article>
            </div>
        </div>
    </section>
    </div>

    <div class="toast-stack profile-toast-stack" id="profileToastStack" aria-live="polite" aria-atomic="true"></div>

    <section class="profile-modals" aria-hidden="true">
        <div class="modal" id="displayNameConfirmModal" hidden data-profile-displayname-modal>
            <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="displayNameConfirmTitle">
                <header class="modal__header">
                    <h3 id="displayNameConfirmTitle">@L["Dashboard_Profile_DisplayName_ConfirmTitle"].Value</h3>
                </header>
                <div class="modal__body">
                    <p class="modal__message" data-modal-message>@L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value</p>
                    <p class="modal__warning" data-modal-warning hidden></p>
                    <div class="modal__field" data-modal-agreement>
                        <input type="checkbox" id="displayNameConfirmAgree" />
                        <label for="displayNameConfirmAgree">@L["Dashboard_Profile_DisplayName_ConfirmAgreement"].Value</label>
                    </div>
                    <div class="modal__field" data-modal-password>
                        <label for="displayNameConfirmPassword">@L["Dashboard_Profile_DisplayName_ConfirmPasswordLabel"].Value</label>
                        <input type="password" id="displayNameConfirmPassword" autocomplete="current-password" />
                    </div>
                </div>
                <footer class="modal__footer">
                    <button type="button" class="btn-outline" data-modal-close>@L["Dashboard_Profile_DisplayName_ConfirmCancel"].Value</button>
                    <button type="button" class="btn-primary" data-modal-confirm>@L["Dashboard_Profile_DisplayName_ConfirmAccept"].Value</button>
                </footer>
            </div>
            <div class="modal__backdrop" data-modal-close></div>
        </div>

        <div class="modal" id="recoveryConfirmModal" hidden data-profile-recovery-modal>
            <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="recoveryConfirmTitle">
                <header class="modal__header">
                    <h3 id="recoveryConfirmTitle">@L["Dashboard_Profile_Recovery_ConfirmTitle"].Value</h3>
                </header>
                <div class="modal__body">
                    <p class="modal__message" data-recovery-modal-message>@L["Dashboard_Profile_Recovery_ConfirmMessage"].Value</p>
                    <p class="modal__warning" data-recovery-modal-warning hidden></p>
                    <div class="modal__field">
                        <label for="recoveryConfirmPassword">@L["Dashboard_Profile_Recovery_ConfirmPasswordLabel"].Value</label>
                        <input type="password" id="recoveryConfirmPassword" autocomplete="current-password" />
                    </div>
                </div>
                <footer class="modal__footer">
                    <button type="button" class="btn-outline" data-recovery-modal-close>@L["Dashboard_Profile_Recovery_ConfirmCancel"].Value</button>
                    <button type="button" class="btn-primary" data-recovery-modal-confirm>@L["Dashboard_Profile_Recovery_ConfirmSave"].Value</button>
                </footer>
            </div>
            <div class="modal__backdrop" data-recovery-modal-close></div>
        </div>

        <div class="modal" id="avatarCropModal" hidden data-profile-avatar-modal>
            <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="avatarCropTitle">
                <header class="modal__header">
                    <h3 id="avatarCropTitle">@L["Dashboard_Profile_Avatar_CropTitle"].Value</h3>
                </header>
                <div class="modal__body">
                    <div class="avatar-cropper" data-avatar-cropper>
                        <div class="avatar-cropper__viewport">
                            <img src="" alt="" data-avatar-crop-image />
                        </div>
                    </div>
                    <label for="avatarCropZoom" class="avatar-cropper__label">@L["Dashboard_Profile_Avatar_CropZoom"].Value</label>
                    <input type="range" id="avatarCropZoom" min="1" max="3" step="0.05" value="1" data-avatar-crop-zoom />
                </div>
                <footer class="modal__footer">
                    <button type="button" class="btn-outline" data-avatar-crop-cancel>@L["Dashboard_Profile_Avatar_CropCancel"].Value</button>
                    <button type="button" class="btn-primary" data-avatar-crop-confirm>@L["Dashboard_Profile_Avatar_CropConfirm"].Value</button>
                </footer>
            </div>
            <div class="modal__backdrop" data-avatar-crop-cancel></div>
        </div>
    </section>
</section>