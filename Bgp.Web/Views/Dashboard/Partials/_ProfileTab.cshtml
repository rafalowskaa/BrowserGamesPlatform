@using System.Globalization
@using System.Linq
@model (Bgp.Web.Models.DashboardViewModel Vm, string SelectedPanel)
@{
    var vm = Model.Vm;
    var profile = vm.Profile;
    var security = vm.Security;
    var preferences = vm.Preferences;
    var selectedPanel = string.IsNullOrWhiteSpace(Model.SelectedPanel) ? "profile" : Model.SelectedPanel;
    var rank = profile.Rank;
    var months = Enumerable.Range(1, 12)
        .Select(i => new { Value = i, Name = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames[i - 1] })
        .Select(m => new { m.Value, Name = string.IsNullOrWhiteSpace(m.Name) ? m.Value.ToString("00") : m.Name })
        .ToList();
    var days = Enumerable.Range(1, 31).ToList();
    var hasPendingDisplayName = !string.IsNullOrWhiteSpace(profile.PendingDisplayName);
    var changeAvailableAt = profile.DisplayNameChangeAvailableAtUtc;
    var displayNameBlockedTemplate = L["Dashboard_Profile_DisplayName_ConfirmBlocked"].Value;
    var displayNameBlockedGeneric = L["Dashboard_Profile_DisplayName_ConfirmBlocked_Generic"].Value;
    var displayNameConfirmMessage = L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value;
    var displayNamePendingTemplate = L["Dashboard_Profile_DisplayName_PendingInfo"].Value;
    var canRequestDisplayNameChange = !hasPendingDisplayName && (!changeAvailableAt.HasValue || changeAvailableAt.Value <= DateTime.UtcNow);
    var displayNameBlockedMessage = changeAvailableAt.HasValue
        ? string.Format(displayNameBlockedTemplate, changeAvailableAt.Value.ToLocalTime().ToString("f"))
        : displayNameBlockedGeneric;
    var pendingDisplayNameMessage = hasPendingDisplayName
        ? string.Format(displayNamePendingTemplate, profile.PendingDisplayName, profile.PendingDisplayNameRequestedAtUtc?.ToLocalTime().ToString("g"))
        : string.Empty;
    var displayNameLocked = hasPendingDisplayName || !canRequestDisplayNameChange;
    var goals = profile.DailyGoals.Take(3).ToList();
    var highlights = profile.Highlights.Take(3).ToList();
    var sections = new (string Id, string Label)[]
    {
        ("profile", L["Dashboard_Profile_Local_Profile"].Value),
        ("privacy", L["Dashboard_Profile_Local_Privacy"].Value),
        ("security", L["Dashboard_Profile_Local_Security"].Value),
        ("preferences", L["Dashboard_Profile_Local_Preferences"].Value)
    };
}

<section class="profile-shell" data-profile-root>
    <header class="profile-hero" style="--rank-accent:@rank.AccentColor; --rank-highlight:@rank.AccentHighlightColor; --rank-glow:@rank.AccentGlowColor;">
        <div class="profile-hero__decor profile-hero__decor--left" aria-hidden="true">
            @if (!string.IsNullOrEmpty(rank.TrophyImage))
            {
                <img src="@rank.TrophyImage" alt="" class="profile-hero__trophy" />
            }
        </div>
        <div class="profile-hero__core">
            <div class="profile-hero__badge" data-rank-pulse>
                <span class="profile-hero__badge-label">@rank.DisplayName</span>
            </div>
            <div class="profile-hero__identity">
                <div class="profile-hero__avatar" data-profile-avatar>
                    @if (profile.HasAvatar)
                    {
                        <img src="@profile.AvatarUrl" alt="@L["Dashboard_Profile_CurrentAvatar"].Value" data-profile-avatar-preview />
                    }
                    else
                    {
                        <span class="profile-hero__avatar-placeholder" data-profile-avatar-preview>@L["Dashboard_Profile_NoAvatar"].Value</span>
                    }
                    <div class="profile-hero__avatar-actions">
                        <label for="Avatar" class="btn-ghost btn-small profile-hero__avatar-button" data-profile-avatar-trigger>
                            <span class="btn-icon-leading" aria-hidden="true">🖼️</span>
                            @L["Dashboard_Profile_Avatar_Change"].Value
                        </label>
                    </div>
                </div>
                <div class="profile-hero__summary">
                    <h2 class="profile-hero__name">@profile.DisplayName</h2>
                    <p class="profile-hero__xp">@string.Format(L["Dashboard_Profile_Rank_TotalXp"].Value, rank.ExperiencePoints)</p>
                    <div class="profile-progress" data-profile-progress>
                        <div class="profile-progress__track">
                            <div class="profile-progress__fill" style="width:@rank.ProgressPercent%"></div>
                        </div>
                        <div class="profile-progress__meta">
                            <span>@string.Format(L["Dashboard_Profile_Rank_ProgressLabel"].Value, rank.XpIntoCurrent, rank.XpRequiredForNext)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="profile-hero__decor profile-hero__decor--right" aria-hidden="true">
            @if (!string.IsNullOrEmpty(rank.NextTrophyImage))
            {
                <img src="@rank.NextTrophyImage" alt="" class="profile-hero__trophy" />
            }
        </div>
    </header>

    @if (!profile.HasAvatar)
    {
        <div class="profile-banner" role="note">
            <div>
                <h3>@L["Dashboard_Profile_Hero_NoAvatar_Title"].Value</h3>
                <p>@L["Dashboard_Profile_Hero_NoAvatar_Body"].Value</p>
            </div>
            <button type="button" class="btn-primary btn-small" data-profile-avatar-trigger>@L["Dashboard_Profile_Hero_NoAvatar_Cta"].Value</button>
        </div>
    }

    @if (goals.Count > 0)
    {
        <section class="profile-goals" aria-labelledby="profileGoalsTitle">
            <div class="profile-section-heading">
                <h3 id="profileGoalsTitle">@L["Dashboard_Profile_Goals_Title"].Value</h3>
                <span>@L["Dashboard_Profile_Goals_Subtitle"].Value</span>
            </div>
            <div class="profile-goals__list">
                @foreach (var goal in goals)
                {
                    <article class="profile-goal@(goal.IsCompleted ? " is-complete" : string.Empty)">
                        <div class="profile-goal__status" aria-hidden="true">
                            @(goal.IsCompleted ? "✔" : "○")
                        </div>
                        <div class="profile-goal__content">
                            <h4>@goal.Title</h4>
                            <p>@goal.Description</p>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (highlights.Count > 0)
    {
        <section class="profile-insights" aria-labelledby="profileInsightsTitle">
            <div class="profile-section-heading">
                <h3 id="profileInsightsTitle">@L["Dashboard_Profile_Insights_Title"].Value</h3>
                <span>@L["Dashboard_Profile_Insights_Subtitle"].Value</span>
            </div>
            <div class="profile-insights__list">
                @foreach (var highlight in highlights)
                {
                    <article class="profile-insight">
                        <h4>@highlight.Title</h4>
                        <p>@highlight.Description</p>
                    </article>
                }
            </div>
        </section>
    }

    <nav class="profile-local-nav" role="tablist">
        @foreach (var navSection in sections)
        {
            var isActive = string.Equals(navSection.Id, selectedPanel, StringComparison.OrdinalIgnoreCase);
            <button type="button"
                    class="profile-local-nav__item@(isActive ? " is-active" : string.Empty)"
                    role="tab"
                    data-profile-nav="@navSection.Id"
                    aria-selected="@(isActive ? "true" : "false")">
                @navSection.Label
            </button>
        }
    </nav>

    <form asp-action="UpdateProfile"
          method="post"
          enctype="multipart/form-data"
          class="profile-editor"
          data-profile-form
          data-selected-panel="@selectedPanel"
          data-display-name-can-request="@(canRequestDisplayNameChange ? "true" : "false")"
          data-display-name-pending="@(hasPendingDisplayName ? "true" : "false")"
          data-display-name-blocked-message="@displayNameBlockedMessage"
          data-display-name-blocked-template="@displayNameBlockedTemplate"
          data-display-name-blocked-generic="@displayNameBlockedGeneric"
          data-display-name-confirm-message="@displayNameConfirmMessage"
          data-display-name-pending-template="@displayNamePendingTemplate"
          data-saving-text="@L["Dashboard_Profile_Status_Saving"].Value"
          data-saved-text="@L["Dashboard_Profile_Status_Saved"].Value"
          data-error-text="@L["Dashboard_Profile_Status_Error"].Value"
          data-display-name-agreement-error="@L["Dashboard_Profile_DisplayName_ConfirmAgreementError"].Value"
          data-display-name-password-error="@L["Dashboard_Profile_DisplayName_ConfirmPasswordError"].Value">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, null, new { @class = "val-summary" })

        <div class="profile-accordion" data-profile-accordion>
            <section class="profile-section@(selectedPanel == "profile" ? " is-open" : string.Empty)" data-profile-panel="profile">
                <header class="profile-section__header">
                    <h3>@L["Dashboard_Profile_ProfileSection_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_ProfileSection_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label for="DisplayName">@L["Dashboard_Profile_DisplayName"].Value</label>
                        <input id="DisplayName" name="DisplayName" value="@profile.DisplayName" maxlength="120" autocomplete="nickname" />
                        <div class="form-hint form-hint--warning@(hasPendingDisplayName ? string.Empty : " is-hidden")" data-display-name-pending-hint>@pendingDisplayNameMessage</div>
                        @Html.ValidationMessage("DisplayName", null, new { @class = "val" })
                        @Html.ValidationMessage("DisplayNamePassword", null, new { @class = "val" })
                        <input type="hidden" id="DisplayNamePasswordField" name="DisplayNamePassword" />
                    </div>

                    <div class="form-field form-field--row" data-profile-field>
                        <label>@L["Dashboard_Profile_BirthDate"].Value</label>
                        <div class="form-field__row">
                            <select id="BirthMonth" name="BirthMonth" data-original-value="@(profile.BirthMonth?.ToString() ?? string.Empty)">
                                <option value="">@L["Dashboard_Profile_BirthDate_MonthPlaceholder"].Value</option>
                                @foreach (var month in months)
                                {
                                    var isSelected = month.Value == profile.BirthMonth;
                                    <option value="@month.Value" selected="@(isSelected ? "selected" : null)">@month.Name</option>
                                }
                            </select>
                            <select id="BirthDay" name="BirthDay" data-original-value="@(profile.BirthDay?.ToString() ?? string.Empty)">
                                <option value="">@L["Dashboard_Profile_BirthDate_DayPlaceholder"].Value</option>
                                @foreach (var day in days)
                                {
                                    var isSelected = day == profile.BirthDay;
                                    <option value="@day" selected="@(isSelected ? "selected" : null)">@day</option>
                                }
                            </select>
                        </div>
                        <div class="form-hint">@L["Dashboard_Profile_BirthDate_Hint"].Value</div>
                        @Html.ValidationMessage("BirthMonth", null, new { @class = "val" })
                        @Html.ValidationMessage("BirthDay", null, new { @class = "val" })
                    </div>

                    <div class="form-field form-field--stack" data-profile-field>
                        <label>@L["Dashboard_Profile_Avatar"].Value</label>
                        <div class="avatar-dropzone" data-profile-avatar-drop>
                            <input id="Avatar" name="Avatar" type="file" accept="image/png,image/jpeg,image/jpg" data-profile-avatar-input />
                            <div class="avatar-dropzone__hint">
                                <strong>@L["Dashboard_Profile_Avatar_FormatTitle"].Value</strong>
                                <span>@L["Dashboard_Profile_Avatar_FormatDescription"].Value</span>
                                <button type="button" class="btn-ghost btn-small" data-profile-avatar-trigger>@L["Dashboard_Profile_Avatar_Change"].Value</button>
                            </div>
                        </div>
                        <div class="form-hint">@L["Dashboard_Profile_Avatar_Hint"].Value</div>
                        @Html.ValidationMessage("Avatar", null, new { @class = "val" })
                    </div>
                </div>
            </section>

            <section class="profile-section@(selectedPanel == "privacy" ? " is-open" : string.Empty)" data-profile-panel="privacy">
                <header class="profile-section__header">
                    <h3>@L["Dashboard_Profile_Privacy_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_Privacy_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_DisplayNameVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_DisplayNameVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"DisplayNameVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.DisplayNameVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="DisplayNameVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_BirthDateVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_BirthDateVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"BirthDateVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.BirthDateVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="BirthDateVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label>@L["Dashboard_Profile_EmailVisibility"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_EmailVisibility"].Value">
                            @foreach (var option in profile.VisibilityOptions)
                            {
                                var optionId = $"EmailVisibility_{option.Value}";
                                var isChecked = option.Value == ((int)profile.EmailVisibility).ToString(CultureInfo.InvariantCulture);
                                <input type="radio" id="@optionId" name="EmailVisibility" value="@option.Value" @(isChecked ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-section@(selectedPanel == "security" ? " is-open" : string.Empty)" data-profile-panel="security">
                <header class="profile-section__header">
                    <h3>@L["Dashboard_Profile_Security_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_Security_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body profile-section__body--columns">
                    <div class="profile-column">
                        <article class="profile-card">
                            <h4>@L["Dashboard_Profile_EmailTitle"].Value</h4>
                            <p>@string.Format(L["Dashboard_Profile_EmailDescription"].Value, security.Email)</p>
                            <form asp-action="UpdateEmail" method="post" class="profile-form" data-profile-security-form>
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, null, new { @class = "val-summary" })
                                <label for="Email">@L["Dashboard_Security_Email"].Value</label>
                                <input id="Email" name="Email" type="email" value="@security.Email" autocomplete="email" />
                                @Html.ValidationMessage("Email", null, new { @class = "val" })

                                <label for="EmailPassword">@L["Dashboard_Security_EmailPassword"].Value</label>
                                <input id="EmailPassword" name="Password" type="password" autocomplete="current-password" />
                                @Html.ValidationMessage("Password", null, new { @class = "val" })

                                <button class="btn-primary" type="submit">@L["Dashboard_Profile_Security_SaveEmail"].Value</button>
                            </form>
                        </article>

                        <article class="profile-card">
                            <h4>@L["Dashboard_Profile_PasswordTitle"].Value</h4>
                            <p>@L["Dashboard_Profile_PasswordDescription"].Value</p>
                            <form asp-action="ChangePassword" method="post" class="profile-form" data-profile-security-form>
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                                <label for="CurrentPassword">@L["Dashboard_Security_CurrentPassword"].Value</label>
                                <input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" />
                                @Html.ValidationMessage("CurrentPassword", null, new { @class = "val" })

                                <label for="NewPassword">@L["Dashboard_Security_NewPassword"].Value</label>
                                <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" />
                                @Html.ValidationMessage("NewPassword", null, new { @class = "val" })

                                <label for="ConfirmPassword">@L["Dashboard_Security_ConfirmPassword"].Value</label>
                                <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" />
                                @Html.ValidationMessage("ConfirmPassword", null, new { @class = "val" })

                                <button class="btn-primary" type="submit">@L["Dashboard_Profile_Security_SavePassword"].Value</button>
                            </form>
                        </article>

                        <article class="profile-card">
                            <h4>@L["Dashboard_Profile_Sessions_Title"].Value</h4>
                            <p>@L["Dashboard_Profile_Sessions_Description"].Value</p>
                            <ul class="profile-sessions" role="list">
                                <li class="profile-session">
                                    <div>
                                        <strong>@L["Dashboard_Profile_Sessions_Current"].Value</strong>
                                        <span>@Context.Request.Headers["User-Agent"].FirstOrDefault()</span>
                                    </div>
                                    <span class="profile-session__badge">@L["Dashboard_Profile_Sessions_Active"].Value</span>
                                </li>
                            </ul>
                            <form asp-action="SignOutEverywhere" method="post" class="profile-sessions__actions">
                                @Html.AntiForgeryToken()
                                <button class="btn-outline" type="submit">@L["Dashboard_Profile_Sessions_SignOutAll"].Value</button>
                            </form>
                        </article>
                    </div>

                    <div class="profile-column">
                        <article class="profile-card">
                            <h4>@L["Dashboard_Profile_Recovery_Title"].Value</h4>
                            <p>@L["Dashboard_Profile_Recovery_Subtitle"].Value</p>
                            <form asp-action="UpdateRecoveryQuestions" method="post" class="profile-form" data-profile-security-form>
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, null, new { @class = "val-summary" })

                                @for (var index = 1; index <= 3; index++)
                                {
                                    var selectId = $"SecurityQuestion{index}";
                                    var customId = $"SecurityQuestion{index}Custom";
                                    var answerId = $"SecurityAnswer{index}";
                                    var selectedKey = index switch
                                    {
                                        1 => security.Recovery.SecurityQuestion1,
                                        2 => security.Recovery.SecurityQuestion2,
                                        3 => security.Recovery.SecurityQuestion3,
                                        _ => string.Empty
                                    } ?? string.Empty;
                                    var customValue = index switch
                                    {
                                        1 => security.Recovery.SecurityQuestion1Custom,
                                        2 => security.Recovery.SecurityQuestion2Custom,
                                        3 => security.Recovery.SecurityQuestion3Custom,
                                        _ => null
                                    };
                                    var answerValue = index switch
                                    {
                                        1 => security.Recovery.SecurityAnswer1,
                                        2 => security.Recovery.SecurityAnswer2,
                                        3 => security.Recovery.SecurityAnswer3,
                                        _ => string.Empty
                                    } ?? string.Empty;
                                    <fieldset class="recovery-field" data-profile-field>
                                        <legend>@string.Format(L["Dashboard_Profile_Recovery_QuestionLabel"].Value, index)</legend>
                                        <select id="@selectId" name="SecurityQuestion@index" data-recovery-select>
                                            <option value="">@L["Auth_Register_SecurityQuestions_Placeholder"].Value</option>
                                            @foreach (var option in security.Recovery.SecurityQuestionOptions)
                                            {
                                                var isSelected = string.Equals(option.Key, selectedKey, StringComparison.OrdinalIgnoreCase);
                                                <option value="@option.Key" data-allows-custom="@(option.AllowsCustomPrompt ? "true" : "false")" selected="@(isSelected ? "selected" : null)">@option.Prompt</option>
                                            }
                                        </select>
                                        @Html.ValidationMessage($"SecurityQuestion{index}", null, new { @class = "val" })
                                        <input id="@customId" name="SecurityQuestion@index@("Custom")" value="@customValue" placeholder="@L["Auth_Register_SecurityQuestions_CustomPlaceholder"].Value" data-recovery-custom />
                                        @Html.ValidationMessage($"SecurityQuestion{index}Custom", null, new { @class = "val" })
                                        <input id="@answerId" name="SecurityAnswer@index" value="@answerValue" autocomplete="off" />
                                        @Html.ValidationMessage($"SecurityAnswer{index}", null, new { @class = "val" })
                                    </fieldset>
                                }

                                <button class="btn-primary" type="submit">@L["Dashboard_Profile_Recovery_Save"].Value</button>
                            </form>
                        </article>
                    </div>
                </div>
            </section>

            <section class="profile-section@(selectedPanel == "preferences" ? " is-open" : string.Empty)" data-profile-panel="preferences">
                <header class="profile-section__header">
                    <h3>@L["Dashboard_Profile_Preferences_Title"].Value</h3>
                    <p>@L["Dashboard_Profile_Preferences_Subtitle"].Value</p>
                </header>
                <div class="profile-section__body">
                    <div class="form-field" data-profile-field>
                        <label for="PreferredLanguage">@L["Dashboard_Profile_Preferences_Language"].Value</label>
                        <select id="PreferredLanguage" name="PreferredLanguage">
                            @foreach (var option in preferences.LanguageOptions)
                            {
                                <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-field" data-profile-field>
                        <label for="PreferredTheme">@L["Dashboard_Profile_Preferences_Theme"].Value</label>
                        <div class="segmented" role="radiogroup" aria-label="@L["Dashboard_Profile_Preferences_Theme"].Value">
                            @foreach (var option in preferences.ThemeOptions)
                            {
                                var optionId = $"PreferredTheme_{option.Value}";
                                <input type="radio" id="@optionId" name="PreferredTheme" value="@option.Value" @(option.Selected ? "checked" : null) />
                                <label for="@optionId">@option.Text</label>
                            }
                        </div>
                    </div>
                    <div class="form-field form-field--toggle" data-profile-field>
                        <input type="hidden" name="EnableEmailNotifications" value="false" />
                        <input type="checkbox" id="EnableEmailNotifications" name="EnableEmailNotifications" value="true" @(preferences.EnableEmailNotifications ? "checked" : null) />
                        <label for="EnableEmailNotifications">@L["Dashboard_Profile_Preferences_Email"].Value</label>
                    </div>
                    <div class="form-field form-field--toggle" data-profile-field>
                        <input type="hidden" name="EnableFriendInvites" value="false" />
                        <input type="checkbox" id="EnableFriendInvites" name="EnableFriendInvites" value="true" @(preferences.EnableFriendInvites ? "checked" : null) />
                        <label for="EnableFriendInvites">@L["Dashboard_Profile_Preferences_Invites"].Value</label>
                    </div>
                </div>
            </section>
        </div>

        <div class="profile-action-bar" data-profile-actions>
            <div class="profile-action-bar__status" data-profile-status>@L["Dashboard_Profile_Status_Idle"].Value</div>
            <div class="profile-action-bar__buttons">
                <button type="button" class="btn-outline" data-profile-cancel>@L["Dashboard_Profile_Action_Cancel"].Value</button>
                <button type="submit" class="btn-primary" data-profile-save>@L["Dashboard_Profile_Action_Save"].Value</button>
            </div>
        </div>
    </form>

    <section class="profile-modals" aria-hidden="true">
        <div class="modal" id="displayNameConfirmModal" hidden data-profile-displayname-modal>
            <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="displayNameConfirmTitle">
                <header class="modal__header">
                    <h3 id="displayNameConfirmTitle">@L["Dashboard_Profile_DisplayName_ConfirmTitle"].Value</h3>
                </header>
                <div class="modal__body">
                    <p class="modal__message" data-modal-message>@L["Dashboard_Profile_DisplayName_ConfirmMessage"].Value</p>
                    <p class="modal__warning" data-modal-warning hidden></p>
                    <div class="modal__field" data-modal-agreement>
                        <input type="checkbox" id="displayNameConfirmAgree" />
                        <label for="displayNameConfirmAgree">@L["Dashboard_Profile_DisplayName_ConfirmAgreement"].Value</label>
                    </div>
                    <div class="modal__field" data-modal-password>
                        <label for="displayNameConfirmPassword">@L["Dashboard_Profile_DisplayName_ConfirmPasswordLabel"].Value</label>
                        <input type="password" id="displayNameConfirmPassword" autocomplete="current-password" />
                    </div>
                </div>
                <footer class="modal__footer">
                    <button type="button" class="btn-outline" data-modal-close>@L["Dashboard_Profile_DisplayName_ConfirmCancel"].Value</button>
                    <button type="button" class="btn-primary" data-modal-confirm>@L["Dashboard_Profile_DisplayName_ConfirmAccept"].Value</button>
                </footer>
            </div>
            <div class="modal__backdrop" data-modal-close></div>
        </div>

        <div class="modal" id="avatarCropModal" hidden data-profile-avatar-modal>
            <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="avatarCropTitle">
                <header class="modal__header">
                    <h3 id="avatarCropTitle">@L["Dashboard_Profile_Avatar_CropTitle"].Value</h3>
                </header>
                <div class="modal__body">
                    <div class="avatar-cropper" data-avatar-cropper>
                        <div class="avatar-cropper__viewport">
                            <img src="" alt="" data-avatar-crop-image />
                        </div>
                    </div>
                    <label for="avatarCropZoom" class="avatar-cropper__label">@L["Dashboard_Profile_Avatar_CropZoom"].Value</label>
                    <input type="range" id="avatarCropZoom" min="1" max="3" step="0.05" value="1" data-avatar-crop-zoom />
                </div>
                <footer class="modal__footer">
                    <button type="button" class="btn-outline" data-avatar-crop-cancel>@L["Dashboard_Profile_Avatar_CropCancel"].Value</button>
                    <button type="button" class="btn-primary" data-avatar-crop-confirm>@L["Dashboard_Profile_Avatar_CropConfirm"].Value</button>
                </footer>
            </div>
            <div class="modal__backdrop" data-avatar-crop-cancel></div>
        </div>
    </section>
</section>