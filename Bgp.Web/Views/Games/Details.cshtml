@model Bgp.Domain.Entities.Game
@{
    ViewData["Title"] = Model.Title;
    var playUrl = ViewBag.PlayUrl as string;
}
<h2>@Model.Title</h2>
<p>@Model.Description</p>

@if (playUrl is not null)
{
    <div class="player">
        <iframe src="@playUrl" title="game" loading="lazy"></iframe>
    </div>
}
else
{
    <div class="alert">@L["Details_NoBuild"].Value</div>
}

<section class="panel">
    <h3>@L["Details_LeaderboardTitle"].Value</h3>
    <div id="leaderboard">@L["Details_LeaderboardLoading"].Value</div>
</section>

@section Scripts {
    <script>
        const leaderboardErrorText = @System.Text.Json.JsonSerializer.Serialize(L["Details_LeaderboardError"].Value);
        (async () => {
            const r = await fetch(`/api/games/@Model.Id/leaderboard?top=20`);
            if (!r.ok) { document.getElementById('leaderboard').innerText = leaderboardErrorText; return; }
            const data = await r.json();
            const html = ['<ol>'].concat(data.map(x => `<li>${x.userName} &mdash; ${x.bestScore}</li>`)).concat(['</ol>']).join('');
            document.getElementById('leaderboard').innerHTML = html;
        })();
    </script>
}
