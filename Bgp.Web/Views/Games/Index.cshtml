@model IEnumerable<dynamic>
@{
    ViewData["Title"] = L["Games_Index_Title"].Value;
}
<h2>@L["Games_Index_Heading"].Value</h2>
<div class="grid">
    @foreach (var g in Model)
    {
        <article class="card">
            <img src="@(g.CoverImagePath ?? "/img/placeholder.png")" alt="cover" />
            <h3><a asp-controller="Games" asp-action="Details" asp-route-slug="@g.Slug">@g.Title</a></h3>
            <p>@L["Games_Index_Rating"].Value: @($"{g.Avg:0.0}")</p>
        </article>
    }
</div>
