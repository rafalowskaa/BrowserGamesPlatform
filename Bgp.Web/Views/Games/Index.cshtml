@using Bgp.Domain.Enums
@using Bgp.Web.Helpers
@model GameCatalogViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/pages/games.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = L["Games_Index_Title"].Value;

    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    string FormatCategories(GameCategory categories)
    {
        if (categories == GameCategory.None)
        {
            return L["Games_Index_Category_Unspecified"].Value;
        }

        var labels = GameMetadataOptions.CategoryDefinitions
            .Where(def => (categories & def.Category) != 0)
            .Select(def => L[def.ResourceKey].Value)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        return labels.Count == 0 ? L["Games_Index_Category_Unspecified"].Value : string.Join(", ", labels);
    }

    string FormatPlayers(int count)
    {
        return string.Format(L["Games_Index_CurrentPlayers"].Value, count);
    }

    string Summarize(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var trimmed = text.Trim();
        return trimmed.Length > 180
            ? string.Concat(trimmed.AsSpan(0, 180).TrimEnd(), "…")
            : trimmed;
    }
}
<section class="games-catalog">
    <header class="catalog-header">
        <h2>@L["Games_Index_Heading"].Value</h2>
        <form method="get" class="catalog-filters">
            <label>
                <span>@L["Games_Index_Filter_Search"].Value</span>
                <input type="search" name="search" value="@Model.Filters.Search" placeholder="@L["Games_Index_Filter_SearchPlaceholder"].Value" />
            </label>
            <label>
                <span>@L["Games_Index_Filter_Category"].Value</span>
                <select name="category">
                    <option value="">@L["Games_Index_Filter_All"].Value</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>
            <label>
                <span>@L["Games_Index_Filter_Tag"].Value</span>
                <select name="tag">
                    <option value="">@L["Games_Index_Filter_AllTags"].Value</option>
                    @foreach (var option in Model.TagOptions)
                    {
                        <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </label>
            <button class="btn-primary btn-compact" type="submit">@L["Games_Index_Filter_Apply"].Value</button>
        </form>
    </header>

@if (Model.Games.Any())
{
        <div class="grid games-grid">
            @foreach (var g in Model.Games)
            {
                var detailsUrl = Url.Action("Details", "Games", new { slug = g.Slug }) ?? "#";
                <article class="game-card">
                    <a class="game-card__overlay" href="@detailsUrl">
                        <span class="sr-only">@g.Title</span>
                    </a>
                    <div class="game-card__media">
                        <img src="@(string.IsNullOrWhiteSpace(g.CoverImagePath) ? "/img/placeholder.png" : g.CoverImagePath)" alt="cover" />
                    </div>
                    <div class="game-card__body">
                        <h3>
                            <span>@g.Title</span>
                        </h3>
                        <p class="game-card__rating" data-rating-value="@g.AverageRating">
                            @L["Games_Index_Rating"].Value:
                            <span aria-hidden="true">★</span>
                            <span>@g.AverageRating.ToString("0.0")</span>
                            <span class="muted">(@g.ReviewCount)</span>
                        </p>
                        <p class="game-card__stat" data-current-players="@g.ActivePlayerCount">@FormatPlayers(g.ActivePlayerCount)</p>
                        @{
                            var summary = Summarize(g.Description);
                        }
                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p class="game-card__description">@summary</p>
                        }
                        <p class="game-card__meta">@L["Games_Index_Categories"].Value: @FormatCategories(g.Categories)</p>
                        @if (g.Tags.Any())
                        {
                            <div class="game-card__tags">
                                @foreach (var tag in g.Tags)
                                {
                                    <span class="badge subtle">@tag</span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
}
else
    {
        <div class="empty-state">@L["Games_Index_Empty"].Value</div>
    }
</section>
