@model Bgp.Web.ViewModels.GameSummaryViewModel
@using Bgp.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    var placeholderImage = Url.Content("~/img/placeholders/game-cover.svg");
    var hasCoverImage = !string.IsNullOrWhiteSpace(Model.CoverImagePath);
    var mediaClass = $"game-card-guest__media{(hasCoverImage ? string.Empty : " game-card-guest__media--placeholder")}";
    var coverImage = hasCoverImage ? Model.CoverImagePath : placeholderImage;
}
<article class="game-card-guest" data-game-card>
    <div class="@mediaClass">
        <a class="game-card-guest__cover" asp-controller="Games" asp-action="Details" asp-route-slug="@Model.Slug" aria-label="@Model.Title">
            <span class="sr-only">@Model.Title</span>
            <img src="@placeholderImage"
                 data-game-card-img
                 data-src="@coverImage"
                 data-srcset="@coverImage 1x"
                 alt="@Model.Title"
                 width="320"
                 height="180"
                 loading="lazy"
                 decoding="async" />
        </a>
        
    </div>
    <div class="game-card-guest__content">
        <h3 class="game-card-guest__title">
            <a asp-controller="Games" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>
        <p class="game-card-guest__excerpt">@Model.Excerpt</p>
        <div class="game-card-guest__meta">
            @if (Model.ReviewsCount > 0)
            {
                <span class="game-card-guest__rating" aria-label="@string.Format(L["Home_Game_Rating"].Value, Model.Rating.ToString("F1"), Model.ReviewsCount)">★ @Model.Rating.ToString("F1")</span>
            }
            else
            {
                <span class="game-card-guest__badge">@L["Home_Game_New"].Value</span>
            }
            
        </div>
    </div>
</article>