@model Bgp.Web.ViewModels.GameSummaryViewModel
@{
    var placeholderImage = Url.Content("~/img/placeholders/game-cover.svg");
    var hasCoverImage = !string.IsNullOrWhiteSpace(Model.CoverImagePath);
    var coverImage = hasCoverImage ? Model.CoverImagePath : placeholderImage;
    var coverClass = $"game-card__image-wrapper{(hasCoverImage ? string.Empty : " game-card__image-wrapper--placeholder")}";
}
<article class="game-card" data-game-card>
    <a asp-controller="Games" asp-action="Details" asp-route-slug="@Model.Slug" class="game-card__overlay" aria-label="@Model.Title"></a>
    <div class="game-card__media">
        <a asp-controller="Games" asp-action="Details" asp-route-slug="@Model.Slug" class="game-card__link" aria-label="@Model.Title">
            <div class="@coverClass">
                <img src="@placeholderImage"
                     data-game-card-img
                     data-src="@coverImage"
                     data-srcset="@coverImage 1x"
                     alt="@Model.Title"
                     width="320"
                     height="180"
                     loading="lazy"
                     decoding="async" />
                @if (!string.IsNullOrWhiteSpace(Model.HighlightTag))
                {
                    <span class="game-card__tag">@Model.HighlightTag</span>
                }
            </div>
        </a>
        
    </div>
    <div class="game-card__content">
        <h3 class="game-card__title"><a asp-controller="Games" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a></h3>
        <p class="game-card__excerpt">@Model.Excerpt</p>
        <div class="game-card__meta">
            <span class="game-card__rating" aria-label="@($"Ocena {Model.Rating:F1} gwiazd")">★ @Model.Rating.ToString("F1")</span>
        </div>
    </div>
</article>