@using System.Security.Claims
@using System.Text.Json
@using Bgp.Domain.Enums
@{
    var currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier);
    var chatStrings = new
    {
        readReceipt = L["Chat_ReadReceipt"].Value,
        readReceiptLabel = L["Chat_ReadReceipt_Label"].Value,
        statusAvailable = L["Chat_Status_Available"].Value,
        statusAway = L["Chat_Status_Away"].Value,
        statusInvisible = L["Chat_Status_Invisible"].Value,
        statusOffline = L["Chat_Status_Offline"].Value,
        statusUnknown = L["Chat_Status_Offline"].Value,
        statusSaved = L["Chat_Status_Saved"].Value,
        statusError = L["Chat_Status_Error"].Value,
        newMessage = L["Chat_NewMessage_Notification"].Value,
        accept = L["Chat_Request_Accept"].Value,
        decline = L["Chat_Request_Decline"].Value,
        pendingOutgoing = L["Chat_Request_Pending"].Value,
        noFriends = L["Chat_NoFriends"].Value,
        noInvites = L["Chat_NoInvites"].Value,
        noMatches = L["Chat_NoMatches"].Value,
        minimize = L["Chat_Minimize"].Value,
        restore = L["Chat_Restore"].Value,
        close = L["Chat_CloseWindow"].Value,
        writePlaceholder = L["Chat_WriteMessage"].Value,
        send = L["Chat_Send"].Value
    };
}

<div id="chatDock" class="chat-dock" data-chat-user="@currentUserId">
    <button id="chatToggle"
            class="chat-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="chatPanel"
            title="@L["Chat_Open"].Value">
        <span class="chat-toggle__icon" aria-hidden="true">💬</span>
        <span class="chat-toggle__badge" data-chat-unread hidden>0</span>
        <span class="sr-only">@L["Chat_Open"].Value</span>
    </button>

    <div id="chatPanel" class="chat-panel" hidden>
        <header class="chat-panel__header">
            <strong>@L["Chat_Title"].Value</strong>
            <button type="button"
                    class="btn-icon"
                    data-chat-close
                    aria-label="@L["Chat_Close"].Value">
                ✕
            </button>
        </header>
        <div class="chat-panel__search">
            <input id="chatSearch"
                   data-chat-search
                   placeholder="@L["Chat_SearchPlaceholder"].Value"
                   autocomplete="off" />
        </div>

        <div class="chat-panel__body">
            <section class="chat-panel__section chat-panel__section--status">
                <h4>@L["Chat_Status_Header"].Value</h4>
                <form class="chat-status-form" data-chat-status-form>
                    <label for="chatStatusMessage">@L["Chat_Status_MessageLabel"].Value</label>
                    <input id="chatStatusMessage"
                           data-chat-status-message
                           maxlength="160"
                           placeholder="@L["Chat_Status_MessagePlaceholder"].Value"
                           autocomplete="off" />
                    <div class="chat-status-form__row">
                        <label for="chatPresence">@L["Chat_Status_PresenceLabel"].Value</label>
                        <select id="chatPresence" data-chat-presence>
                            <option value="@((int)UserPresenceStatus.Available)">@L["Chat_Status_Available"].Value</option>
                            <option value="@((int)UserPresenceStatus.Away)">@L["Chat_Status_Away"].Value</option>
                        </select>
                    </div>
                    <label class="check chat-status-form__invisible">
                        <input type="checkbox" data-chat-invisible />
                        @L["Chat_Status_InvisibleLabel"].Value
                    </label>
                    <div class="chat-status-form__actions">
                        <button type="submit" class="btn-primary btn-compact" data-chat-status-submit>@L["Chat_Status_Save"].Value</button>
                        <span class="chat-status__feedback" data-chat-status-feedback hidden></span>
                    </div>
                </form>
            </section>
            <section class="chat-panel__section">
                <h4>@L["Chat_Friends"].Value</h4>
                <ul class="chat-contacts" data-chat-friends></ul>
                <p class="chat-empty" data-chat-friends-empty>@L["Chat_NoFriends"].Value</p>
            </section>
            <section class="chat-panel__section">
                <h4>@L["Chat_Invites"].Value</h4>
                <ul class="chat-requests" data-chat-requests></ul>
                <p class="chat-empty" data-chat-requests-empty>@L["Chat_NoInvites"].Value</p>
            </section>
        </div>
    </div>

    <div class="chat-windows" data-chat-windows></div>
</div>

<script type="application/json" id="chatStrings">@Html.Raw(JsonSerializer.Serialize(chatStrings))</script>
