@using System.Security.Claims
@using System.Text.Json
@using Bgp.Domain.Enums
@using Bgp.Infrastructure.Identity
@using Bgp.Web.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentUser = currentUserId is not null ? await UserManager.FindByIdAsync(currentUserId) : null;
    var displayName = DisplayNameFormatter.Format(currentUser?.DisplayName, currentUser?.Email, currentUser?.UserName, currentUser?.Id);
    var fallbackName = currentUser?.UserName ?? User?.Identity?.Name ?? "?";
    var chatStrings = new
    {
        readReceipt = L["Chat_ReadReceipt"].Value,
        readReceiptLabel = L["Chat_ReadReceipt_Label"].Value,
        fabLabel = L["Chat_FabLabel"].Value,
        statusAvailable = L["Chat_Status_Available"].Value,
        statusAway = L["Chat_Status_Away"].Value,
        statusInvisible = L["Chat_Status_Invisible"].Value,
        statusOffline = L["Chat_Status_Offline"].Value,
        statusDnd = L["Chat_Status_Dnd"].Value,
        statusUnknown = L["Chat_Status_Offline"].Value,
        statusSaved = L["Chat_Status_Saved"].Value,
        statusError = L["Chat_Status_Error"].Value,
        statusPrompt = L["Chat_Status_MessagePlaceholder"].Value,
        newMessage = L["Chat_NewMessage_Notification"].Value,
        viewProfile = L["Chat_ViewProfile"].Value,
        accept = L["Chat_Request_Accept"].Value,
        decline = L["Chat_Request_Decline"].Value,
        pendingOutgoing = L["Chat_Request_Pending"].Value,
        noFriends = L["Chat_NoFriends"].Value,
        noInvites = L["Chat_NoInvites"].Value,
        noMatches = L["Chat_NoMatches"].Value,
        strangers = L["Chat_Strangers"].Value,
        noStrangers = L["Chat_NoStrangers"].Value,
        searchHint = L["Chat_SearchHint"].Value,
        strangersPrompt = L["Chat_Strangers_Prompt"].Value,
        activeHeading = L["Chat_ActiveHeading"].Value,
        archivedHeading = L["Chat_ArchivedHeading"].Value,
        archivedEmpty = L["Chat_ArchivedEmpty"].Value,
        archive = L["Chat_Archive"].Value,
        unarchive = L["Chat_Unarchive"].Value,
        keepArchived = L["Chat_KeepArchived"].Value,
        releaseArchived = L["Chat_ReleaseArchived"].Value,
        minimize = L["Chat_Minimize"].Value,
        restore = L["Chat_Restore"].Value,
        close = L["Chat_CloseWindow"].Value,
        writePlaceholder = L["Chat_WriteMessage"].Value,
        send = L["Chat_Send"].Value,
        deliveredReceiptLabel = L["Chat_Receipt_Delivered"].Value,
        sending = L["Chat_Sending"].Value,
        sendError = L["Chat_SendFailed"].Value,
        popout = L["Chat_Popout"].Value,
        overflow = L["Chat_Overflow"].Value,
        invite = L["Chat_Invite"].Value,
        searchThread = L["Chat_SearchThread"].Value,
        searchThreadPlaceholder = L["Chat_SearchThreadPlaceholder"].Value,
        searchThreadPrev = L["Chat_SearchThreadPrev"].Value,
        searchThreadNext = L["Chat_SearchThreadNext"].Value,
        deleteMessage = L["Chat_DeleteMessage"].Value,
        deleteMessageConfirm = L["Chat_DeleteMessageConfirm"].Value,
        messageDeleted = L["Chat_MessageDeleted"].Value,
        deleteMessageError = L["Chat_DeleteMessageError"].Value,
        searchThreadNone = L["Chat_SearchThreadNone"].Value,
        collapsePanel = L["Chat_CollapsePanel"].Value,
        expandPanel = L["Chat_ExpandPanel"].Value,
        archiveBadge = L["Chat_ArchiveBadge"].Value,
        threadBack = L["Chat_ThreadBack"].Value,
        reactionLabel = L["Chat_ReactionLabel"].Value,
        contextProfile = L["Chat_Context_Profile"].Value,
        contextAddFriend = L["Chat_Context_AddFriend"].Value,
        contextRemoveFriend = L["Chat_Context_RemoveFriend"].Value,
        contextInvite = L["Chat_Context_Invite"].Value,
        contextArchive = L["Chat_Context_Archive"].Value,
        contextRestore = L["Chat_Context_Restore"].Value,
        contextKeep = L["Chat_Context_Keep"].Value,
        contextRelease = L["Chat_Context_Release"].Value,
        dayToday = L["Chat_Day_Today"].Value,
        dayYesterday = L["Chat_Day_Yesterday"].Value,
        deliveredShort = L["Chat_DeliveredShort"].Value,
        readShort = L["Chat_ReadShort"].Value,
        emojiLabel = L["Chat_EmojiLabel"].Value,
        attachmentLabel = L["Chat_AttachmentLabel"].Value

    };
}

<div id="chatDock" class="chat-dock" data-chat-user="@currentUserId">
    <button id="chatToggle"
            class="chat-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="chatPanel"
            title="@L["Chat_Open"].Value">
        <span class="chat-toggle__icon" aria-hidden="true">💬</span>
        <span class="chat-toggle__badge" data-chat-unread hidden>0</span>
        <span class="sr-only">@L["Chat_Open"].Value</span>
    </button>
    <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-chat-live></span>

    <div class="chat-workspace">
        <div class="chat-dock__windows">
            <div class="chat-windows" data-chat-windows></div>
            <div class="chat-overflow">
                <button type="button"
                        class="chat-overflow__toggle"
                        data-chat-overflow
                        aria-expanded="false"
                        aria-label="@L["Chat_Overflow"].Value"
                        hidden>
                    <span aria-hidden="true">•••</span>
                    <span class="chat-overflow__count" data-chat-overflow-count>0</span>
                </button>
                <div class="chat-overflow__menu" data-chat-overflow-menu hidden>
                    <div class="chat-overflow__header">
                        <strong>@L["Chat_Overflow"].Value</strong>
                        <button type="button"
                                class="btn-icon"
                                data-chat-overflow-close
                                aria-label="@L["Chat_Close"].Value">
                            ✕
                        </button>
                    </div>
                    <ul class="chat-overflow__list" data-chat-overflow-list></ul>
                </div>
            </div>
        </div>
        <div id="chatPanel" class="chat-panel" aria-hidden="true">

            <header class="chat-panel__header" data-chat-panel-header>
                <div class="chat-panel__title"
                     data-chat-panel-title
                     role="button"
                     tabindex="0"
                     aria-expanded="true"
                     aria-controls="chatPanelBody">
                    <strong>@L["Chat_Title"].Value</strong>
                    <small>@L["Chat_Conversations"].Value</small>
                </div>
                <div class="chat-panel__controls">
                    <button type="button"
                            class="chat-panel__button chat-panel__button--collapse"
                            data-chat-panel-toggle
                            aria-expanded="true"
                            aria-label="@L["Chat_CollapsePanel"].Value">
                        ▾
                    </button>
                    <button type="button"
                            class="chat-panel__button"
                            data-chat-close
                            aria-label="@L["Chat_Close"].Value">
                        ✕
                    </button>
                </div>

            </header>
            <div class="chat-panel__search">
                <input id="chatSearch"
                       data-chat-search
                       placeholder="@L["Chat_SearchPlaceholder"].Value"
                       autocomplete="off" />
            </div>

            <div class="chat-panel__body" id="chatPanelBody">
                <div class="chat-panel__profile" data-chat-status>
                    <button type="button"
                            class="chat-status-toggle"
                            data-chat-status-toggle
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label="@L["Chat_Status_Header"].Value">
                        <span class="chat-status-toggle__avatar@(string.IsNullOrEmpty(currentUser?.AvatarUrl) ? " avatar-placeholder" : string.Empty)">
                            @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                            {
                                <img src="@currentUser.AvatarUrl" alt="@displayName ?? fallbackName" />
                            }
                            else
                            {
                                <span class="sr-only">@L["Dashboard_Profile_NoAvatar"].Value</span>
                            }
                            <span class="chat-status-dot" data-chat-self-dot></span>
                        </span>
                        <span class="chat-status-toggle__details">
                            <span class="chat-status-toggle__presence" data-chat-status-presence>@L["Chat_Status_Offline"].Value</span>
                            <span class="chat-status-toggle__message is-empty" data-chat-status-text>@L["Chat_Status_MessagePlaceholder"].Value</span>
                        </span>
                        <span class="chat-status-toggle__chevron" aria-hidden="true">▾</span>
                    </button>
                    <form class="chat-status-form chat-status-popover" data-chat-status-form hidden>
                        <label for="chatStatusMessage">@L["Chat_Status_MessageLabel"].Value</label>
                        <input id="chatStatusMessage"
                               data-chat-status-message
                               maxlength="80"
                               placeholder="@L["Chat_Status_MessagePlaceholder"].Value"
                               autocomplete="off" />
                        <label for="chatPresence">@L["Chat_Status_PresenceLabel"].Value</label>
                        <select id="chatPresence" data-chat-presence>
                            <option value="available">@L["Chat_Status_Available"].Value</option>
                            <option value="away">@L["Chat_Status_Away"].Value</option>
                            <option value="dnd">@L["Chat_Status_Dnd"].Value</option>
                            <option value="invisible">@L["Chat_Status_Invisible"].Value</option>
                        </select>
                        <div class="chat-status-popover__actions">
                            <button type="submit" class="btn-primary btn-compact" data-chat-status-submit>@L["Chat_Status_Save"].Value</button>
                            <button type="button" class="btn-outline btn-compact" data-chat-status-cancel>@L["Chat_Status_Cancel"].Value</button>
                            <span class="chat-status__feedback" data-chat-status-feedback hidden></span>
                        </div>
                    </form>
                </div>
                <section class="chat-panel__section">
                    <div class="chat-panel__section-header">
                        <h4>@L["Chat_ActiveHeading"].Value</h4>
                    </div>
                    <ul class="chat-contacts" data-chat-active></ul>
                    <p class="chat-empty" data-chat-active-empty>@L["Chat_NoFriends"].Value</p>
                </section>
                <section class="chat-panel__section">
                    <div class="chat-panel__section-header">
                        <h4>@L["Chat_ArchivedHeading"].Value</h4>
                    </div>
                    <ul class="chat-contacts" data-chat-archived></ul>
                    <p class="chat-empty" data-chat-archived-empty>@L["Chat_ArchivedEmpty"].Value</p>
                </section>
               
                <section class="chat-panel__section">
                    <div class="chat-panel__section-header">
                        <h4>@L["Chat_Strangers"].Value</h4>
                    </div>
                    <ul class="chat-contacts chat-contacts--strangers" data-chat-strangers></ul>
                    <p class="chat-empty" data-chat-strangers-empty>@L["Chat_SearchHint"].Value</p>
                </section>
            </div>

        </div>

    </div>
    <div class="chat-popout" data-chat-popout hidden>
        <div class="chat-popout__scrim" data-chat-popout-dismiss aria-label="@L["Chat_Close"].Value"></div>
        <div class="chat-popout__dialog" role="dialog" aria-modal="true" aria-label="@L["Chat_Popout"].Value">
            <div class="chat-popout__header">
                <strong>@L["Chat_Popout"].Value</strong>
                <button type="button" class="btn-icon" data-chat-popout-dismiss aria-label="@L["Chat_Close"].Value">✕</button>
            </div>
            <div class="chat-popout__body" data-chat-popout-body></div>
        </div>
    </div>
</div>

<script type="application/json" id="chatStrings">@Html.Raw(JsonSerializer.Serialize(chatStrings))</script>
