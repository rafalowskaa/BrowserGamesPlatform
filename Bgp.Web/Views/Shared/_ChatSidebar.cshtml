@using System.Security.Claims
@using System.Text.Json
@using Bgp.Domain.Enums
@using Bgp.Infrastructure.Identity
@using Bgp.Web.Helpers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentUser = currentUserId is not null ? await UserManager.FindByIdAsync(currentUserId) : null;
    var displayName = DisplayNameFormatter.Format(currentUser?.DisplayName, currentUser?.Email, currentUser?.UserName, currentUser?.Id);
    var fallbackName = currentUser?.UserName ?? User?.Identity?.Name ?? "?";
    var initialsSource = string.IsNullOrWhiteSpace(displayName) ? fallbackName : displayName;
    var avatarInitial = string.IsNullOrWhiteSpace(initialsSource)
        ? "?"
        : initialsSource.Trim()[0].ToString().ToUpperInvariant();
    var chatStrings = new
    {
        readReceipt = L["Chat_ReadReceipt"].Value,
        readReceiptLabel = L["Chat_ReadReceipt_Label"].Value,
        statusAvailable = L["Chat_Status_Available"].Value,
        statusAway = L["Chat_Status_Away"].Value,
        statusInvisible = L["Chat_Status_Invisible"].Value,
        statusOffline = L["Chat_Status_Offline"].Value,
        statusUnknown = L["Chat_Status_Offline"].Value,
        statusSaved = L["Chat_Status_Saved"].Value,
        statusError = L["Chat_Status_Error"].Value,
        statusPrompt = L["Chat_Status_MessagePlaceholder"].Value,
        newMessage = L["Chat_NewMessage_Notification"].Value,
        viewProfile = L["Chat_ViewProfile"].Value,
        accept = L["Chat_Request_Accept"].Value,
        decline = L["Chat_Request_Decline"].Value,
        pendingOutgoing = L["Chat_Request_Pending"].Value,
        noFriends = L["Chat_NoFriends"].Value,
        noInvites = L["Chat_NoInvites"].Value,
        noMatches = L["Chat_NoMatches"].Value,
        strangers = L["Chat_Strangers"].Value,
        noStrangers = L["Chat_NoStrangers"].Value,
        searchHint = L["Chat_SearchHint"].Value,
        strangersPrompt = L["Chat_Strangers_Prompt"].Value,
        minimize = L["Chat_Minimize"].Value,
        restore = L["Chat_Restore"].Value,
        close = L["Chat_CloseWindow"].Value,
        writePlaceholder = L["Chat_WriteMessage"].Value,
        send = L["Chat_Send"].Value,
        deliveredReceiptLabel = L["Chat_Receipt_Delivered"].Value,
        sending = L["Chat_Sending"].Value,
        sendError = L["Chat_SendFailed"].Value
    };
}

<div id="chatDock" class="chat-dock" data-chat-user="@currentUserId">
    <button id="chatToggle"
            class="chat-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="chatPanel"
            title="@L["Chat_Open"].Value">
        <span class="chat-toggle__icon" aria-hidden="true">💬</span>
        <span class="chat-toggle__badge" data-chat-unread hidden>0</span>
        <span class="sr-only">@L["Chat_Open"].Value</span>
    </button>
    <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-chat-live></span>

    <div class="chat-workspace">
        <div id="chatPanel" class="chat-panel" hidden>
            <header class="chat-panel__header">
                <strong>@L["Chat_Title"].Value</strong>
                <button type="button"
                        class="btn-icon"
                        data-chat-close
                        aria-label="@L["Chat_Close"].Value">
                    ✕
                </button>
            </header>
            <div class="chat-panel__search">
                <input id="chatSearch"
                       data-chat-search
                       placeholder="@L["Chat_SearchPlaceholder"].Value"
                       autocomplete="off" />
            </div>

            <div class="chat-panel__body">
                <div class="chat-panel__profile" data-chat-status>
                    <button type="button"
                            class="chat-status-toggle"
                            data-chat-status-toggle
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label="@L["Chat_Status_Header"].Value">
                        <span class="chat-status-toggle__avatar">
                            @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                            {
                                <img src="@currentUser.AvatarUrl" alt="@displayName ?? fallbackName" />
                            }
                            else
                            {
                                <span>@avatarInitial</span>
                            }
                            <span class="chat-status-dot" data-chat-self-dot></span>
                        </span>
                        <span class="chat-status-toggle__details">
                            <span class="chat-status-toggle__presence" data-chat-status-presence>@L["Chat_Status_Offline"].Value</span>
                            <span class="chat-status-toggle__message is-empty" data-chat-status-text>@L["Chat_Status_MessagePlaceholder"].Value</span>
                        </span>
                        <span class="chat-status-toggle__chevron" aria-hidden="true">▾</span>
                    </button>
                    <form class="chat-status-form chat-status-popover" data-chat-status-form hidden>
                        <label for="chatStatusMessage">@L["Chat_Status_MessageLabel"].Value</label>
                        <input id="chatStatusMessage"
                               data-chat-status-message
                               maxlength="160"
                               placeholder="@L["Chat_Status_MessagePlaceholder"].Value"
                               autocomplete="off" />
                        <label for="chatPresence">@L["Chat_Status_PresenceLabel"].Value</label>
                        <select id="chatPresence" data-chat-presence>
                            <option value="available">@L["Chat_Status_Available"].Value</option>
                            <option value="away">@L["Chat_Status_Away"].Value</option>
                            <option value="invisible">@L["Chat_Status_Invisible"].Value</option>
                        </select>
                        <div class="chat-status-popover__actions">
                            <button type="submit" class="btn-primary btn-compact" data-chat-status-submit>@L["Chat_Status_Save"].Value</button>
                            <button type="button" class="btn-outline btn-compact" data-chat-status-cancel>@L["Chat_Status_Cancel"].Value</button>
                            <span class="chat-status__feedback" data-chat-status-feedback hidden></span>
                        </div>
                    </form>
                </div>
                <section class="chat-panel__section">
                    <h4>@L["Chat_Friends"].Value</h4>
                    <ul class="chat-contacts" data-chat-friends></ul>
                    <p class="chat-empty" data-chat-friends-empty>@L["Chat_NoFriends"].Value</p>
                </section>
                <section class="chat-panel__section">
                    <h4>@L["Chat_Strangers"].Value</h4>
                    <ul class="chat-contacts chat-contacts--strangers" data-chat-strangers></ul>
                    <p class="chat-empty" data-chat-strangers-empty>@L["Chat_SearchHint"].Value</p>
                </section>
                <section class="chat-panel__section">
                    <h4>@L["Chat_Invites"].Value</h4>
                    <ul class="chat-requests" data-chat-requests></ul>
                    <p class="chat-empty" data-chat-requests-empty>@L["Chat_NoInvites"].Value</p>
                </section>
            </div>   
        
    </div>

        <div class="chat-windows" data-chat-windows></div>
    </div>
</div>

<script type="application/json" id="chatStrings">@Html.Raw(JsonSerializer.Serialize(chatStrings))</script>
