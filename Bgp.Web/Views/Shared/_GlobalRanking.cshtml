@using Bgp.Web.ViewModels
@model GlobalRankingSectionViewModel
@using System
@using System.Globalization

@{
    var entries = Model.Data?.Entries ?? Array.Empty<GlobalRankingEntryViewModel>();
    var filterOptions = entries
        .Select(e => e.RankTitle)
        .Where(title => !string.IsNullOrWhiteSpace(title))
        .Distinct(StringComparer.CurrentCultureIgnoreCase)
        .OrderBy(title => title, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
}

<section id="@Model.AnchorId"
         class="ranking-section"
         data-ranking
         data-ranking-context="@Model.AnchorId"
         data-ranking-block-confirm="@Model.ActionsBlockConfirm"
         data-ranking-block-success="@Model.ActionsBlockSuccess"
         data-ranking-block-error="@Model.ActionsBlockError"
         data-ranking-report-prompt="@Model.ActionsReportPrompt"
         data-ranking-report-success="@Model.ActionsReportSuccess"
         data-ranking-report-error="@Model.ActionsReportError">
    <header class="ranking-header">
        <div>
            <p class="ranking-eyebrow">@Model.Subtitle</p>
            <h2>@Model.Title</h2>
        </div>
        <div class="ranking-controls">
            <div class="ranking-controls__inputs">
                <label class="ranking-control">
                    <span class="sr-only">@Model.SearchPlaceholder</span>
                    <input type="search"
                           placeholder="@Model.SearchPlaceholder"
                           autocomplete="off"
                           data-ranking-search />
                </label>
                <label class="ranking-control">
                    <span>@Model.FilterLabel</span>
                    <select data-ranking-filter>
                        <option value="">@Model.FilterAllLabel</option>
                        @foreach (var option in filterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
            </div>
            <button type="button" class="ranking-control ranking-control--ghost" data-ranking-jump hidden>
                <span>@Model.JumpToMeLabel</span>
            </button>
        </div>
    </header>

    <div class="leaderboard-table-wrap">
        <table class="leaderboard-table" data-ranking-table>
            <thead>
                <tr>
                    <th scope="col" class="leaderboard__col leaderboard__col--rank">@Model.RankLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--avatar">@Model.AvatarLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--player">@Model.PlayerLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--status">@Model.StatusLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--level">@Model.LevelLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--xp">@Model.ExperienceLabel</th>
                    <th scope="col" class="leaderboard__col leaderboard__col--actions" aria-label="@Model.ActionsLabel">@Model.ActionsLabel</th>
                </tr>
            </thead>
            <tbody class="leaderboard__body" data-ranking-list>
                @foreach (var entry in entries)
                {
                    var presenceClass = entry.PresenceStatus switch
                    {
                        Bgp.Domain.Enums.UserPresenceStatus.Available => "is-online",
                        Bgp.Domain.Enums.UserPresenceStatus.Away => "is-away",
                        Bgp.Domain.Enums.UserPresenceStatus.DoNotDisturb => "is-dnd",
                        Bgp.Domain.Enums.UserPresenceStatus.Invisible => "is-invisible",
                        _ => "is-offline"
                    };
                    var nameInitial = !string.IsNullOrWhiteSpace(entry.DisplayName)
                    ? entry.DisplayName.Trim()[0]
                    : '?';
                    var topClass = entry.Position switch
                    {
                        1 => " is-top is-gold",
                        2 => " is-top is-silver",
                        3 => " is-top is-bronze",
                        _ => string.Empty
                    };
                    var hasAvatar = !string.IsNullOrEmpty(entry.AvatarUrl);
                    var profileUrl = Url.Action("ViewProfile", "Dashboard", new { id = entry.UserId }) ?? $"/dashboard/profile/{entry.UserId}";
                    <tr class="leaderboard__row@(entry.IsCurrentUser ? " is-self" : string.Empty)@topClass"
                        data-user-id="@entry.UserId"
                        data-name="@entry.DisplayName"
                        data-tier="@entry.RankTitle"
                        data-rank="@entry.Position">
                        <td class="leaderboard__cell leaderboard__cell--position" data-label="@Model.RankLabel">
                            <div class="leaderboard__position">
                                <span class="leaderboard__position-index">#@entry.Position</span>
                                @if (entry.Position <= 3)
                                {
                                    <span class="leaderboard__medal" aria-hidden="true">
                                        @(entry.Position == 1 ? "🥇" : entry.Position == 2 ? "🥈" : "🥉")
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--avatar" data-label="@Model.AvatarLabel">
                            <span class="leaderboard__avatar@(hasAvatar ? " has-image" : " is-placeholder")" data-initial="@nameInitial">
                                <span class="leaderboard__avatar-clip">
                                    @if (hasAvatar)
                                    {
                                        <img src="@entry.AvatarUrl"
                                             alt="@entry.DisplayName"
                                             loading="lazy"
                                             decoding="async"
                                             width="96"
                                             height="96"
                                             onerror="var avatar=this.closest('.leaderboard__avatar'); if(avatar){avatar.classList.remove('has-image');avatar.classList.add('is-placeholder'); var fallback=avatar.querySelector('.leaderboard__avatar-fallback'); if(fallback){fallback.hidden=false;}} this.remove();" />
                                    }
                                    <span class="leaderboard__avatar-fallback" aria-hidden="true" @(hasAvatar ? "hidden" : string.Empty)>@nameInitial</span>
                                </span>
                                <span class="chat-status-dot @presenceClass" aria-hidden="true"></span>
                                <span class="sr-only">@entry.PresenceLabel</span>
                            </span>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--player" data-label="@Model.PlayerLabel">
                            <span class="leaderboard__player">
                                <a class="leaderboard__name leaderboard__name-link truncate"
                                   href="@profileUrl"
                                   title="@entry.DisplayName">
                                    @entry.DisplayName
                                </a>
                                @if (entry.IsCurrentUser)
                                {
                                    <span class="leaderboard__badge">@Model.SelfBadgeLabel</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.RankTitle))
                                {
                                    <span class="leaderboard__role">@entry.RankTitle</span>
                                }
                            </span>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--status" data-label="@Model.StatusLabel">
                            <span class="leaderboard__presence-chip">
                                <span class="chat-status-dot @presenceClass" aria-hidden="true"></span>
                                <span>@entry.PresenceLabel</span>
                            </span>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--level" data-label="@Model.LevelLabel">
                            <span class="leaderboard__level-badge">Lv. @entry.Level</span>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--xp" data-label="@Model.ExperienceLabel">
                            <div class="leaderboard__xp truncate" title="@entry.ExperiencePoints.ToString("N0", CultureInfo.CurrentCulture) XP">
                                @{
                                    var xpProgressPercent = (int)Math.Round(Math.Max(0d, Math.Min(1d, (entry.ExperiencePoints % 1000) / 1000d)) * 100);
                                }
                                <strong data-xp-progress="@xpProgressPercent%">@entry.ExperiencePoints.ToString("N0", CultureInfo.CurrentCulture) XP</strong>
                                <span class="leaderboard__xp-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@xpProgressPercent" aria-label="@($"{xpProgressPercent}% toward next level")">
                                    <span class="leaderboard__xp-meter-fill" style="width:@xpProgressPercent%;"></span>
                                </span>
                                @if (entry.ExperienceBreakdown is { Count: > 1 })
                                {
                                    var breakdownSummary = string.Join(" · ", entry.ExperienceBreakdown.Select(x => $"{x.Label}: {x.Points.ToString("N0", CultureInfo.CurrentCulture)}"));
                                    <span class="leaderboard__xp-breakdown" title="@breakdownSummary">@breakdownSummary</span>
                                }
                            </div>
                        </td>
                        <td class="leaderboard__cell leaderboard__cell--actions">
                            <button type="button"
                                    class="leaderboard__menu-btn"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    aria-label="@Model.ActionsMoreLabel"
                                    data-ranking-menu>
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false" class="leaderboard__menu-icon">
                                    <circle cx="12" cy="5" r="1.6"></circle>
                                    <circle cx="12" cy="12" r="1.6"></circle>
                                    <circle cx="12" cy="19" r="1.6"></circle>
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="leaderboard__menu" data-ranking-menu-template hidden role="menu">
        <button type="button" data-ranking-action="message" role="menuitem">@Model.ActionsMessage</button>
        <button type="button" data-ranking-action="friend" role="menuitem">@Model.ActionsAddFriend</button>
        <button type="button" data-ranking-action="invite" role="menuitem">@Model.ActionsInvite</button>
        <button type="button" data-ranking-action="profile" role="menuitem">@Model.ActionsViewProfile</button>
        <div class="leaderboard__menu-divider" role="separator" aria-hidden="true"></div>
        <button type="button" data-ranking-action="block" role="menuitem">@Model.ActionsBlock</button>
        <button type="button" data-ranking-action="report" role="menuitem">@Model.ActionsReport</button>
    </div>
    <p class="ranking-empty" data-ranking-empty hidden>@Model.EmptyLabel</p>
    <div class="sr-only" aria-live="polite" data-ranking-live></div>
</section>