@using Bgp.Web.ViewModels
@model GlobalRankingSectionViewModel
@using System.Globalization

@{
    var entries = Model.Data?.Entries ?? Array.Empty<GlobalRankingEntryViewModel>();
    var filterOptions = entries
        .Select(e => e.RankTitle)
        .Where(title => !string.IsNullOrWhiteSpace(title))
        .Distinct(StringComparer.CurrentCultureIgnoreCase)
        .OrderBy(title => title, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
}

<section id="@Model.AnchorId" class="ranking-section" data-ranking data-ranking-context="@Model.AnchorId">
    <header class="ranking-header">
        <div>
            <p class="ranking-eyebrow">@Model.Subtitle</p>
            <h2>@Model.Title</h2>
        </div>
        <div class="ranking-controls">
            <label class="ranking-control">
                <span class="sr-only">@Model.SearchPlaceholder</span>
                <input type="search"
                       placeholder="@Model.SearchPlaceholder"
                       autocomplete="off"
                       data-ranking-search />
            </label>
            <label class="ranking-control">
                <span>@Model.FilterLabel</span>
                <select data-ranking-filter>
                    <option value="">@Model.FilterAllLabel</option>
                    @foreach (var option in filterOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>
        </div>
    </header>

    <ol class="leaderboard" data-ranking-list>
        @foreach (var entry in entries)
        {
            var avatarClass = string.IsNullOrEmpty(entry.AvatarUrl)
            ? "leaderboard__avatar leaderboard__avatar--placeholder"
            : "leaderboard__avatar";

            var presenceClass = entry.PresenceStatus switch
            {
                Bgp.Domain.Enums.UserPresenceStatus.Available => "is-online",
                Bgp.Domain.Enums.UserPresenceStatus.Away => "is-away",
                Bgp.Domain.Enums.UserPresenceStatus.DoNotDisturb => "is-dnd",
                Bgp.Domain.Enums.UserPresenceStatus.Invisible => "is-invisible",
                _ => "is-offline"
            };
            var nameInitial = !string.IsNullOrWhiteSpace(entry.DisplayName)
            ? entry.DisplayName.Trim()[0]
            : '?';
            var topClass = entry.Position switch
            {
                1 => " is-top is-gold",
                2 => " is-top is-silver",
                3 => " is-top is-bronze",
                _ => string.Empty
            };
            <li class="leaderboard__row@(entry.IsCurrentUser ? " is-self" : string.Empty)@topClass"
                data-user-id="@entry.UserId"
                data-name="@entry.DisplayName"
                data-tier="@entry.RankTitle"
                data-rank="@entry.Position">
                <div class="leaderboard__position">
                    <span class="leaderboard__position-index">#@entry.Position</span>
                    @if (entry.Position <= 3)
                    {
                        <span class="leaderboard__medal" aria-hidden="true">
                            @(entry.Position == 1 ? "🥇" : entry.Position == 2 ? "🥈" : "🥉")
                        </span>
                    }
                </div>
                <div class="leaderboard__identity">
                    <div class="@avatarClass">
                        <span class="chat-status-dot @presenceClass" aria-hidden="true"></span>
                        <div class="leaderboard__avatar-clip">
                            @if (!string.IsNullOrEmpty(entry.AvatarUrl))
                            {
                                <img src="@entry.AvatarUrl" alt="@entry.DisplayName" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span aria-hidden="true">@nameInitial</span>
                            }
                        </div>
                        <span class="sr-only">@entry.PresenceLabel</span>
                    </div>
                    <div class="leaderboard__meta">
                        <div class="leaderboard__name">
                            <span>@entry.DisplayName</span>
                            @if (entry.IsCurrentUser)
                            {
                                <span class="leaderboard__badge">@Model.SelfBadgeLabel</span>
                            }
                        </div>
                        <div class="leaderboard__tags">
                            <span class="leaderboard__rank" style="--rank-accent:@entry.AccentColor;--rank-glow:@entry.AccentHighlightColor;">@entry.RankTitle</span>
                            <span class="leaderboard__level">@Model.LevelLabel: @entry.Level</span>
                        </div>
                    </div>
                </div>
                <div class="leaderboard__xp" aria-label="@Model.ExperienceLabel">
                        @if (entry.ExperienceBreakdown is { Count: > 1 })
                        {
                        <div class="leaderboard__xp-chips">
                            @foreach (var xpItem in entry.ExperienceBreakdown)
                            {
                                <span class="leaderboard__xp-chip">
                                    <span class="leaderboard__xp-chip-label">@xpItem.Label</span>
                                    <strong>@xpItem.Points.ToString("N0", CultureInfo.CurrentCulture) XP</strong>
                                </span>
                            }
                        </div>
                        }
                        else
                        {
                        <div class="leaderboard__xp-total">
                            <span>@Model.ExperienceLabel</span>
                            <strong>@entry.ExperiencePoints.ToString("N0", CultureInfo.CurrentCulture) XP</strong>
                        </div>
                    }
                </div>
                <div class="leaderboard__actions">
                    <button type="button"
                            class="leaderboard__menu-btn"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label="@Model.ActionsMoreLabel"
                            data-ranking-menu>
                        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false" class="leaderboard__menu-icon">
                            <circle cx="12" cy="5" r="1.6"></circle>
                            <circle cx="12" cy="12" r="1.6"></circle>
                            <circle cx="12" cy="19" r="1.6"></circle>
                        </svg>
                    </button>
                    <div class="leaderboard__menu" role="menu" data-ranking-menu-panel hidden>
                        <button type="button" data-ranking-action="message" role="menuitem">@Model.ActionsMessage</button>
                        <button type="button" data-ranking-action="friend" role="menuitem">@Model.ActionsAddFriend</button>
                        <button type="button" data-ranking-action="invite" role="menuitem">@Model.ActionsInvite</button>
                        <button type="button" data-ranking-action="profile" role="menuitem">@Model.ActionsViewProfile</button>
                    </div>
                </div>
            </li>
        }
    </ol>
    <p class="ranking-empty" data-ranking-empty hidden>@Model.EmptyLabel</p>
</section>