@using Microsoft.AspNetCore.Identity
@using Bgp.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Browser Games Platform";
    var ret = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="theme-dark">
    <header class="bg-gradient">
        <div class="container nav">
            <a class="brand" asp-controller="Home" asp-action="Index">BGP</a>
            <nav>
                <a asp-controller="Games" asp-action="Index">Gry</a>
                <a href="/swagger">API</a>
                <a asp-controller="Language" asp-action="Set" asp-route-culture="pl-PL" asp-route-returnUrl="@ret" title="Polski">🇵🇱</a>
                <a asp-controller="Language" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@ret" title="English">🇬🇧</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <form class="inline" asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn-link" type="submit">Wyloguj</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Zaloguj</a>
                    <a asp-controller="Account" asp-action="Register">Rejestracja</a>
                }
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <!-- Wysuwany panel czatu -->
    @await Html.PartialAsync("_ChatSidebar")

    <footer class="container footer">
        <span>© @DateTime.UtcNow.Year Browser Games Platform</span>
    </footer>

    <!-- SignalR + Chat -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.5/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
