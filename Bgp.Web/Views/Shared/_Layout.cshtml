@using Microsoft.AspNetCore.Identity
@using Bgp.Infrastructure.Identity
@using Bgp.Web.Resources;
@using Bgp.Web.Helpers
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L
@inject IOptions<BrandingOptions> BrandingOptions
@{
    Layout = null;
    var branding = BrandingOptions.Value;
    var title = ViewData["Title"]?.ToString();
    title = string.IsNullOrWhiteSpace(title) ? branding.DisplayName : $"{title} · {branding.ShortName}";
    var ret = Context.Request.Path + Context.Request.QueryString;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var theme = ViewData["Theme"]?.ToString();
    if (string.IsNullOrWhiteSpace(theme) && Context.Items.TryGetValue("PreferredTheme", out var themeItem))
    {
        theme = themeItem?.ToString();
    }

    if (string.IsNullOrWhiteSpace(theme))
    {
        Context.Request.Cookies.TryGetValue("bgp-theme", out theme);
    }
    theme = string.IsNullOrWhiteSpace(theme) ? "dark" : theme;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="application-name" content="@branding.DisplayName" />
    <meta name="apple-mobile-web-app-title" content="@branding.DisplayName" />
    <meta property="og:site_name" content="@branding.DisplayName" />
    <meta property="og:image" content="@branding.OgImagePath" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@System.Globalization.CultureInfo.CurrentUICulture.Name" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="@branding.FaviconPath" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <meta name="application-name" content="@branding.DisplayName" />
    <meta name="apple-mobile-web-app-title" content="@branding.DisplayName" />
    <meta property="og:site_name" content="@branding.DisplayName" />
    <meta property="og:image" content="@branding.OgImagePath" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@System.Globalization.CultureInfo.CurrentUICulture.Name" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="@branding.FaviconPath" type="image/svg+xml" />
    @RenderSection("Styles", required: false)
</head>
<body class="app-shell">
    @await Html.PartialAsync("_AppHeader", new Bgp.Web.ViewModels.AppHeaderViewModel
    {
        ReturnUrl = ret,
        CurrentCulture = currentCulture
        })

    <main id="main-content" class="app-main" tabindex="-1">
        @RenderBody()
    </main>

    @if (SignInManager.IsSignedIn(User))
    {
        @await Html.PartialAsync("_ChatSidebar")
    }
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="toast-stack global-toast-stack" id="globalToastStack" aria-live="polite" aria-atomic="true"></div>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app-header.js" asp-append-version="true"></script>
    <script src="~/js/game-cards.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.5/signalr.min.js" integrity="sha384-VeL4F2cuglRez2oJ6TP2PzefDs2fzGEylh4G6dkprdOCi/hTyBC0bYKT1eZqUPV3" crossorigin="anonymous"></script>
        <script src="~/js/chat.js" asp-append-version="true"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
