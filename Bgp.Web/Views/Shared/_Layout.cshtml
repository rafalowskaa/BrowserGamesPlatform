@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Browser Games Platform";
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="bg-gradient">
        <div class="container nav">
            <a class="brand" asp-controller="Home" asp-action="Index">BGP</a>
            <nav>
                <a asp-controller="Games" asp-action="Index">Gry</a>
                <a href="/swagger">API</a>
                <a href="/Identity/Account/Login">Zaloguj</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="container footer">
        <span>© @DateTime.UtcNow.Year Browser Games Platform</span>
    </footer>
</body>
</html>
