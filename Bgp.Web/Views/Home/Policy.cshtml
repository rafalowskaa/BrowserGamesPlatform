@{
    ViewData["Title"] = L["Policy_Title"].Value;
}

<section class="policy">
    <h1>@L["Policy_Title"].Value</h1>
    <p>@L["Policy_Intro"].Value</p>

    <h2>@L["Policy_Section_Data"].Value</h2>
    <ul>
        <li>@L["Policy_Point_Profile"].Value</li>
        <li>@L["Policy_Point_Content"].Value</li>
        <li>@L["Policy_Point_Security"].Value</li>
    </ul>

    <h2>@L["Policy_Section_Moderation"].Value</h2>
    <p>@L["Policy_Text_Moderation"].Value</p>

    <h2>@L["Policy_Section_Contact"].Value</h2>
    <p>@L["Policy_Text_Contact"].Value</p>
</section>