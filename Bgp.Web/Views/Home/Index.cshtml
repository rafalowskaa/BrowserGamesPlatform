@model Bgp.Web.ViewModels.HomeViewModel
@using Bgp.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = Model.IsAuthenticated ? L["Home_Title_Authenticated"].Value : L["Home_Title_Guest"].Value;
    var detailsTemplate = Url.Action("Details", "Games", new { slug = "__slug__" }) ?? "/Games/Details/__slug__";
    var loginUrl = Url.Action("Login", "Account") ?? "/Account/Login";
    var placeholderImage = Url.Content("~/img/placeholders/game-cover.svg");
}

@if (!Model.IsAuthenticated)
{
    <div class="home-guest"
         data-home-guest
         data-play-label='@L["Home_Game_Play"].Value'
         data-details-label='@L["Home_Game_Details"].Value'
         data-new-label='@L["Home_Game_New"].Value'
         data-rating-template='@L["Home_Game_Rating"].Value'
         data-placeholder='@placeholderImage'
         data-empty-label='@L["Home_Popular_Empty"].Value'
         data-login-url='@loginUrl'
         data-authenticated='false'
         data-details-url-template='@detailsTemplate'>
    <section class="home-hero" style="background-image: url('@Model.Hero.BackgroundImage');">
        <div class="home-hero__content">
            <h1>@Model.Hero.Title</h1>
            <p>@Model.Hero.Subtitle</p>
            @if (!string.IsNullOrWhiteSpace(Model.Hero.Fact))
            {
                <p class="home-hero__fact">@Model.Hero.Fact</p>
            }
            <div class="home-hero__cta">
                <a class="btn-primary" href="#featured">@L["Home_Hero_Cta_Play"].Value</a>
                @if (!Model.IsAuthenticated)
                {
                    <a class="btn-secondary" asp-controller="Account" asp-action="Register">@L["Home_Hero_Cta_Register"].Value</a>
                }
                @else
                {
                    <a class="btn-secondary" asp-controller="Games" asp-action="Index">@L["Home_Hero_Cta_Browse"].Value</a>
                }
            </div>
        </div>
        @if (Model.GameOfTheDay is not null)
        {
            <aside class="home-hero__spotlight" aria-label="@L["Home_GameOfTheDay_Label"].Value">
                <h2>@L["Home_GameOfTheDay_Label"].Value</h2>
                @await Html.PartialAsync("_GameCardGuest", Model.GameOfTheDay)
            </aside>
        }
    </section>

        
    <section id="featured" class="home-guest__section" aria-labelledby="featured-heading">
        <header class="home-guest__section-header">
            <div>
                <h2 id="featured-heading">@L["Home_Featured_Title"].Value</h2>
                <p>@L["Home_Featured_Subtitle"].Value</p>
            </div>
            <a class="section-header__link" asp-controller="Games" asp-action="Index">@L["Home_Section_ViewMore"].Value</a>
        </header>
        <div class="featured-carousel" data-featured-carousel>
            <button type="button" class="featured-carousel__control featured-carousel__control--prev" data-featured-prev aria-label="@L["Home_Featured_Prev"].Value">
                <span aria-hidden="true">«</span>
            </button>
            <div class="featured-carousel__viewport" data-featured-viewport>
                <div class="featured-carousel__track" data-featured-track>
                    @foreach (var game in Model.FeaturedGames)
                    {
                        <div class="featured-carousel__item">
                            @await Html.PartialAsync("_GameCardGuest", game)
                        </div>
                    }
                </div>
            </div>
            <button type="button" class="featured-carousel__control featured-carousel__control--next" data-featured-next aria-label="@L["Home_Featured_Next"].Value">
                <span aria-hidden="true">»</span>
            </button>
        </div>
    </section>

    <section id="popular" class="home-guest__section" aria-labelledby="popular-heading">
        <header class="home-guest__section-header">
            <div>
                <h2 id="popular-heading">@L["Home_Top_Title"].Value</h2>
                <p>@L["Home_Top_Subtitle"].Value</p>
            </div>
            <a class="section-header__link" asp-controller="Games" asp-action="Index">@L["Home_Section_ViewMore"].Value</a>
        </header>
        <div class="home-guest__tags" data-home-tags role="list">
            @if (Model.TopTags.Any())
            {
                var first = true;
                foreach (var tag in Model.TopTags)
                {
                    var isActive = first;
                    <button type="button" class="tag-chip@(isActive ? " is-active" : string.Empty)" data-home-tag data-tag="@tag.Tag" aria-pressed="@(isActive.ToString().ToLowerInvariant())">#@tag.Tag</button>
                    first = false;
                }
                }
        </div>
        <div class="home-guest__grid home-guest__grid--popular" data-home-popular role="list">
            @if (Model.TopGames.Any())
            {
                foreach (var game in Model.TopGames)
                {
                    @await Html.PartialAsync("_GameCardGuest", game)
                }
            }
            @else
            {
                <p class="home-guest__empty">@L["Home_Popular_Empty"].Value</p>
            }
        </div>
    </section>

    <section class="home-guest__section home-guest__section--why" aria-labelledby="why-heading">
        <header class="home-guest__section-header">
            <div>
                <h2 id="why-heading">@L["Home_Benefits_Title"].Value</h2>
            </div>
        </header>
        <div class="home-guest__benefits">
            <article class="benefit-card">
                <span class="benefit-card__icon" aria-hidden="true">⚡</span>
                <h3>@L["Home_Benefits_NoInstall_Title"].Value</h3>
                <p>@L["Home_Benefits_NoInstall_Description"].Value</p>
            </article>
            <article class="benefit-card">
                <span class="benefit-card__icon" aria-hidden="true">🤝</span>
                <h3>@L["Home_Benefits_Community_Title"].Value</h3>
                <p>@L["Home_Benefits_Community_Description"].Value</p>
            </article>
            <article class="benefit-card">
                <span class="benefit-card__icon" aria-hidden="true">🏆</span>
                <h3>@L["Home_Benefits_Ranks_Title"].Value</h3>
                <p>@L["Home_Benefits_Ranks_Description"].Value</p>
            </article>
        </div>
    </section>

        @if (Model.FunFacts.Any())
    {
        <section class="home-guest__section home-guest__section--facts" aria-labelledby="facts-heading">
            <header class="home-guest__section-header">
                <div>
                    <h2 id="facts-heading">@L["Home_Facts_Title"].Value</h2>
                    <p>@L["Home_Facts_Subtitle"].Value</p>
                </div>
            </header>
            <div class="home-facts" role="list">
                @foreach (var fact in Model.FunFacts)
                {
                    <article class="fact-card" role="listitem">
                        <p>@fact</p>
                    </article>
                }
            </div>
            
        </section>
    
    }


    <section class="home-guest__section home-guest__section--events" aria-labelledby="events-heading">
        <header class="home-guest__section-header">
            <div>
                <h2 id="events-heading">@L["Home_Events_Title"].Value</h2>
            </div>
           </header>
        @if (Model.WeeklyEvents.Any())
        {
            <div class="featured-carousel featured-carousel--events" data-featured-carousel>
                <button type="button" class="featured-carousel__control featured-carousel__control--prev" data-featured-prev aria-label="@L["Home_Featured_Prev"].Value">
                    <span aria-hidden="true">«</span>
                </button>
                <div class="featured-carousel__viewport" data-featured-viewport>
                    <div class="featured-carousel__track" data-featured-track>
                        @foreach (var evt in Model.WeeklyEvents)
                        {
                            <div class="featured-carousel__item">
                                <article class="event-card" role="listitem">
                                    <h3>@evt.Title</h3>
                                    <p>@string.Format(L["Home_Events_Reward"].Value, evt.Reward)</p>
                                    <time datetime="@evt.EndsAt.ToString("o")">@string.Format(L["Home_Events_End"].Value, evt.EndsAt.ToLocalTime().ToString("dd.MM HH:mm"))</time>
                                </article>
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="featured-carousel__control featured-carousel__control--next" data-featured-next aria-label="@L["Home_Featured_Next"].Value">
                    <span aria-hidden="true">»</span>
                </button>
            </div>
        
    }
            @else
        {
            <p class="home-guest__empty">@L["Home_Events_Empty"].Value</p>
        }
        @if (!Model.IsAuthenticated)
        {
            <div class="home-guest__event-cta">
                <a class="btn-outline" asp-controller="Account" asp-action="Register">@L["Home_Events_Cta"].Value</a>
            </div>
        }
    </section>
</div>
}

   else
{
        <section class="home-section home-dashboard">
            <div class="home-dashboard__welcome">
                <h2>@L["Home_Dashboard_Welcome_Title"].Value</h2>
                <p>@L["Home_Dashboard_Welcome_Description"].Value</p>
            </div>
            <div class="home-dashboard__grid">
                <div class="home-panel home-panel--spotlight">
                    <h3>@L["Home_GameOfTheDay_Label"].Value</h3>
                    <div class="card-row card-row--single">
                        @if (Model.GameOfTheDay is not null)
                        {
                            @await Html.PartialAsync("_GameCardGuest", Model.GameOfTheDay)
                        }
                    @else
                        {
                            <p class="home-panel__empty">@L["Home_Dashboard_GameOfTheDay_Empty"].Value</p>
                        }
                    </div>
                </div>
                <div class="home-panel home-panel--xp">
                    <h3>@L["Home_Dashboard_XpPanel_Title"].Value</h3>
                    <div class="xp-panel" role="status" aria-live="polite" style="--xp-accent-color:@Model.ExperiencePanel.AccentColor; --xp-glow-color:@Model.ExperiencePanel.AccentGlowColor;">
                        <div class="xp-panel__header">
                            <div>
                                <p class="xp-panel__rank">@string.Format(L["Home_Dashboard_XpPanel_Rank"].Value, Model.ExperiencePanel.RankName)</p>
                                @if (!string.IsNullOrWhiteSpace(Model.ExperiencePanel.NextRankName))
                                {
                                    <p class="xp-panel__next">@string.Format(L["Home_Dashboard_XpPanel_NextRank"].Value, Model.ExperiencePanel.NextRankName)</p>
                                }
                            </div>
                            <div class="xp-panel__totals">
                                <span>@Model.ExperiencePanel.CurrentXp XP</span>
                            </div>
                        </div>
                            <div class="xp-panel__progress" style="width:@Model.ExperiencePanel.ProgressPercent%"></div>
                        </div>
                        <p class="xp-panel__meta">@string.Format(L["Home_Dashboard_XpPanel_Meta"].Value, Model.ExperiencePanel.CurrentXp, Model.ExperiencePanel.XpToNext)</p>
                        <ul class="xp-challenges">
                            @if (Model.DailyChallenges.Any())
                            {
                                foreach (var challenge in Model.DailyChallenges)
                                {
                                    <li>
                                        <label>
                                            <input type="checkbox" disabled @(challenge.IsCompleted ? "checked" : string.Empty)/>
                                            <span>@challenge.Title</span>
                                            <span class="xp-reward">@string.Format(L["Home_Dashboard_DailyChallenges_Reward"].Value, challenge.RewardXp)</span>
                                        </label>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>@L["Home_Dashboard_DailyChallenges_Empty"].Value</li>
                            }
                        </ul>
                    <div class="xp-panel__trophy">
                            <img src="@Url.Content(Model.ExperiencePanel.TrophyImage ?? "~/img/trophies/silver.png")" alt="@string.Format(L["Home_Dashboard_XpPanel_TrophyAlt"].Value, Model.ExperiencePanel.RankName)" />
                        </div>
                    </div>
                </div>
                <div class="home-panel home-panel--events">
                    <div class="home-panel__header">
                        <div>
                            <h3>@L["Home_Dashboard_Events_Title"].Value</h3>
                            <p>@L["Home_Dashboard_Events_Subtitle"].Value</p>
                        </div>
                    </div>
                    @if (Model.WeeklyEvents.Any())
                    {
                        <div class="events-carousel" role="list">
                            @foreach (var evt in Model.WeeklyEvents)
                            {
                                <article class="event-card" role="listitem">
                                    <h4>@evt.Title</h4>
                                    <p>@string.Format(L["Home_Events_Reward"].Value, evt.Reward)</p>
                                    <time datetime="@evt.EndsAt.ToString("o")">@string.Format(L["Home_Events_End"].Value, evt.EndsAt.ToLocalTime().ToString("dd.MM HH:mm"))</time>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-panel__empty">@L["Home_Dashboard_Events_Empty"].Value</p>
                    }
                </div>
            </div>
        </section>

        <section class="home-section">
            <div class="home-section__header">
                <h2>@L["Home_ForYou_Title"].Value</h2>
                <p>@L["Home_ForYou_Subtitle"].Value</p>
            </div>
            <div class="game-grid">
                @foreach (var game in Model.ForYou)
                {
                    @await Html.PartialAsync("_GameCardGuest", game)
                }
            </div>
        </section>

        <section class="home-section">
            <div class="home-section__header">
                <h2>@L["Home_Trending_Title"].Value</h2>
                <p>@L["Home_Trending_Subtitle"].Value</p>
            </div>
            <div class="game-grid">
                @foreach (var game in Model.Trending)
                {
                    @await Html.PartialAsync("_GameCardGuest", game)
                }
            </div>
        </section>

        <section class="home-section">
            <div class="home-section__header">
                <h2>@L["Home_FriendActivity_Title"].Value</h2>
                <p>@L["Home_FriendActivity_Subtitle"].Value</p>
            </div>
            <ul class="activity-feed">
                @if (Model.FriendActivity.Any())
            {
                foreach (var entry in Model.FriendActivity)
                {
                    <li>
                        <span class="activity-feed__actor">@entry.ActorName</span>
                        <span class="activity-feed__action">@entry.Action</span>
                        <a asp-controller="Games" asp-action="Details" asp-route-slug="@entry.TargetSlug">@entry.TargetName</a>
                        <time datetime="@entry.When.ToString("o")">@entry.When.ToLocalTime().ToString("HH:mm")</time>
                    </li>
                }
            }
            else
                {
                    <li>@L["Home_FriendActivity_Empty"].Value</li>
                }
            </ul>
        </section>

        @if (Model.FunFacts.Any())
        {
            <section class="home-section home-facts-section">
                <div class="home-section__header">
                    <h2>@L["Home_Dashboard_Facts_Title"].Value</h2>
                    <p>@L["Home_Dashboard_Facts_Subtitle"].Value</p>
                </div>
                <div class="home-facts" role="list">
                    @foreach (var fact in Model.FunFacts)
                    {
                        <article class="fact-card" role="listitem">
                            <p>@fact</p>
                        </article>
                    }
                </div>
            </section>
        }


        <section class="home-section home-creators">
            @{
                var hasCreatorHighlights = (Model.CreatorHighlights?.Count ?? 0) > 0;
                var previewGame = hasCreatorHighlights ? Model.CreatorHighlights![0] : null;
                var previewCoverImage = !string.IsNullOrWhiteSpace(previewGame?.CoverImagePath)
                    ? previewGame.CoverImagePath!
                    : placeholderImage;
            }
            <div class="home-creators__header">

                <div class="home-creators__intro">
                    <h2>@L["Home_Creator_Title"].Value</h2>
                    <p>@L["Home_Creator_Subtitle"].Value</p>
                </div>
                
                <a class="btn-primary home-creators__cta" asp-controller="Games" asp-action="Create">@L["Home_Creator_Cta"].Value</a>
            </div>
            <div class="home-creators__layout">
                <div class="home-creators__column home-creators__column--list">
                    <div class="home-creators__grid" role="list">
                        @foreach (var game in Model.CreatorHighlights)
                        {
                            <div class="home-creators__grid-item" role="listitem">
                                @await Html.PartialAsync("_GameCardGuest", game)
                            </div>
                        }
                    </div>
                <div class="home-creators__copy" aria-live="polite">
                        <p class="home-creators__tagline">@L["Home_Creator_Tagline"].Value</p>
                    </div>
                </div>
                <div class="home-creators__column home-creators__column--preview">
                    <div class="home-creators__preview">
                        @if (previewGame is not null)
                        {
                            <div class="home-creators__preview-media">
                                <img src="@previewCoverImage"
                                     alt="@previewGame.Title"
                                     width="640"
                                     height="360"
                                     loading="lazy"
                                     decoding="async" />
                            </div>
                            <div class="home-creators__preview-content">
                                @if (!string.IsNullOrWhiteSpace(previewGame.HighlightTag))
                                {
                                    <span class="home-creators__preview-badge">@previewGame.HighlightTag</span>
                                }
                                <h3>@previewGame.Title</h3>
                                <p>@previewGame.Excerpt</p>
                            </div>
                        }
                        else
                        {
                            <p class="home-creators__preview-empty">@L["Home_Popular_Empty"].Value</p>
                        }
                    </div>
                </div>
            </div>
        </section>

        
    }

    <section class="home-section home-community">
        <div class="community-panel">
            <h2>@L["Home_Community_Title"].Value</h2>
            <p>@Html.Raw(string.Format(L["Home_Community_Description"].Value, Model.CommunityMetrics.PlayersCount, Model.CommunityMetrics.GamesCount))</p>
            <a class="btn-primary" asp-controller="Account" asp-action="Register">@L["Home_Community_Cta"].Value</a>
        </div>
    </section>

    @section Scripts
    {
        if (!Model.IsAuthenticated)
        {
            <script src="~/js/home-guest.js" asp-append-version="true"></script>
        }
    }
