@model Bgp.Web.ViewModels.HomeViewModel
@using Bgp.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = Model.IsAuthenticated ? L["Home_Title_Authenticated"].Value : L["Home_Title_Guest"].Value;
}
<section class="home-hero" style="background-image: url('@Model.Hero.BackgroundImage');">
    <div class="home-hero__content">
        <h1>@Model.Hero.Title</h1>
        <p>@Model.Hero.Subtitle</p>
        <div class="home-hero__cta">
            <a class="btn-primary" href="#featured">@L["Home_Hero_Cta_Play"].Value</a>
            <a class="btn-secondary" asp-controller="Account" asp-action="Register">@L["Home_Hero_Cta_Register"].Value</a>
        </div>
    </div>
    @if (Model.GameOfTheDay is not null)
    {
        <aside class="home-hero__spotlight" aria-label="@L["Home_GameOfTheDay_Label"].Value">
            <h2>@L["Home_GameOfTheDay_Label"].Value</h2>
            @await Html.PartialAsync("_GameCard", Model.GameOfTheDay)
        </aside>
    }
</section>

@if (Model.IsAuthenticated)
{
    <section class="home-section home-dashboard">
        <div class="home-dashboard__welcome">
            <h2>@L["Home_Dashboard_Welcome_Title"].Value</h2>
            <p>@L["Home_Dashboard_Welcome_Description"].Value</p>
        </div>
        <div class="home-dashboard__grid">
            <div class="home-panel">
                <h3>@L["Home_Dashboard_Continue_Playing_Title"].Value</h3>
                <div class="card-row">
                    @foreach (var game in Model.ContinuePlaying)
                    {
                        @await Html.PartialAsync("_GameCard", game)
                    }
                    @if (!Model.ContinuePlaying.Any())
                    {
                        <p>@L["Home_Dashboard_Continue_Playing_Empty"].Value</p>
                    }
                </div>
            </div>
            <div class="home-panel">
                <h3>@L["Home_Dashboard_XpPanel_Title"].Value</h3>
                <div class="xp-panel" role="status" aria-live="polite">
                    <p class="xp-panel__rank">@string.Format(L["Home_Dashboard_XpPanel_Rank"].Value, Model.ExperiencePanel.RankName)</p>
                    <div class="xp-panel__bar" aria-label="@L["Home_Dashboard_XpPanel_Progress_Aria"].Value">
                        <div class="xp-panel__progress" style="width:@Model.ExperiencePanel.ProgressPercent%"></div>
                    </div>
                    <p class="xp-panel__meta">@string.Format(L["Home_Dashboard_XpPanel_Meta"].Value, Model.ExperiencePanel.CurrentXp, Model.ExperiencePanel.XpToNext)</p>
                    <ul class="xp-challenges">
                        @foreach (var challenge in Model.DailyChallenges)
                        {
                            <li>
                                <label>
                                    <input type="checkbox" disabled @(challenge.IsCompleted ? "checked" : string.Empty) />
                                    <span>@challenge.Title</span>
                                    <span class="xp-reward">@string.Format(L["Home_Dashboard_DailyChallenges_Reward"].Value, challenge.RewardXp)</span>
                                </label>
                            </li>
                        }
                        @if (!Model.DailyChallenges.Any())
                        {
                            <li>@L["Home_Dashboard_DailyChallenges_Empty"].Value</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>
}

<section id="featured" class="home-section">
    <div class="home-section__header">
        <h2>@L["Home_Featured_Title"].Value</h2>
        <p>@L["Home_Featured_Subtitle"].Value</p>
    </div>
    <div class="game-carousel" role="list">
        @foreach (var game in Model.FeaturedGames)
        {
            <div role="listitem">
                @await Html.PartialAsync("_GameCard", game)
            </div>
        }
    </div>
</section>

<section class="home-section">
    <div class="home-section__header">
        <h2>@L["Home_Top_Title"].Value</h2>
        <p>@L["Home_Top_Subtitle"].Value</p>
    </div>
    <div class="tag-filters" role="list">
        @foreach (var tag in Model.TopTags)
        {
            <button type="button" class="tag-chip" aria-pressed="false">#@tag.Tag</button>
        }
    </div>
    <div class="game-grid">
        @foreach (var game in Model.TopGames)
        {
            @await Html.PartialAsync("_GameCard", game)
        }
    </div>
</section>

@if (Model.IsAuthenticated)
{
    <section class="home-section">
        <div class="home-section__header">
            <h2>@L["Home_ForYou_Title"].Value</h2>
            <p>@L["Home_ForYou_Subtitle"].Value</p>
        </div>
        <div class="game-grid">
            @foreach (var game in Model.ForYou)
            {
                @await Html.PartialAsync("_GameCard", game)
            }
        </div>
    </section>

    <section class="home-section">
        <div class="home-section__header">
            <h2>@L["Home_Trending_Title"].Value</h2>
            <p>@L["Home_Trending_Subtitle"].Value</p>
        </div>
        <div class="game-grid">
            @foreach (var game in Model.Trending)
            {
                @await Html.PartialAsync("_GameCard", game)
            }
        </div>
    </section>

    <section class="home-section">
        <div class="home-section__header">
            <h2>@L["Home_FriendActivity_Title"].Value</h2>
            <p>@L["Home_FriendActivity_Subtitle"].Value</p>
        </div>
        <ul class="activity-feed">
            @foreach (var entry in Model.FriendActivity)
            {
                <li>
                    <span class="activity-feed__actor">@entry.ActorName</span>
                    <span class="activity-feed__action">@entry.Action</span>
                    <a asp-controller="Games" asp-action="Details" asp-route-slug="@entry.TargetSlug">@entry.TargetName</a>
                    <time datetime="@entry.When.ToString("o")">@entry.When.ToLocalTime().ToString("HH:mm")</time>
                </li>
            }
            @if (!Model.FriendActivity.Any())
            {
                <li>@L["Home_FriendActivity_Empty"].Value</li>
            }
        </ul>
    </section>

    <section class="home-section">
        <div class="home-section__header">
            <h2>@L["Home_Creator_Title"].Value</h2>
            <p>@L["Home_Creator_Subtitle"].Value</p>
        </div>
        <div class="game-carousel" role="list">
            @foreach (var game in Model.CreatorHighlights)
            {
                <div role="listitem">
                    @await Html.PartialAsync("_GameCard", game)
                </div>
            }
        </div>
        <a class="btn-primary" asp-controller="Games" asp-action="Create">@L["Home_Creator_Cta"].Value</a>
    </section>
}

<section class="home-section home-benefits">
    <div class="home-section__header">
        <h2>@L["Home_Benefits_Title"].Value</h2>
    </div>
    <div class="benefit-grid">
        <article>
            <h3>@L["Home_Benefits_NoInstall_Title"].Value</h3>
            <p>@L["Home_Benefits_NoInstall_Description"].Value</p>
        </article>
        <article>
            <h3>@L["Home_Benefits_Community_Title"].Value</h3>
            <p>@L["Home_Benefits_Community_Description"].Value</p>
        </article>
        <article>
            <h3>@L["Home_Benefits_Ranks_Title"].Value</h3>
            <p>@L["Home_Benefits_Ranks_Description"].Value</p>
        </article>
    </div>
</section>

<section class="home-section home-events">
    <div class="home-section__header">
        <h2>@L["Home_Events_Title"].Value</h2>
    </div>
    <div class="event-grid">
        @foreach (var evt in Model.WeeklyEvents)
        {
            <article>
                <h3>@evt.Title</h3>
                <p>@string.Format(L["Home_Events_Reward"].Value, evt.Reward)</p>
                <time datetime="@evt.EndsAt.ToString("o")">@string.Format(L["Home_Events_End"].Value, evt.EndsAt.ToLocalTime().ToString("dd.MM HH:mm"))</time>
            </article>
        }
    </div>
</section>

<section class="home-section home-community">
    <div class="community-panel">
        <h2>@L["Home_Community_Title"].Value</h2>
        <p>@Html.Raw(string.Format(L["Home_Community_Description"].Value, Model.CommunityMetrics.PlayersCount, Model.CommunityMetrics.GamesCount))</p>
        <a class="btn-primary" asp-controller="Account" asp-action="Register">@L["Home_Community_Cta"].Value</a>
    </div>
</section>
